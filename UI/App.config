<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Los secretos (GeminiApiKey) viven en secrets.config, que no se versiona; plantilla en secrets.config.example. -->
    <appSettings file="secrets.config">
        <!-- Modelo de Gemini a usar; si se deja vacio, GeminiEscaneoTicketService usa un default razonable. -->
        <add key="GeminiModel" value="gemini-3.1-flash-lite" />
        <!-- Endpoint de busqueda de ubicaciones (Nominatim). Debe ser HTTPS, sin credenciales, query ni fragmento.
             Si es invalido, solo falla la busqueda por texto; la seleccion manual en el mapa sigue operativa.
             El endpoint publico admite una instancia activa del TP (ver design.md del cambio busqueda-textual-ubicacion-comercio). -->
        <add key="GeocodingSearchEndpoint" value="https://nominatim.openstreetmap.org/search" />
    </appSettings>
    <connectionStrings>
        <add 
			name="TpIDS"
			connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=TpCatedraIDS;Integrated Security=True"
            providerName="System.Data.SqlClient" 
		/>
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <runtime>
        <loadFromRemoteSources enabled="true"/>
        <!-- Krypton.Toolkit lee sus recursos con System.Resources.Extensions: sin esta redireccion la app
             no arranca (FileLoadException al crear el KryptonManager). Se declara aca y no se deja a la
             generacion automatica, que segun como se compile (Visual Studio o MSBuild) la omite. -->
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="System.Resources.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-9.0.0.10" newVersion="9.0.0.10" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>
