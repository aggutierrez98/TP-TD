<?xml version="1.0" encoding="utf-8" ?>
<!--
    Template for the local secrets file. Copy it as secrets.config (same folder) and fill in the values.
    secrets.config is ignored by git; App.config merges it through <appSettings file="secrets.config">.
    Without it the updater still starts, but every run is recorded as a failure for the missing key.
-->
<appSettings>
    <!-- Open Exchange Rates App ID (free plan): create one at https://openexchangerates.org/signup/free -->
    <add key="OpenExchangeRatesApiKey" value="" />
</appSettings>
