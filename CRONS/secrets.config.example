<?xml version="1.0" encoding="utf-8" ?>
<!--
    Template for the local secrets file. Copy it as secrets.config (same folder) and fill in the values.
    secrets.config is ignored by git; App.config merges it through <appSettings file="secrets.config">.
    Each task fails only for its own missing key:
    - "tasas" without OpenExchangeRatesApiKey: every run is recorded as a failure for the missing key.
    - "notificaciones" without GeminiApiKey: the purchase and investment recommendations are recorded as
      failures in the run log; the missing-movements reminder is still generated.
-->
<appSettings>
    <!-- Open Exchange Rates App ID (free plan): create one at https://openexchangerates.org/signup/free -->
    <add key="OpenExchangeRatesApiKey" value="" />
    <!-- Gemini API key (same one as UI/secrets.config): create one at https://aistudio.google.com/apikey -->
    <add key="GeminiApiKey" value="" />
</appSettings>
