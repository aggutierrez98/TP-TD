@startuml
title T05 - Gestion de Multiples Idiomas - Observer - Clases

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "ABSTRACCIONES" {
  interface IIdioma {
    +Id : int
    +Nombre : string
    +Default : bool
    +Traducciones : IList<ITraduccion>
    +ObtenerTraduccion(key : string) : string
    +TieneTraduccion(key : string) : bool
  }

  interface ITraduccion {
    +PalabraId : int
    +IdiomaId : int
    +Valor : string
    +Palabra : IPalabra
  }

  interface IPalabra {
    +Id : int
    +Key : string
  }

  interface IUsuarioPreferencia {
    +UsuarioId : int
    +IdiomaId : int
  }
}

package "SERVICIOS" {
  class IdiomaService <<singleton>> {
    +GetInstance() : IdiomaService
    +IdiomaActual : Idioma
    +RegistrarObservador(observador : Action<Idioma>) : void
    +DesregistrarObservador(observador : Action<Idioma>) : void
    +CambiarIdioma(idioma : Idioma) : void
  }

  class IdiomaCatalogoService {
    +NormalizarNombre(nombre : string) : string
    +ValidarNombreDuplicado(idiomas : IEnumerable<Idioma>, nombre : string, idiomaId : int?) : void
    +EstaCompleto(idioma : Idioma) : bool
    +ValidarIdiomaSeleccionable(idioma : Idioma) : void
  }

  class Idioma {
    +Id : int
    +Nombre : string
    +Default : bool
    +Traducciones : List<Traduccion>
    +ObtenerTraduccion(key : string) : string
    +TieneTraduccion(key : string) : bool
  }

  class Traduccion {
    +PalabraId : int
    +IdiomaId : int
    +Valor : string
    +Palabra : Palabra
  }

  class Palabra {
    +Id : int
    +Key : string
  }

  class UsuarioPreferencia {
    +UsuarioId : int
    +IdiomaId : int
  }

  class Sesion <<singleton>> {
    +GetInstance() : Sesion
    +GetUsuarioActualId() : int?
    +GetUsuarioActualNombre() : string
  }

  class BitacoraService <<singleton>> {
    +GetInstance() : BitacoraService
    +RegistrarOperacion(actividad : string, informacion : string, origen : string, contextoPersistencia : object = null) : void
  }
}

package "BLL" {
  class IdiomaBLL {
    +InicializarAplicacion() : void
    +ObtenerIdiomas() : List<Idioma>
    +ObtenerIdioma(idiomaId : int) : Idioma
    +ObtenerIdiomaDefault() : Idioma
    +AplicarIdiomaSesionUsuario(usuarioId : int) : void
    +GuardarPreferencia(usuarioId : int, idiomaId : int) : bool
    +CrearIdioma(nombre : string, idiomaDefault : bool) : int
    +ActualizarIdioma(idiomaId : int, nombre : string, idiomaDefault : bool) : bool
    +EliminarIdioma(idiomaId : int) : bool
    +GuardarTraduccion(idiomaId : int, key : string, valor : string) : void
    +EliminarTraduccion(idiomaId : int, palabraId : int) : bool
    +ImportarJson(idiomaId : int, rutaArchivo : string) : void
    +EstaCompleto(idiomaId : int) : bool
    +AplicarIdiomaSesion(idiomaId : int) : void
  }

  class ManejadorExcepcionesBLL {
    +ObtenerMensajeUsuarioKey(exception : Exception, actividad : string) : string
    +RegistrarExcepcionTecnica(exception : Exception, actividad : string, origen : string) : void
  }

  class UsuarioEstadoBLL {
    +GuardarVersionActual(usuarioId : int, accion : string, observaciones : string, accesoDatos : AccesoDatos = null) : int
  }
}

package "DAL" {
  class IdiomaDAL {
    +ObtenerIdiomas() : List<Idioma>
    +ObtenerPalabras() : List<Palabra>
    +ObtenerIdiomaCompleto(idiomaId : int) : Idioma
    +ObtenerIdiomaDefault() : Idioma
    +InsertarIdioma(idioma : Idioma) : int
    +ActualizarIdioma(idioma : Idioma) : bool
    +EliminarIdioma(idiomaId : int) : bool
    +ObtenerPalabraIdPorKey(key : string) : int
    +GuardarTraduccion(idiomaId : int, palabraId : int, valor : string) : bool
    +EliminarTraduccion(idiomaId : int, palabraId : int) : bool
    +EstablecerIdiomaDefault(idiomaId : int) : bool
  }

  class UsuarioPreferenciaDAL {
    +ObtenerPorUsuarioId(usuarioId : int, accesoDatos : AccesoDatos = null) : UsuarioPreferencia
    +Guardar(usuarioId : int, idiomaId : int?, accesoDatos : AccesoDatos = null) : bool
  }

  class AccesoDatos {
    +BeginTransactionScope() : void
    +CommitTransactionScope() : void
    +RollbackTransactionScope() : void
  }
}

package "UI" {
  class FormTraducibleBase {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }

  class FormLogin
  class FormRegistro

  class FormGestionUsuarios {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }

  class FormGestionIdiomas

  class FormConfiguracionUsuario {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }

  class FormBitacora {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }

  class FormHistorialUsuario {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }

  class UiDialogHelper {
    +MostrarInfo(messageKey : string, args : object[]) : void
    +MostrarWarning(messageKey : string, args : object[]) : void
    +MostrarError(messageKey : string, args : object[]) : void
    +Confirmar(messageKey : string, titleKey : string, icon : MessageBoxIcon, args : object[]) : DialogResult
    +Traducir(key : string, args : object[]) : string
  }

  class UiExceptionHandler {
    +Mostrar(exception : Exception, actividad : string) : void
  }
}

IIdioma <|.. Idioma
ITraduccion <|.. Traduccion
IPalabra <|.. Palabra
IUsuarioPreferencia <|.. UsuarioPreferencia

FormTraducibleBase <|-- FormLogin
FormTraducibleBase <|-- FormRegistro
FormTraducibleBase <|-- FormGestionUsuarios
FormTraducibleBase <|-- FormGestionIdiomas
FormTraducibleBase <|-- FormConfiguracionUsuario
FormTraducibleBase <|-- FormBitacora
FormTraducibleBase <|-- FormHistorialUsuario

Idioma --> Traduccion
Traduccion --> Palabra

IdiomaBLL --> IdiomaDAL
IdiomaBLL --> UsuarioPreferenciaDAL
IdiomaBLL --> IdiomaCatalogoService
IdiomaBLL --> UsuarioEstadoBLL
IdiomaBLL --> IdiomaService
IdiomaBLL --> BitacoraService
FormConfiguracionUsuario --> Sesion
FormTraducibleBase --> IdiomaService

FormGestionIdiomas --> IdiomaService
UiDialogHelper --> IdiomaService
UiExceptionHandler --> UiDialogHelper
UiExceptionHandler --> ManejadorExcepcionesBLL

@enduml
