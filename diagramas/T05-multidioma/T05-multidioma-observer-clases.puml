@startuml
title T05 - Gestion de Multiples Idiomas - Observer - Clases

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "ABSTRACCIONES" {
  interface IObservado {
    +IdiomaActual : IIdioma
    +RegistrarObservador(observador : IObservador) : void
    +DesregistrarObservador(observador : IObservador) : void
    +Notificar() : void
    +CambiarIdioma(idioma : IIdioma) : void
  }
  interface IObservador {
    +Actualizar(observado : IObservado) : void
  }
  interface IIdioma {
    +Id : int
    +Nombre : string
    +Default : bool
    +Traducciones : IList<ITraduccion>
    +ObtenerTraduccion(key : string) : string
    +TieneTraduccion(key : string) : bool
  }
  interface ITraduccion
}

package "SERVICIOS" {
  class IdiomaService <<singleton>> {
    +GetInstance() : IdiomaService
    +IdiomaActual : IIdioma
    +RegistrarObservador(observador : IObservador) : void
    +DesregistrarObservador(observador : IObservador) : void
    +Notificar() : void
    +CambiarIdioma(idioma : IIdioma) : void
  }
  class Idioma {
    +ObtenerTraduccion(key : string) : string
    +TieneTraduccion(key : string) : bool
  }
  class Traduccion
  class Palabra
  class IdiomaCatalogoService {
    +NormalizarNombre(nombre : string) : string
    +ValidarNombreDuplicado(idiomas : IEnumerable<Idioma>, nombre : string, idiomaId : int?) : void
    +EstaCompleto(idioma : Idioma) : bool
    +ValidarIdiomaSeleccionable(idioma : Idioma) : void
  }
}

package "BLL" {
  class IdiomaBLL {
    +InicializarAplicacion() : void
    +ObtenerIdiomas() : List<Idioma>
    +CrearIdioma(nombre : string) : int
    +ActualizarIdioma(idiomaId : int, nombre : string, idiomaDefault : bool) : bool
    +EliminarIdioma(idiomaId : int) : bool
    +GuardarTraduccion(idiomaId : int, key : string, valor : string) : void
    +ImportarJson(idiomaId : int, rutaArchivo : string) : void
    +ExportarJson(idiomaId : int, rutaArchivo : string) : void
    +GuardarPreferencia(usuarioId : int, idiomaId : int) : bool
    +AplicarIdiomaSesionUsuario(usuarioId : int) : void
  }
  class CompositionRoot <<static>> {
    +ServicioIdioma : IObservado
    +Idioma : IdiomaBLL
  }
}

package "REPOSITORIO" {
  interface IUnidadDeTrabajo {
    +Idiomas : IIdiomaRepositorio
    +Traducciones : ITraduccionRepositorio
    +UsuarioPreferencias : IUsuarioPreferenciaRepositorio
    +Save() : void
  }
  interface IIdiomaRepositorio {
    +ObtenerIdiomas() : List<Idioma>
    +ObtenerIdiomaCompleto(idiomaId : int) : Idioma
    +ObtenerIdiomaDefault() : Idioma
    +InsertarIdioma(idioma : Idioma) : int
    +ActualizarIdioma(idioma : Idioma) : bool
    +EliminarIdioma(idiomaId : int) : bool
    +SwitchearIdiomaDefault(idiomaId : int) : bool
  }
  interface ITraduccionRepositorio {
    +ObtenerPalabraIdPorKey(key : string) : int
    +GuardarTraduccion(idiomaId : int, palabraId : int, valor : string) : bool
    +EliminarTraduccion(idiomaId : int, palabraId : int) : bool
  }
  interface IUsuarioPreferenciaRepositorio {
    +ObtenerPorUsuarioId(usuarioId : int) : UsuarioPreferencia
    +Guardar(usuarioId : int, idiomaId : int?) : bool
  }
  class IdiomaRepositorio
  class TraduccionRepositorio
  class UsuarioPreferenciaRepositorio
}

package "DAL" {
  class IdiomaDAL
  class UsuarioPreferenciaDAL
  class AccesoDatosSqlServer
}

package "UI" {
  class FormTraducibleBase {
    +Actualizar(observado : IObservado) : void
  }
  class FormGestionIdiomas
  class FormConfiguracionUsuario
  class IdiomaFormHelper <<static>> {
    +Aplicar(form : Form, idioma : IIdioma) : void
  }
}

' ---- Observer ----
IObservado <|.. IdiomaService
IObservador <|.. FormTraducibleBase
IdiomaService o--> "*" IObservador : _observadores
IdiomaService --> IIdioma : _idiomaActual
FormTraducibleBase ..> IdiomaFormHelper : Aplicar(this, idiomaActual)

' ---- Modelo de idioma ----
Idioma ..|> IIdioma
Traduccion ..|> ITraduccion
Idioma --> "*" Traduccion
Traduccion --> Palabra

' ---- BLL orquesta ----
FormGestionIdiomas --|> FormTraducibleBase
FormConfiguracionUsuario --|> FormTraducibleBase
FormGestionIdiomas --> IdiomaBLL
FormConfiguracionUsuario --> IdiomaBLL
IdiomaBLL --> IObservado : _servicioIdioma
IdiomaBLL --> IIdiomaRepositorio
IdiomaBLL --> ITraduccionRepositorio
IdiomaBLL --> IUsuarioPreferenciaRepositorio
IdiomaBLL --> IdiomaCatalogoService
IdiomaBLL ..> IUnidadDeTrabajo
CompositionRoot ..> IdiomaService : GetInstance()
CompositionRoot ..> IdiomaBLL : <<creates>>

' ---- REPOSITORIO -> DAL ----
IUnidadDeTrabajo --> IIdiomaRepositorio : Idiomas
IUnidadDeTrabajo --> ITraduccionRepositorio : Traducciones
IUnidadDeTrabajo --> IUsuarioPreferenciaRepositorio : UsuarioPreferencias
IdiomaRepositorio ..|> IIdiomaRepositorio
TraduccionRepositorio ..|> ITraduccionRepositorio
UsuarioPreferenciaRepositorio ..|> IUsuarioPreferenciaRepositorio
IdiomaRepositorio --> IdiomaDAL
TraduccionRepositorio --> IdiomaRepositorio : delega (mismo IdiomaDAL)
UsuarioPreferenciaRepositorio --> UsuarioPreferenciaDAL
IdiomaDAL --> AccesoDatosSqlServer
UsuarioPreferenciaDAL --> AccesoDatosSqlServer

note bottom of IdiomaService
  CambiarIdioma(idioma) fija _idiomaActual y llama Notificar(),
  que recorre _observadores y ejecuta Actualizar(this) en cada
  Form abierto (re-traduce la UI en caliente).
end note

@enduml
