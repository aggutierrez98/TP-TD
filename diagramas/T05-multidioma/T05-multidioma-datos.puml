@startuml
title T05 - Gestion de Multiples Idiomas - DER

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false

entity "Idioma" as Idioma {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Nombre : varchar(100) <<UQ (UQ_Idioma_Nombre), NOT NULL>>
  Default : bit <<NOT NULL>>
}

entity "Palabra" as Palabra {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Key : varchar(150) <<UQ (UQ_Palabra_Key), NOT NULL>>
}

entity "Traduccion" as Traduccion {
  *PalabraId : int <<PK, FK -> Palabra.Id, NOT NULL>>
  *IdiomaId : int <<PK, FK -> Idioma.Id, NOT NULL>>
  --
  Valor : varchar(300) <<NOT NULL>>
}

entity "UsuarioPreferencias" as Pref {
  *UsuarioId : int <<PK, FK -> Usuarios.Id, NOT NULL>>
  --
  IdiomaId : int <<FK -> Idioma.Id, NOT NULL>>
}

entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY, NOT NULL>>
}

Palabra ||--o{ Traduccion
Idioma  ||--o{ Traduccion
Idioma  ||--o{ Pref
Usuarios ||--|| Pref

note bottom of Traduccion
  PK compuesta (PalabraId, IdiomaId): una traduccion
  por palabra/idioma. Valor es el texto localizado.
end note

@enduml
