@startuml
title T06 - Gestion de Bitacora y Control de Cambios - DER

hide methods
hide stereotypes
skinparam classAttributeIconSize 0

entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Username : varchar(50) <<UQ, NOT NULL>>
  PasswordHash : varchar(max) <<NOT NULL>>
  Activo : bit <<NOT NULL, DEFAULT 1>>
  DVH : varchar(100) <<NULL>>
}

entity "Bitacora" as Bitacora {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  FechaHora : datetime <<NOT NULL>>
  UsuarioId : int <<FK, NULL>>
  UsernameSnapshot : varchar(50) <<NULL>>
  Actividad : varchar(100) <<NOT NULL>>
  Informacion : varchar(500) <<NULL>>
  Nivel : varchar(20) <<NOT NULL>>
  Origen : varchar(100) <<NOT NULL>>
  EsTecnica : bit <<NOT NULL, DEFAULT 0>>
}

entity "UsuarioPreferencias" as UsuarioPreferencias {
  *UsuarioId : int <<PK, FK, NOT NULL>>
  --
  IdiomaId : int <<FK, NOT NULL>>
}

entity "UsuarioPermiso" as UsuarioPermiso {
  *UsuarioId : int <<PK, FK, NOT NULL>>
  *PermisoId : int <<PK, FK, NOT NULL>>
}

entity "UsuarioHistorial" as UsuarioHistorial {
  *HistorialId : int <<PK, IDENTITY, NOT NULL>>
  --
  UsuarioId : int <<FK, NOT NULL>>
  FechaHora : datetime <<NOT NULL>>
  ActorUsuarioId : int <<FK, NULL>>
  ActorUsernameSnapshot : varchar(50) <<NULL>>
  Accion : varchar(100) <<NOT NULL>>
  Observaciones : varchar(500) <<NULL>>
  Username : varchar(50) <<NOT NULL>>
  PasswordHash : varchar(max) <<NOT NULL>>
  Activo : bit <<NOT NULL>>
  IdiomaId : int <<NULL>>
}

entity "UsuarioHistorialPermiso" as UsuarioHistorialPermiso {
  *HistorialId : int <<PK, FK, NOT NULL>>
  *PermisoId : int <<PK, NOT NULL>>
}

Usuarios ||--o{ Bitacora : FK_Bitacora_Usuario
Usuarios ||--o{ UsuarioHistorial : FK_UsuarioHistorial_Usuario
Usuarios ||--o{ UsuarioHistorial : FK_UsuarioHistorial_ActorUsuario
UsuarioHistorial ||--o{ UsuarioHistorialPermiso : FK_UsuarioHistorialPermiso_Historial
Usuarios ||--o| UsuarioPreferencias : FK_UsuarioPreferencias_Usuario
Usuarios ||--o{ UsuarioPermiso : FK_UsuarioPermiso_Usuario

note bottom of Bitacora
  Indices: IX_Bitacora_FechaHora (FechaHora DESC),
  IX_Bitacora_UsuarioId_Actividad (UsuarioId, Actividad).
  UsuarioId/UsernameSnapshot admiten NULL para eventos
  sin sesion (p. ej. login fallido).
end note

note right of UsuarioHistorialPermiso
  PK compuesta (HistorialId, PermisoId) y FK solo hacia UsuarioHistorial.
  PermisoId no tiene FK declarada en la DDL de esta tabla.
end note

note bottom of UsuarioPreferencias
  UsuarioPreferencias.IdiomaId referencia dbo.Idioma (modulo T05) y
  UsuarioPermiso.PermisoId referencia dbo.Permiso (modulo T04);
  esas tablas quedan fuera del alcance de este DER.
end note

@enduml
