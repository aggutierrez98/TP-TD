' BLL/SesionUsuarioExtensiones.cs:12 SesionUsuarioExtensiones.ObtenerUsuarioActual
' DAL/MovimientoDAL.cs:284 MovimientoDAL.ObtenerResumen
' DAL/MovimientoDAL.cs:60 MovimientoDAL.ObtenerPorUsuario
' REPOSITORIO/ICategoriaRepositorio.cs:10 ICategoriaRepositorio.ObtenerVisiblesParaUsuario
' REPOSITORIO/IMovimientoRepositorio.cs:13 IMovimientoRepositorio.ObtenerPorUsuario
' REPOSITORIO/IMovimientoRepositorio.cs:23 IMovimientoRepositorio.ObtenerResumen
' REPOSITORIO/MovimientoRepositorio.cs:33 MovimientoRepositorio.ObtenerPorUsuario
' REPOSITORIO/MovimientoRepositorio.cs:60 MovimientoRepositorio.ObtenerResumen
' UI/FormBalanceGeneral.cs:117 FormBalanceGeneral.ActualizarResumen
@enduml
