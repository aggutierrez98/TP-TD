@startuml
' Fuente: diagramas/NEG17-dashboard-balance/NEG17-dashboard-balance-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN72 Consultar dashboard de analíticas — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormDashboardAnaliticas {
    -CargarDashboard(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class DashboardBLL {
    +ObtenerOCrearDashboardActual(): Dashboard
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
  class MovimientoBLL {
    +ObtenerTotalesPorCategoria(tipo: TipoMovimiento, desde: DateTime, hasta: DateTime):\nList<TotalPorCategoria>
    +ObtenerGastoPorComercio(desde: DateTime, hasta: DateTime, cantidad: int):\nGastoPorComercio
    +ObtenerGastoAcumuladoMensual(hoy: DateTime): GastoAcumuladoMensual
    +ObtenerTotalesPorMes(desde: DateTime, hasta: DateTime): List<TotalPorMes>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
DashboardBLL -[hidden]right-> SesionUsuarioExtensiones
DashboardBLL -[hidden]down-> IBitacoraBLL
IBitacoraBLL -[hidden]right-> MovimientoBLL
package "REPOSITORIO" as L_REPOSITORIO {
  interface IDashboardRepositorio {
    +ObtenerPorUsuario(usuario: Usuario): Dashboard
    +InsertarYObtenerId(dashboard: Dashboard): int
  }
  class DashboardRepositorio {
    +ObtenerPorUsuario(usuario: Usuario): Dashboard
    +InsertarYObtenerId(dashboard: Dashboard): int
  }
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
  class "MovimientoRepositorio" as IMovimientoRepositorio <<IMovimientoRepositorio>> {
    +ObtenerTotalesPorCategoria(usuario: Usuario, tipo: TipoMovimiento, desde: DateTime,\nhasta: DateTime): List<TotalPorCategoria>
    +ObtenerTotalesPorComercio(usuario: Usuario, tipo: TipoMovimiento, desde: DateTime,\nhasta: DateTime): List<TotalPorComercio>
    +ObtenerTotalesPorDia(usuario: Usuario, tipo: TipoMovimiento, desde: DateTime, hasta:\nDateTime): List<TotalPorDia>
    +ObtenerTotalesPorMes(usuario: Usuario, desde: DateTime, hasta: DateTime):\nList<TotalPorMes>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IDashboardRepositorio -[hidden]right-> DashboardRepositorio
IDashboardRepositorio -[hidden]down-> IUnidadDeTrabajoFactory
IUnidadDeTrabajoFactory -[hidden]right-> IUnidadDeTrabajo
IUnidadDeTrabajoFactory -[hidden]down-> IMovimientoRepositorio
package "DAL" as L_DAL {
  class DashboardDAL {
    +ObtenerPorUsuario(usuario: Usuario, accesoDatos: AccesoDatosSqlServer): Dashboard
    +InsertarYObtenerId(dashboard: Dashboard, accesoDatos: AccesoDatosSqlServer): int
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Dashboard {
    +Id: int
    +Usuario: Usuario
    +Tarjetas: List<TarjetaDashboard>
  }
  class TarjetaDashboard {
    +Id: int
    +Dashboard: Dashboard
    +Tipo: TipoTarjetaDashboard
    +Orden: int
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
Dashboard -[hidden]right-> TarjetaDashboard
Dashboard -[hidden]down-> Usuario
DashboardBLL ..> IBitacoraBLL : usa
DashboardBLL ..> IDashboardRepositorio : usa
DashboardBLL ..> IUnidadDeTrabajo : usa
DashboardBLL ..> IUnidadDeTrabajoFactory : usa
DashboardBLL ..> SesionUsuarioExtensiones : usa
DashboardRepositorio ..|> IDashboardRepositorio
FormDashboardAnaliticas ..> DashboardBLL : usa
FormDashboardAnaliticas ..> MovimientoBLL : usa
DashboardRepositorio ..> DashboardDAL : usa
MovimientoBLL ..> IMovimientoRepositorio : usa
MovimientoBLL ..> SesionUsuarioExtensiones : usa
L_DAL -[hidden]down-> L_BE
DashboardBLL ..> Dashboard : datos
Dashboard --> Usuario : Usuario
Dashboard --> "*" TarjetaDashboard : Tarjetas
TarjetaDashboard --> Dashboard : Dashboard
