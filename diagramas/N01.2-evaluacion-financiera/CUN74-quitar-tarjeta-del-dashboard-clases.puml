@startuml
' Fuente: diagramas/NEG17-dashboard-balance/NEG17-dashboard-balance-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN74 Quitar tarjeta del dashboard — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormDashboardAnaliticas {
    -QuitarTarjeta(tarjeta: TarjetaDashboard): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class DashboardBLL {
    +QuitarTarjeta(tarjeta: TarjetaDashboard): bool
    +ObtenerOCrearDashboardActual(): Dashboard
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
DashboardBLL -[hidden]right-> SesionUsuarioExtensiones
DashboardBLL -[hidden]down-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface ITarjetaDashboardRepositorio {
    +ObtenerPorId(id: int): TarjetaDashboard
    +Eliminar(tarjeta: TarjetaDashboard): bool
  }
  class TarjetaDashboardRepositorio {
    +ObtenerPorId(id: int): TarjetaDashboard
    +Eliminar(tarjeta: TarjetaDashboard): bool
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
  class "DashboardRepositorio" as IDashboardRepositorio <<IDashboardRepositorio>> {
    +ObtenerPorUsuario(usuario: Usuario): Dashboard
    +InsertarYObtenerId(dashboard: Dashboard): int
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> ITarjetaDashboardRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> TarjetaDashboardRepositorio
TarjetaDashboardRepositorio -[hidden]right-> IUnidadDeTrabajo
TarjetaDashboardRepositorio -[hidden]down-> IDashboardRepositorio
package "DAL" as L_DAL {
  class TarjetaDashboardDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): TarjetaDashboard
    +Eliminar(tarjeta: TarjetaDashboard, accesoDatos: AccesoDatosSqlServer): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Dashboard {
    +Id: int
    +Usuario: Usuario
    +Tarjetas: List<TarjetaDashboard>
  }
  class TarjetaDashboard {
    +Id: int
    +Dashboard: Dashboard
    +Tipo: TipoTarjetaDashboard
    +Orden: int
  }
  enum TipoTarjetaDashboard {
    GastosPorCategoria
    IngresosPorCategoria
    ComparativoMensual
    EvolucionBalance
    GastosPorComercio
    GastoAcumuladoMensual
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
Dashboard -[hidden]right-> TarjetaDashboard
Dashboard -[hidden]down-> TipoTarjetaDashboard
TipoTarjetaDashboard -[hidden]right-> Usuario
DashboardBLL ..> IBitacoraBLL : usa
DashboardBLL ..> IDashboardRepositorio : usa
DashboardBLL ..> ITarjetaDashboardRepositorio : usa
DashboardBLL ..> IUnidadDeTrabajo : usa
DashboardBLL ..> IUnidadDeTrabajoFactory : usa
DashboardBLL ..> SesionUsuarioExtensiones : usa
FormDashboardAnaliticas ..> DashboardBLL : usa
TarjetaDashboardRepositorio ..> TarjetaDashboardDAL : usa
TarjetaDashboardRepositorio ..|> ITarjetaDashboardRepositorio
DashboardBLL ..> TarjetaDashboard : datos
Dashboard --> Usuario : Usuario
Dashboard --> "*" TarjetaDashboard : Tarjetas
TarjetaDashboard --> Dashboard : Dashboard
TarjetaDashboard --> TipoTarjetaDashboard : Tipo
