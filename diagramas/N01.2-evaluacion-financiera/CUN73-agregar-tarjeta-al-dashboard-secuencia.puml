' BLL/DashboardBLL.cs:166 DashboardBLL.ObtenerTiposDisponibles
' BLL/DashboardBLL.cs:35 DashboardBLL.ObtenerOCrearDashboardActual
' BLL/DashboardBLL.cs:78 DashboardBLL.AgregarTarjeta
' BLL/SesionUsuarioExtensiones.cs:12 SesionUsuarioExtensiones.ObtenerUsuarioActual
' DAL/TarjetaDashboardDAL.cs:87 TarjetaDashboardDAL.InsertarYObtenerId
' REPOSITORIO/IDashboardRepositorio.cs:11 IDashboardRepositorio.InsertarYObtenerId
' REPOSITORIO/IDashboardRepositorio.cs:9 IDashboardRepositorio.ObtenerPorUsuario
' REPOSITORIO/ITarjetaDashboardRepositorio.cs:12 ITarjetaDashboardRepositorio.InsertarYObtenerId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/TarjetaDashboardRepositorio.cs:47 TarjetaDashboardRepositorio.InsertarYObtenerId
' UI/FormDashboardAnaliticas.cs:241 FormDashboardAnaliticas.btnAgregarTarjeta_Click
@enduml
