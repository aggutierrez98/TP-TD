@startuml
title G07 - Modelo de datos integrado (DER de todos los modulos)

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

' ===================== T02 / T03 - Usuarios =====================
entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY>>
  --
  Username : varchar(50) <<UQ>>
  PasswordHash : varchar(max)
  Activo : bit
  DVH : varchar(100) <<NULL>>
}

' ===================== T04 - Perfiles / permisos =====================
entity "Permiso" as Permiso {
  *Id : int <<PK, IDENTITY>>
  --
  Nombre : varchar(100) <<UQ>>
  EsGrupo : bit
}

entity "PermisoCompuesto" as PermisoCompuesto {
  *PermisoPadreId : int <<PK, FK>>
  *PermisoHijoId : int <<PK, FK>>
}

entity "UsuarioPermiso" as UsuarioPermiso {
  *UsuarioId : int <<PK, FK>>
  *PermisoId : int <<PK, FK>>
}

' ===================== T05 - Multidioma =====================
entity "Idioma" as Idioma {
  *Id : int <<PK, IDENTITY>>
  --
  Nombre : varchar(100) <<UQ>>
  Default : bit
}

entity "Palabra" as Palabra {
  *Id : int <<PK, IDENTITY>>
  --
  Key : varchar(150) <<UQ>>
}

entity "Traduccion" as Traduccion {
  *PalabraId : int <<PK, FK>>
  *IdiomaId : int <<PK, FK>>
  --
  Valor : varchar(300)
}

entity "UsuarioPreferencias" as Pref {
  *UsuarioId : int <<PK, FK>>
  --
  IdiomaId : int <<FK>>
}

' ===================== T06a - Bitacora =====================
entity "Bitacora" as Bitacora {
  *Id : int <<PK, IDENTITY>>
  --
  FechaHora : datetime
  UsuarioId : int <<FK, NULL>>
  UsernameSnapshot : varchar(50) <<NULL>>
  Actividad : varchar(100)
  Informacion : varchar(500) <<NULL>>
  Nivel : varchar(20)
  Origen : varchar(100)
  EsTecnica : bit
}

' ===================== T06b - Control de cambios =====================
entity "UsuarioHistorial" as Hist {
  *HistorialId : int <<PK, IDENTITY>>
  --
  UsuarioId : int <<FK>>
  FechaHora : datetime
  ActorUsuarioId : int <<FK, NULL>>
  ActorUsernameSnapshot : varchar(50) <<NULL>>
  Accion : varchar(100)
  Observaciones : varchar(500) <<NULL>>
  Username : varchar(50)
  PasswordHash : varchar(max)
  Activo : bit
  IdiomaId : int <<NULL>>
}

entity "UsuarioHistorialPermiso" as HistPerm {
  *HistorialId : int <<PK, FK>>
  *PermisoId : int <<PK>>
}

' ===================== T07 - Digitos verificadores =====================
entity "DigitoVerificadorVertical" as DVV {
  *NombreTabla : varchar(100) <<PK>>
  --
  Valor : varchar(100)
  FechaActualizacion : datetime
}

' ===================== Relaciones (FK reales) =====================
' Perfiles
Permiso ||--o{ PermisoCompuesto : padre
Permiso ||--o{ PermisoCompuesto : hijo
Usuarios ||--o{ UsuarioPermiso
Permiso  ||--o{ UsuarioPermiso

' Multidioma
Palabra ||--o{ Traduccion
Idioma  ||--o{ Traduccion
Usuarios ||--|| Pref
Idioma   ||--o{ Pref

' Bitacora
Usuarios ||--o{ Bitacora : UsuarioId (NULL)

' Control de cambios
Usuarios ||--o{ Hist : UsuarioId
Usuarios ||--o{ Hist : ActorUsuarioId (NULL)
Hist ||--o{ HistPerm

' Integridad (relacion logica por nombre de tabla, sin FK)
DVV ..> Usuarios : NombreTabla = "Usuarios"

note bottom of DVV
  DER unificado extraido de la base real TpCatedraIDS.
  Notas: IdiomaId (UsuarioHistorial), PermisoId (UsuarioHistorialPermiso)
  y la relacion DVV->Usuarios no tienen FK declarada en la base.
end note

@enduml
