INotificacionRepositorio -[hidden]right-> NotificacionRepositorio
INotificacionRepositorio -[hidden]down-> IUnidadDeTrabajoFactory
IUnidadDeTrabajoFactory -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class NotificacionDAL {
    +ObtenerPaginaPersonal(usuario: Usuario, filtro: FiltroNotificacion, pagina: int,\naccesoDatos: AccesoDatosSqlServer): PaginaNotificaciones
    +ObtenerPersonal(notificacion: Notificacion, usuario: Usuario, accesoDatos:\nAccesoDatosSqlServer): Notificacion
    +MarcarPersonalLeida(notificacion: Notificacion, usuario: Usuario, accesoDatos:\nAccesoDatosSqlServer): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "SERVICIOS" as L_SERVICIOS {
  class "Sesion" as ISesion <<ISesion>> {
    +HaySesionActiva(): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class FiltroNotificacion {
    +FechaDesde: DateTime?
    +FechaHasta: DateTime?
  }
  class Notificacion {
    +Id: int
    +Usuario: Usuario
    +Mensaje: string
    +Fecha: DateTime
    +Leida: bool
    +TipoAutomatico: TipoNotificacionAutomatica?
    +FechaJornada: DateTime?
    +ClaveEjemplo: string
  }
  class PaginaNotificaciones {
    +Elementos: List<Notificacion>
    +Total: int
    +Pagina: int
    +TotalPaginas: int
  }
  enum TipoNotificacionAutomatica {
    Compras
    Inversiones
    Movimientos
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
