NotificacionBLL -[hidden]right-> SesionUsuarioExtensiones
NotificacionBLL -[hidden]down-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  interface INotificacionRepositorio {
    +ObtenerPaginaPersonal(usuario: Usuario, filtro: FiltroNotificacion, pagina: int):\nPaginaNotificaciones
    +ObtenerPersonal(notificacion: Notificacion, usuario: Usuario): Notificacion
    +MarcarPersonalLeida(notificacion: Notificacion, usuario: Usuario): bool
  }
