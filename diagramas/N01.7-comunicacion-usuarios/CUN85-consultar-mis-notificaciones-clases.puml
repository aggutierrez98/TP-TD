    +ObtenerPaginaPersonal(usuario: Usuario, filtro: FiltroNotificacion, pagina: int):\nPaginaNotificaciones
    +ObtenerPersonal(recibida: Notificacion, usuario: Usuario): Notificacion
    +MarcarPersonalLeida(notificacion: Notificacion, usuario: Usuario): bool
  }
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
