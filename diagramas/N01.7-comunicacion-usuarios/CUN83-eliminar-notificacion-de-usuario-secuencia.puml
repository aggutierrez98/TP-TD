skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide footbox
autonumber
skinparam maxMessageSize 560
actor "Operador o Administrador" as Actor
boundary "FormGestionNotificaciones" as FormGestionNotificaciones
control "NotificacionBLL" as NotificacionBLL
participant "UnidadDeTrabajoFactory\n:IUnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory
participant "NotificacionRepositorio\n:INotificacionRepositorio" as INotificacionRepositorio
participant "NotificacionDAL" as NotificacionDAL
participant "RecordatorioCompraRepositorio\n:IRecordatorioCompraRepositorio" as IRecordatorioCompraRepositorio
participant "RecordatorioInversionRepositorio\n:IRecordatorioInversionRepositorio" as IRecordatorioInversionRepositorio
control "BitacoraBLL\n:IBitacoraBLL" as IBitacoraBLL
participant "UnidadDeTrabajoSqlServer\n:IUnidadDeTrabajo" as IUnidadDeTrabajo
note over FormGestionNotificaciones : El actor desea retirar una notificación del sistema.
Actor -> FormGestionNotificaciones : selecciona una notificación del listado.
Actor -> FormGestionNotificaciones : selecciona el botón «Eliminar seleccionada».
FormGestionNotificaciones --> Actor : solicita confirmación con el diálogo «Confirmar eliminación» y el mensaje «Se eliminará la\nnotificación seleccionada. ¿Desea continuar?».
alt El actor confirma la operacion
Actor -> FormGestionNotificaciones : confirma la eliminación.
FormGestionNotificaciones -> NotificacionBLL ++ : Eliminar(recibida: Notificacion)
NotificacionBLL -> IUnidadDeTrabajoFactory ++ : Crear()
IUnidadDeTrabajoFactory --> NotificacionBLL -- : IUnidadDeTrabajo
NotificacionBLL -> INotificacionRepositorio ++ : ObtenerPorId(id: int)
INotificacionRepositorio -> NotificacionDAL ++ : ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : Notificacion
INotificacionRepositorio --> NotificacionBLL -- : Notificacion
alt notificacion != null
NotificacionBLL -> INotificacionRepositorio ++ : Eliminar(notificacion: Notificacion)
INotificacionRepositorio -> NotificacionDAL ++ : Eliminar(notificacion: Notificacion, accesoDatos:\nAccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : bool
INotificacionRepositorio --> NotificacionBLL -- : bool
else caso contrario
NotificacionBLL -> IRecordatorioCompraRepositorio ++ : ObtenerPorId(id: int)
IRecordatorioCompraRepositorio --> NotificacionBLL -- : RecordatorioCompra
alt (compra = unidad.RecordatoriosCompra.ObtenerPorId(recibida.Id)) != null
NotificacionBLL -> IRecordatorioCompraRepositorio ++ : Eliminar(recordatorio: RecordatorioCompra)
IRecordatorioCompraRepositorio --> NotificacionBLL -- : bool
else caso contrario
NotificacionBLL -> IRecordatorioInversionRepositorio ++ : ObtenerPorId(id: int)
IRecordatorioInversionRepositorio --> NotificacionBLL -- : RecordatorioInversion
opt (inversion = unidad.RecordatoriosInversion.ObtenerPorId(recibida.Id)) !=\nnull
NotificacionBLL -> IRecordatorioInversionRepositorio ++ : Eliminar(recordatorio: RecordatorioInversion)
IRecordatorioInversionRepositorio --> NotificacionBLL -- : bool
end
end
end
NotificacionBLL -> IBitacoraBLL ++ : RegistrarOperacionInterno(actividad: string, informacion:\nstring, origen: string, unidad: IUnidadDeTrabajo)
IBitacoraBLL --> NotificacionBLL -- : void
NotificacionBLL -> IUnidadDeTrabajo ++ : Save()
IUnidadDeTrabajo --> NotificacionBLL -- : void
NotificacionBLL --> FormGestionNotificaciones -- : bool
group Refrescar listado tras la operacion exitosa
FormGestionNotificaciones -> NotificacionBLL ++ : ObtenerTodas()
NotificacionBLL -> INotificacionRepositorio ++ : ObtenerTodas()
INotificacionRepositorio -> NotificacionDAL ++ : ObtenerTodas(accesoDatos: AccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : List<Notificacion>
INotificacionRepositorio --> NotificacionBLL -- : List<Notificacion>
NotificacionBLL -> IRecordatorioCompraRepositorio ++ : ObtenerTodas()
IRecordatorioCompraRepositorio --> NotificacionBLL -- : List<RecordatorioCompra>
NotificacionBLL -> IRecordatorioInversionRepositorio ++ : ObtenerTodas()
IRecordatorioInversionRepositorio --> NotificacionBLL -- : List<RecordatorioInversion>
NotificacionBLL --> FormGestionNotificaciones -- : List<Notificacion>
end
FormGestionNotificaciones --> Actor : elimina la notificación, actualiza el listado sin ella e informa el resultado.
else El actor cancela la confirmacion
Actor -> FormGestionNotificaciones : Cancelar la operacion
FormGestionNotificaciones --> Actor : Conservar datos, sin invocar la baja
end
