@startuml
' Fuente: diagramas/NEG21-mis-notificaciones/NEG21-mis-notificaciones-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN85 Consultar mis notificaciones — Secuencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide footbox
autonumber
skinparam maxMessageSize 560
actor "Usuario, Operador o Administrador" as Actor
boundary "FormMisNotificaciones" as FormMisNotificaciones
control "NotificacionBLL" as NotificacionBLL
participant "Sesion\n:ISesion" as ISesion
control "SesionUsuarioExtensiones" as SesionUsuarioExtensiones
participant "NotificacionRepositorio\n:INotificacionRepositorio" as INotificacionRepositorio
participant "NotificacionDAL" as NotificacionDAL
participant "UnidadDeTrabajoFactory\n:IUnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory
control "BitacoraBLL\n:IBitacoraBLL" as IBitacoraBLL
participant "UnidadDeTrabajoSqlServer\n:IUnidadDeTrabajo" as IUnidadDeTrabajo
Actor -> FormMisNotificaciones : selecciona la opción «Mis notificaciones» del menú principal, que indica la cantidad de\nnotificaciones no leídas.
FormMisNotificaciones -> NotificacionBLL ++ : BuscarPersonales(filtro: FiltroNotificacion, pagina: int)
NotificacionBLL -> ISesion ++ : HaySesionActiva()
ISesion --> NotificacionBLL -- : bool
NotificacionBLL -> SesionUsuarioExtensiones ++ : ObtenerUsuarioActual(sesion: ISesion)
SesionUsuarioExtensiones --> NotificacionBLL -- : Usuario
NotificacionBLL -> INotificacionRepositorio ++ : ObtenerPaginaPersonal(usuario: Usuario, filtro:\nFiltroNotificacion, pagina: int)
INotificacionRepositorio -> NotificacionDAL ++ : ObtenerPaginaPersonal(usuario: Usuario, filtro:\nFiltroNotificacion, pagina: int, accesoDatos:\nAccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : PaginaNotificaciones
INotificacionRepositorio --> NotificacionBLL -- : PaginaNotificaciones
NotificacionBLL --> FormMisNotificaciones -- : PaginaNotificaciones
FormMisNotificaciones --> Actor : presenta la pantalla «Mis notificaciones» ocupando el área de trabajo, con la sección\n«Filtros» («Desde:», «Hasta:» y el botón «Buscar»), el listado de las notificaciones del\nactor
Actor -> FormMisNotificaciones : activa el filtro «Desde:» y/o «Hasta:», elige las fechas deseadas y selecciona el botón\n«Buscar».
FormMisNotificaciones -> NotificacionBLL ++ : BuscarPersonales(filtro: FiltroNotificacion, pagina: int)
NotificacionBLL --> FormMisNotificaciones -- : PaginaNotificaciones
FormMisNotificaciones --> Actor : presenta la primera página de las notificaciones comprendidas en el rango de fechas\nelegido.
Actor -> FormMisNotificaciones : selecciona los botones «Siguiente» y «Anterior» para recorrer las páginas.
FormMisNotificaciones -> NotificacionBLL ++ : BuscarPersonales(filtro: FiltroNotificacion, pagina: int)
NotificacionBLL --> FormMisNotificaciones -- : PaginaNotificaciones
FormMisNotificaciones --> Actor : presenta la página solicitada y actualiza el indicador de páginas.
Actor -> FormMisNotificaciones : selecciona una notificación y el botón «Ver detalle».
FormMisNotificaciones -> NotificacionBLL ++ : LeerPersonal(recibida: Notificacion)
NotificacionBLL -> ISesion ++ : HaySesionActiva()
ISesion --> NotificacionBLL -- : bool
NotificacionBLL -> SesionUsuarioExtensiones ++ : ObtenerUsuarioActual(sesion: ISesion)
SesionUsuarioExtensiones --> NotificacionBLL -- : Usuario
NotificacionBLL -> IUnidadDeTrabajoFactory ++ : Crear()
IUnidadDeTrabajoFactory --> NotificacionBLL -- : IUnidadDeTrabajo
NotificacionBLL -> INotificacionRepositorio ++ : ObtenerPersonal(notificacion: Notificacion, usuario: Usuario)
INotificacionRepositorio -> NotificacionDAL ++ : ObtenerPersonal(notificacion: Notificacion, usuario: Usuario,\naccesoDatos: AccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : Notificacion
INotificacionRepositorio --> NotificacionBLL -- : Notificacion
opt !n.Leida
NotificacionBLL -> INotificacionRepositorio ++ : MarcarPersonalLeida(notificacion: Notificacion, usuario:\nUsuario)
INotificacionRepositorio -> NotificacionDAL ++ : MarcarPersonalLeida(notificacion: Notificacion, usuario:\nUsuario, accesoDatos: AccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : bool
INotificacionRepositorio --> NotificacionBLL -- : bool
alt !cambio
NotificacionBLL -> INotificacionRepositorio ++ : ObtenerPersonal(notificacion: Notificacion, usuario: Usuario)
INotificacionRepositorio -> NotificacionDAL ++ : ObtenerPersonal(notificacion: Notificacion, usuario: Usuario,\naccesoDatos: AccesoDatosSqlServer)
NotificacionDAL --> INotificacionRepositorio -- : Notificacion
INotificacionRepositorio --> NotificacionBLL -- : Notificacion
else caso contrario
NotificacionBLL -> IBitacoraBLL ++ : RegistrarOperacionInterno(actividad: string, informacion:\nstring, origen: string, unidad: IUnidadDeTrabajo)
IBitacoraBLL --> NotificacionBLL -- : void
end
end
NotificacionBLL -> IUnidadDeTrabajo ++ : Save()
IUnidadDeTrabajo --> NotificacionBLL -- : void
NotificacionBLL --> FormMisNotificaciones -- : Notificacion
FormMisNotificaciones --> Actor : presenta el diálogo «Detalle de notificación» con la fecha, el tipo y el mensaje completo\nde la notificación, y el botón «Cerrar». La notificación queda marcada como «Leída» en el\nlistado.
Actor -> FormMisNotificaciones : selecciona el botón «Cerrar».
FormMisNotificaciones --> Actor : cierra el diálogo y vuelve al listado.
