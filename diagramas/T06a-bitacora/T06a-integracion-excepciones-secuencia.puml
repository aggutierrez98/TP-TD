@startuml
title T06a - Gestion de Bitacora - Integracion con excepciones

actor Usuario
participant UI
participant "UiDialogHelper" as UiDialogHelper
participant "ManejadorExcepcionesBLL" as ManejadorExcepcionesBLL
participant "BootstrapAplicacionBLL" as BootstrapAplicacionBLL
participant "BitacoraService" as BitacoraService
participant "Sesion" as Sesion
participant "BitacoraDAL" as BitacoraDAL

Usuario -> UI : accion que produce error
UI -> ManejadorExcepcionesBLL : ObtenerMensajeUsuarioKey(exception, actividad)

alt exception es ExcepcionNegocio
  ManejadorExcepcionesBLL --> UI : exception.Message
  UI -> UiDialogHelper : MostrarWarning(messageKey)
else exception es ExcepcionTecnica
  ManejadorExcepcionesBLL -> ManejadorExcepcionesBLL : RegistrarExcepcionTecnica(exception, actividad, "UI")
  ManejadorExcepcionesBLL -> BootstrapAplicacionBLL : Inicializar()
  ManejadorExcepcionesBLL -> BitacoraService : RegistrarExcepcionTecnica(actividad, exception, "UI", null)
  BitacoraService -> Sesion : GetUsuarioActualId()
  BitacoraService -> Sesion : GetUsuarioActualNombre()
  BitacoraService -> BitacoraDAL : Guardar(evento, null)
  ManejadorExcepcionesBLL --> UI : exception.Message
  UI -> UiDialogHelper : MostrarError(messageKey)
else exception desconocida
  ManejadorExcepcionesBLL -> ManejadorExcepcionesBLL : RegistrarExcepcionTecnica(exception, actividad, "UI")
  ManejadorExcepcionesBLL -> BootstrapAplicacionBLL : Inicializar()
  ManejadorExcepcionesBLL -> BitacoraService : RegistrarExcepcionTecnica(actividad, exception, "UI", null)
  BitacoraService -> Sesion : GetUsuarioActualId()
  BitacoraService -> Sesion : GetUsuarioActualNombre()
  BitacoraService -> BitacoraDAL : Guardar(evento, null)
  ManejadorExcepcionesBLL --> UI : "Error.Tecnico.Unexpected"
  UI -> UiDialogHelper : MostrarError(messageKey)
end

@enduml
