@startuml
title T06a - Gestion de Bitacora - Registro de operacion

actor Usuario
participant "FormGestionUsuarios" as FormGestionUsuarios
participant "UsuarioBLL" as UsuarioBLL
participant "AccesoDatos" as AccesoDatos
participant "UsuarioDAL" as UsuarioDAL
participant "UsuarioEstadoBLL" as UsuarioEstadoBLL
participant "BitacoraService" as BitacoraService
participant "Sesion" as Sesion
participant "BitacoraDAL" as BitacoraDAL

Usuario -> FormGestionUsuarios : btnEditarUsuario_Click()
FormGestionUsuarios -> UsuarioBLL : Actualizar(_idSeleccionado, nuevoUsername, nuevaPassword, usuarioActivo)
UsuarioBLL -> AccesoDatos : BeginTransactionScope()
UsuarioBLL -> UsuarioDAL : ObtenerPorId(id, accesoDatos)
UsuarioDAL --> UsuarioBLL : usuario
UsuarioBLL -> UsuarioDAL : Actualizar(usuario, accesoDatos)
UsuarioBLL -> UsuarioEstadoBLL : GuardarVersionActual(id, accionHistorial, observacionesHistorial, accesoDatos)
UsuarioBLL -> BitacoraService : RegistrarOperacion(actividadBitacora, informacionBitacora, "UsuarioBLL", accesoDatos)
BitacoraService -> Sesion : GetUsuarioActualId()
BitacoraService -> Sesion : GetUsuarioActualNombre()
BitacoraService -> BitacoraDAL : Guardar(evento, accesoDatos)
UsuarioBLL -> AccesoDatos : CommitTransactionScope()
UsuarioBLL --> FormGestionUsuarios : true

@enduml
