@startuml
title T06a - Gestion de Bitacora - DER

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false

entity "Bitacora" as Bitacora {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  FechaHora : datetime <<NOT NULL>>
  UsuarioId : int <<FK -> Usuarios.Id, NULL>>
  UsernameSnapshot : varchar(50) <<NULL>>
  Actividad : varchar(100) <<NOT NULL>>
  Informacion : varchar(500) <<NULL>>
  Nivel : varchar(20) <<NOT NULL>>
  Origen : varchar(100) <<NOT NULL>>
  EsTecnica : bit <<NOT NULL>>
}

entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY, NOT NULL>>
}

Usuarios ||--o{ Bitacora

note bottom of Bitacora
  UsuarioId es NULL-able: la FK se conserva pero se guarda
  ademas UsernameSnapshot para no perder el autor si el
  usuario se elimina. Nivel in {Informacion, Advertencia, Error}.
end note

@enduml
