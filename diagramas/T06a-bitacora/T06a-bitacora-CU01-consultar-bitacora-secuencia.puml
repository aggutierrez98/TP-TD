@startuml
title T06a - CU01 Consultar bitacora - Secuencia

actor Administrador
participant "FormBitacora" as FormBitacora
participant "BitacoraBLL" as BitacoraBLL
participant "BitacoraService" as BitacoraService
participant "BitacoraDAL" as BitacoraDAL
participant "AccesoDatos" as AccesoDatos

Administrador -> FormBitacora : abrir pantalla / btnBuscarBitacora_Click()
activate FormBitacora
FormBitacora -> FormBitacora : RefrescarDatos()
activate FormBitacora
FormBitacora -> FormBitacora : construir FiltroBitacora\n(FechaDesde, FechaHasta, Usuario, Nivel, EsTecnica)

FormBitacora -> BitacoraBLL : Buscar(filtro)
activate BitacoraBLL
BitacoraBLL -> BitacoraService : ConsultarBitacora(filtro)
activate BitacoraService

note right of BitacoraService
  Delegado _consultor configurado
  por InicializacionBitacoraBLL
  hacia BitacoraDAL.Buscar.
end note

BitacoraService -> BitacoraDAL : Buscar(filtro)
activate BitacoraDAL
BitacoraDAL -> AccesoDatos : Read(query, parametros)
activate AccesoDatos
AccesoDatos --> BitacoraDAL : DataTable
deactivate AccesoDatos
BitacoraDAL --> BitacoraService : List<EventoBitacora>
deactivate BitacoraDAL
BitacoraService --> BitacoraBLL : IList<EventoBitacora>
deactivate BitacoraService
BitacoraBLL --> FormBitacora : List<EventoBitacora>
deactivate BitacoraBLL

FormBitacora -> FormBitacora : filtrar por Actividad (texto traducido)
FormBitacora -> FormBitacora : dgvBitacora.DataSource = filtrados
deactivate FormBitacora

alt ocurre una excepcion durante la consulta
  FormBitacora -> FormBitacora : UiExceptionHandler.Mostrar(ex, "Consulta de bitacora")
end

FormBitacora --> Administrador : grilla con eventos filtrados
deactivate FormBitacora

@enduml
