@startuml
' Fuente: diagramas/NEG08-monedas/NEG08-monedas-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN36 Baja de moneda — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionMonedas {
    -btnEliminarMoneda_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class MonedaBLL {
    +Eliminar(moneda: Moneda): bool
    +ObtenerTodas(): List<Moneda>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
MonedaBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IMonedaRepositorio {
    +ObtenerPorId(id: int): Moneda
    +Eliminar(moneda: Moneda): bool
    +ObtenerTodas(): List<Moneda>
  }
  class MonedaRepositorio {
    +ObtenerPorId(id: int): Moneda
    +Eliminar(moneda: Moneda): bool
    +ObtenerTodas(): List<Moneda>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IMonedaRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> MonedaRepositorio
MonedaRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class MonedaDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): Moneda
    +Eliminar(moneda: Moneda, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerTodas(accesoDatos: AccesoDatosSqlServer): List<Moneda>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Moneda {
    +Id: int
    +Codigo: string
    +Nombre: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
FormGestionMonedas ..> MonedaBLL : usa
MonedaRepositorio ..> MonedaDAL : usa
MonedaBLL ..> IBitacoraBLL : usa
MonedaBLL ..> IMonedaRepositorio : usa
MonedaBLL ..> IUnidadDeTrabajo : usa
MonedaBLL ..> IUnidadDeTrabajoFactory : usa
MonedaRepositorio ..|> IMonedaRepositorio
MonedaBLL ..> Moneda : datos
