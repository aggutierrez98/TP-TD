package "UI" as L_UI {
  class FormDetalleEntidadFinanciera {
    -btnAgregarMedioPagoEntidad_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class EntidadFinancieraBLL {
    +AgregarMedioPagoEntidad(medioPagoEntidad: MedioPagoEntidad): MedioPagoEntidad
    +ObtenerMediosPagoEntidad(entidad: EntidadFinanciera): List<MedioPagoEntidad>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
EntidadFinancieraBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  class "EntidadFinancieraRepositorio" as IEntidadFinancieraRepositorio <<IEntidadFinancieraRepositorio>> {
    +ObtenerPorId(id: int): EntidadFinanciera
  }
  class "MedioPagoRepositorio" as IMedioPagoRepositorio <<IMedioPagoRepositorio>> {
    +ObtenerPorId(id: int): MedioPago
  }
  interface IMedioPagoEntidadRepositorio {
    +ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera): List<MedioPagoEntidad>
    +InsertarYObtenerId(medioPagoEntidad: MedioPagoEntidad): int
  }
  class MedioPagoEntidadRepositorio {
    +ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera): List<MedioPagoEntidad>
    +InsertarYObtenerId(medioPagoEntidad: MedioPagoEntidad): int
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IEntidadFinancieraRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> IMedioPagoRepositorio
IMedioPagoRepositorio -[hidden]right-> IMedioPagoEntidadRepositorio
IMedioPagoRepositorio -[hidden]down-> MedioPagoEntidadRepositorio
MedioPagoEntidadRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class MedioPagoEntidadDAL {
    +ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera, accesoDatos:\nAccesoDatosSqlServer): List<MedioPagoEntidad>
    +InsertarYObtenerId(medioPagoEntidad: MedioPagoEntidad, accesoDatos:\nAccesoDatosSqlServer): int
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class MedioPagoEntidad {
    +Id: int
    +EntidadFinanciera: EntidadFinanciera
    +MedioPago: MedioPago
    +Segmento: string
  }
  enum TipoMedioPago {
    TarjetaCredito
    TarjetaDebito
    TarjetaPrepaga
    CuentaBilleteraVirtual
    CuentaDNI
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
EntidadFinanciera -[hidden]right-> MedioPago
EntidadFinanciera -[hidden]down-> MedioPagoEntidad
MedioPagoEntidad -[hidden]right-> TipoMedioPago
