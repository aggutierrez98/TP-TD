title CUN26 Baja de entidad financiera — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionEntidadesFinancieras {
    -btnEliminarEntidadFinanciera_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class EntidadFinancieraBLL {
    +Eliminar(entidad: EntidadFinanciera): bool
    +ObtenerTodas(): List<EntidadFinanciera>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
EntidadFinancieraBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IEntidadFinancieraRepositorio {
    +ObtenerPorId(id: int): EntidadFinanciera
    +Eliminar(entidad: EntidadFinanciera): bool
    +ObtenerTodas(): List<EntidadFinanciera>
  }
  class EntidadFinancieraRepositorio {
    +ObtenerPorId(id: int): EntidadFinanciera
    +Eliminar(entidad: EntidadFinanciera): bool
    +ObtenerTodas(): List<EntidadFinanciera>
  }
  class "MedioPagoEntidadRepositorio" as IMedioPagoEntidadRepositorio <<IMedioPagoEntidadRepositorio>> {
    +ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera): List<MedioPagoEntidad>
  }
  class "CuentaFinancieraRepositorio" as ICuentaFinancieraRepositorio <<ICuentaFinancieraRepositorio>> {
    +ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera): List<CuentaFinanciera>
  }
  class "PromocionEntidadFinancieraRepositorio" as IPromocionEntidadFinancieraRepositorio <<IPromocionEntidadFinancieraRepositorio>> {
    +ContarPorEntidadFinanciera(entidadFinanciera: EntidadFinanciera): int
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IEntidadFinancieraRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> EntidadFinancieraRepositorio
EntidadFinancieraRepositorio -[hidden]right-> IMedioPagoEntidadRepositorio
EntidadFinancieraRepositorio -[hidden]down-> ICuentaFinancieraRepositorio
ICuentaFinancieraRepositorio -[hidden]right-> IPromocionEntidadFinancieraRepositorio
ICuentaFinancieraRepositorio -[hidden]down-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class EntidadFinancieraDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): EntidadFinanciera
    +Eliminar(entidad: EntidadFinanciera, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerTodas(accesoDatos: AccesoDatosSqlServer): List<EntidadFinanciera>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class CuentaFinanciera {
    +Id: int
    +Usuario: Usuario
    +EntidadFinanciera: EntidadFinanciera
    +Alias: string
    +Tipo: TipoCuentaFinanciera
    +CredencialesCifradas: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class MedioPagoEntidad {
    +Id: int
    +EntidadFinanciera: EntidadFinanciera
    +MedioPago: MedioPago
    +Segmento: string
  }
  enum TipoCuentaFinanciera {
    BilleteraDigital
    CuentaCorriente
    CajaAhorro
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
