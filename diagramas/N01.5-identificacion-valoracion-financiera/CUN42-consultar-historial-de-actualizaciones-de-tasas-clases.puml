IUnidadDeTrabajoFactory -[hidden]right-> IEjecucionActualizacionTasasRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> EjecucionActualizacionTasasRepositorio
package "DAL" as L_DAL {
  class EjecucionActualizacionTasasDAL {
    +ObtenerRecientes(cantidad: int, accesoDatos: AccesoDatosSqlServer):\nList<EjecucionActualizacionTasas>
    +ContarRequestsDelMes(referencia: DateTime, accesoDatos: AccesoDatosSqlServer): int
    +ObtenerDetallePorEjecucion(ejecucion: EjecucionActualizacionTasas, accesoDatos:\nAccesoDatosSqlServer): List<ActualizacionTasaDetalle>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class ActualizacionTasaDetalle {
    +Id: int
    +Ejecucion: EjecucionActualizacionTasas
    +MonedaBase: Moneda
    +MonedaConversion: Moneda
    +ValorAnterior: decimal
    +ValorNuevo: decimal?
    +Estado: EstadoActualizacionTasa
  }
  class EjecucionActualizacionTasas {
    +Id: int
    +FechaInicio: DateTime
    +Origen: OrigenActualizacionTasas
    +Resultado: ResultadoActualizacionTasas
    +ConsumioRequest: bool
    +Mensaje: string
    +Detalles: List<ActualizacionTasaDetalle>
  }
  enum EstadoActualizacionTasa {
    Actualizado
    SaltadoManual
    SaltadoSinDato
  }
  class Moneda {
    +Id: int
    +Codigo: string
    +Nombre: string
  }
  enum OrigenActualizacionTasas {
    Programada
    Manual
  }
  enum ResultadoActualizacionTasas {
    Exitosa
    Fallida
    Omitida
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ActualizacionTasaDetalle -[hidden]right-> EjecucionActualizacionTasas
ActualizacionTasaDetalle -[hidden]down-> EstadoActualizacionTasa
EstadoActualizacionTasa -[hidden]right-> Moneda
EstadoActualizacionTasa -[hidden]down-> OrigenActualizacionTasas
OrigenActualizacionTasas -[hidden]right-> ResultadoActualizacionTasas
ActualizacionTasasBLL ..> IEjecucionActualizacionTasasRepositorio : usa
ActualizacionTasasBLL ..> IUnidadDeTrabajoFactory : usa
EjecucionActualizacionTasasRepositorio ..|> IEjecucionActualizacionTasasRepositorio
