package "UI" as L_UI {
  class FormActualizacionTasas {
    -Refrescar(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class ActualizacionTasasBLL {
    +ObtenerUltimasEjecuciones(cantidad: int): List<EjecucionActualizacionTasas>
    +ObtenerRequestsConsumidasDelMes(): int
    +ObtenerDetalleDeEjecucion(ejecucion: EjecucionActualizacionTasas):\nList<ActualizacionTasaDetalle>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "REPOSITORIO" as L_REPOSITORIO {
