    +ObtenerDetallePorEjecucion(ejecucion: EjecucionActualizacionTasas):\nList<ActualizacionTasaDetalle>
  }
  class EjecucionActualizacionTasasRepositorio {
    +ObtenerRecientes(cantidad: int): List<EjecucionActualizacionTasas>
    +ContarRequestsDelMes(referencia: DateTime): int
    +ObtenerDetallePorEjecucion(ejecucion: EjecucionActualizacionTasas):\nList<ActualizacionTasaDetalle>
  }
}
