EntidadFinancieraDAL --> IEntidadFinancieraRepositorio -- : EntidadFinanciera
IEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : EntidadFinanciera
EntidadFinancieraBLL -> IMedioPagoEntidadRepositorio ++ : ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera)
IMedioPagoEntidadRepositorio --> EntidadFinancieraBLL -- : List<MedioPagoEntidad>
EntidadFinancieraBLL -> ICuentaFinancieraRepositorio ++ : ObtenerPorEntidadFinanciera(entidad: EntidadFinanciera)
ICuentaFinancieraRepositorio --> EntidadFinancieraBLL -- : List<CuentaFinanciera>
EntidadFinancieraBLL -> IPromocionEntidadFinancieraRepositorio ++ : ContarPorEntidadFinanciera(entidadFinanciera: EntidadFinanciera)
IPromocionEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : int
EntidadFinancieraBLL -> IEntidadFinancieraRepositorio ++ : Eliminar(entidad: EntidadFinanciera)
IEntidadFinancieraRepositorio -> EntidadFinancieraDAL ++ : Eliminar(entidad: EntidadFinanciera, accesoDatos:\nAccesoDatosSqlServer)
EntidadFinancieraDAL --> IEntidadFinancieraRepositorio -- : bool
IEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : bool
EntidadFinancieraBLL -> IBitacoraBLL ++ : RegistrarOperacionInterno(actividad: string, informacion:\nstring, origen: string, unidad: IUnidadDeTrabajo)
IBitacoraBLL --> EntidadFinancieraBLL -- : void
EntidadFinancieraBLL -> IUnidadDeTrabajo ++ : Save()
IUnidadDeTrabajo --> EntidadFinancieraBLL -- : void
EntidadFinancieraBLL --> FormGestionEntidadesFinancieras -- : bool
group Refrescar listado tras la operacion exitosa
FormGestionEntidadesFinancieras -> EntidadFinancieraBLL ++ : ObtenerTodas()
EntidadFinancieraBLL -> IEntidadFinancieraRepositorio ++ : ObtenerTodas()
IEntidadFinancieraRepositorio -> EntidadFinancieraDAL ++ : ObtenerTodas(accesoDatos: AccesoDatosSqlServer)
EntidadFinancieraDAL --> IEntidadFinancieraRepositorio -- : List<EntidadFinanciera>
IEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : List<EntidadFinanciera>
EntidadFinancieraBLL --> FormGestionEntidadesFinancieras -- : List<EntidadFinanciera>
end
FormGestionEntidadesFinancieras --> Actor : elimina la entidad, vacía el campo «Nombre:», actualiza el listado sin la entidad\neliminada e informa el resultado.
else El actor cancela la confirmacion
Actor -> FormGestionEntidadesFinancieras : Cancelar la operacion
FormGestionEntidadesFinancieras --> Actor : Conservar datos, sin invocar la baja
end
