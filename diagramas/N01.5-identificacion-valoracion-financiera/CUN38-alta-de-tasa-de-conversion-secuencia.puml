' BLL/TasaConversionBLL.cs:81 TasaConversionBLL.Crear
' DAL/TasaConversionDAL.cs:117 TasaConversionDAL.InsertarYObtenerId
' DAL/TasaConversionDAL.cs:55 TasaConversionDAL.ObtenerTodas
' DAL/TasaConversionDAL.cs:86 TasaConversionDAL.ObtenerPorParDeMonedas
' REPOSITORIO/IMonedaRepositorio.cs:8 IMonedaRepositorio.ObtenerPorId
' REPOSITORIO/ITasaConversionRepositorio.cs:10 ITasaConversionRepositorio.ObtenerTodas
' REPOSITORIO/ITasaConversionRepositorio.cs:12 ITasaConversionRepositorio.ObtenerPorParDeMonedas
' REPOSITORIO/ITasaConversionRepositorio.cs:14 ITasaConversionRepositorio.InsertarYObtenerId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/TasaConversionRepositorio.cs:30 TasaConversionRepositorio.ObtenerTodas
' REPOSITORIO/TasaConversionRepositorio.cs:41 TasaConversionRepositorio.ObtenerPorParDeMonedas
' REPOSITORIO/TasaConversionRepositorio.cs:64 TasaConversionRepositorio.InsertarYObtenerId
' UI/FormGestionMonedas.cs:234 FormGestionMonedas.btnAgregarTasa_Click
@enduml
