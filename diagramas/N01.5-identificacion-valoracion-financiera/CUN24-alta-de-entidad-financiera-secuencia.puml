' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN24 Alta de entidad financiera — Secuencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide footbox
autonumber
skinparam maxMessageSize 560
actor "Operador o Administrador" as Actor
boundary "FormGestionEntidadesFinancieras" as FormGestionEntidadesFinancieras
control "EntidadFinancieraBLL" as EntidadFinancieraBLL
participant "UnidadDeTrabajoFactory\n:IUnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory
participant "EntidadFinancieraRepositorio\n:IEntidadFinancieraRepositorio" as IEntidadFinancieraRepositorio
participant "EntidadFinancieraDAL" as EntidadFinancieraDAL
control "BitacoraBLL\n:IBitacoraBLL" as IBitacoraBLL
participant "UnidadDeTrabajoSqlServer\n:IUnidadDeTrabajo" as IUnidadDeTrabajo
note over FormGestionEntidadesFinancieras : El actor desea incorporar una entidad financiera que aún no figura en el\ncatálogo.
Actor -> FormGestionEntidadesFinancieras : selecciona la opción «Entidades financieras» del menú «Operador».
FormGestionEntidadesFinancieras --> Actor : presenta la pantalla «Gestión de entidades financieras» con el listado de entidades\nregistradas.
Actor -> FormGestionEntidadesFinancieras : ingresa el nombre de la nueva entidad en el campo «Nombre:».
Actor -> FormGestionEntidadesFinancieras : presiona el botón «Agregar».
FormGestionEntidadesFinancieras -> EntidadFinancieraBLL ++ : Crear(entidad: EntidadFinanciera)
EntidadFinancieraBLL -> IUnidadDeTrabajoFactory ++ : Crear()
IUnidadDeTrabajoFactory --> EntidadFinancieraBLL -- : IUnidadDeTrabajo
EntidadFinancieraBLL -> IEntidadFinancieraRepositorio ++ : ObtenerTodas()
IEntidadFinancieraRepositorio -> EntidadFinancieraDAL ++ : ObtenerTodas(accesoDatos: AccesoDatosSqlServer)
EntidadFinancieraDAL --> IEntidadFinancieraRepositorio -- : List<EntidadFinanciera>
IEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : List<EntidadFinanciera>
EntidadFinancieraBLL -> IEntidadFinancieraRepositorio ++ : InsertarYObtenerId(entidad: EntidadFinanciera)
IEntidadFinancieraRepositorio -> EntidadFinancieraDAL ++ : InsertarYObtenerId(entidad: EntidadFinanciera, accesoDatos:\nAccesoDatosSqlServer)
EntidadFinancieraDAL --> IEntidadFinancieraRepositorio -- : int
IEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : int
EntidadFinancieraBLL -> IBitacoraBLL ++ : RegistrarOperacionInterno(actividad: string, informacion:\nstring, origen: string, unidad: IUnidadDeTrabajo)
IBitacoraBLL --> EntidadFinancieraBLL -- : void
EntidadFinancieraBLL -> IUnidadDeTrabajo ++ : Save()
IUnidadDeTrabajo --> EntidadFinancieraBLL -- : void
EntidadFinancieraBLL --> FormGestionEntidadesFinancieras -- : EntidadFinanciera
group Refrescar listado tras la operacion exitosa
FormGestionEntidadesFinancieras -> EntidadFinancieraBLL ++ : ObtenerTodas()
EntidadFinancieraBLL -> IEntidadFinancieraRepositorio ++ : ObtenerTodas()
IEntidadFinancieraRepositorio -> EntidadFinancieraDAL ++ : ObtenerTodas(accesoDatos: AccesoDatosSqlServer)
EntidadFinancieraDAL --> IEntidadFinancieraRepositorio -- : List<EntidadFinanciera>
IEntidadFinancieraRepositorio --> EntidadFinancieraBLL -- : List<EntidadFinanciera>
EntidadFinancieraBLL --> FormGestionEntidadesFinancieras -- : List<EntidadFinanciera>
end
FormGestionEntidadesFinancieras --> Actor : registra la entidad, vacía el campo «Nombre:», actualiza el listado con la nueva entidad\nseleccionada e informa el resultado.
