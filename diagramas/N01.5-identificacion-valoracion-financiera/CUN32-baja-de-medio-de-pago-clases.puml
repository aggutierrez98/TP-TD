@startuml
' Fuente: diagramas/NEG07-medios-pago/NEG07-medios-pago-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN32 Baja de medio de pago — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionMediosPago {
    -btnEliminarMedioPago_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class MedioPagoBLL {
    +Eliminar(medioPago: MedioPago): bool
    +ObtenerTodos(): List<MedioPago>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
MedioPagoBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IMedioPagoRepositorio {
    +ObtenerPorId(id: int): MedioPago
    +Eliminar(medioPago: MedioPago): bool
    +ObtenerTodos(): List<MedioPago>
  }
  class MedioPagoRepositorio {
    +ObtenerPorId(id: int): MedioPago
    +Eliminar(medioPago: MedioPago): bool
    +ObtenerTodos(): List<MedioPago>
  }
  class "MedioPagoEntidadRepositorio" as IMedioPagoEntidadRepositorio <<IMedioPagoEntidadRepositorio>> {
    +ObtenerPorMedioPago(medioPago: MedioPago): List<MedioPagoEntidad>
  }
  class "PromocionMedioPagoRepositorio" as IPromocionMedioPagoRepositorio <<IPromocionMedioPagoRepositorio>> {
    +ContarPorMedioPago(medioPago: MedioPago): int
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IMedioPagoRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> MedioPagoRepositorio
MedioPagoRepositorio -[hidden]right-> IMedioPagoEntidadRepositorio
MedioPagoRepositorio -[hidden]down-> IPromocionMedioPagoRepositorio
IPromocionMedioPagoRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class MedioPagoDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): MedioPago
    +Eliminar(medioPago: MedioPago, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerTodos(accesoDatos: AccesoDatosSqlServer): List<MedioPago>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class MedioPagoEntidad {
    +Id: int
    +EntidadFinanciera: EntidadFinanciera
    +MedioPago: MedioPago
    +Segmento: string
  }
  enum TipoMedioPago {
    TarjetaCredito
    TarjetaDebito
    TarjetaPrepaga
    CuentaBilleteraVirtual
    CuentaDNI
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
EntidadFinanciera -[hidden]right-> MedioPago
EntidadFinanciera -[hidden]down-> MedioPagoEntidad
MedioPagoEntidad -[hidden]right-> TipoMedioPago
FormGestionMediosPago ..> MedioPagoBLL : usa
MedioPagoRepositorio ..> MedioPagoDAL : usa
MedioPagoBLL ..> IBitacoraBLL : usa
MedioPagoBLL ..> IMedioPagoEntidadRepositorio : usa
MedioPagoBLL ..> IMedioPagoRepositorio : usa
MedioPagoBLL ..> IPromocionMedioPagoRepositorio : usa
MedioPagoBLL ..> IUnidadDeTrabajo : usa
MedioPagoBLL ..> IUnidadDeTrabajoFactory : usa
MedioPagoRepositorio ..|> IMedioPagoRepositorio
MedioPagoBLL ..> MedioPago : datos
EntidadFinanciera --> "*" MedioPagoEntidad : MediosPagoEntidad
MedioPago --> TipoMedioPago : Tipo
MedioPagoEntidad --> EntidadFinanciera : EntidadFinanciera
MedioPagoEntidad --> MedioPago : MedioPago
