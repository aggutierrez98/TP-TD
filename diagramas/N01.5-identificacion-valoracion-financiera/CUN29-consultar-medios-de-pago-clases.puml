@startuml
' Fuente: diagramas/NEG07-medios-pago/NEG07-medios-pago-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN29 Consultar medios de pago — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionMediosPago {
    -CargarMediosPago(medioPagoSeleccionadoId: int?): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class MedioPagoBLL {
    +ObtenerTodos(): List<MedioPago>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "REPOSITORIO" as L_REPOSITORIO {
  interface IMedioPagoRepositorio {
    +ObtenerTodos(): List<MedioPago>
  }
  class MedioPagoRepositorio {
    +ObtenerTodos(): List<MedioPago>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IMedioPagoRepositorio -[hidden]right-> MedioPagoRepositorio
package "DAL" as L_DAL {
  class MedioPagoDAL {
    +ObtenerTodos(accesoDatos: AccesoDatosSqlServer): List<MedioPago>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  enum TipoMedioPago {
    TarjetaCredito
    TarjetaDebito
    TarjetaPrepaga
    CuentaBilleteraVirtual
    CuentaDNI
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
MedioPago -[hidden]right-> TipoMedioPago
FormGestionMediosPago ..> MedioPagoBLL : usa
MedioPagoRepositorio ..> MedioPagoDAL : usa
MedioPagoBLL ..> IMedioPagoRepositorio : usa
MedioPagoRepositorio ..|> IMedioPagoRepositorio
MedioPagoBLL ..> MedioPago : datos
MedioPago --> TipoMedioPago : Tipo
' BLL/MedioPagoBLL.cs:28 MedioPagoBLL.ObtenerTodos
' DAL/MedioPagoDAL.cs:50 MedioPagoDAL.ObtenerTodos
' REPOSITORIO/IMedioPagoRepositorio.cs:10 IMedioPagoRepositorio.ObtenerTodos
' REPOSITORIO/MedioPagoRepositorio.cs:29 MedioPagoRepositorio.ObtenerTodos
' UI/FormGestionMediosPago.cs:55 FormGestionMediosPago.CargarMediosPago
@enduml
