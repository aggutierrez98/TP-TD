@startuml
title T06b - Gestion de Control de Cambios - DER

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false

entity "UsuarioHistorial" as Hist {
  *HistorialId : int <<PK, IDENTITY, NOT NULL>>
  --
  UsuarioId : int <<FK -> Usuarios.Id, NOT NULL>>
  FechaHora : datetime <<NOT NULL>>
  ActorUsuarioId : int <<FK -> Usuarios.Id, NULL>>
  ActorUsernameSnapshot : varchar(50) <<NULL>>
  Accion : varchar(100) <<NOT NULL>>
  Observaciones : varchar(500) <<NULL>>
  Username : varchar(50) <<NOT NULL>>
  PasswordHash : varchar(max) <<NOT NULL>>
  Activo : bit <<NOT NULL>>
  IdiomaId : int <<NULL>>
}

entity "UsuarioHistorialPermiso" as HistPerm {
  *HistorialId : int <<PK, FK -> UsuarioHistorial.HistorialId, NOT NULL>>
  *PermisoId : int <<PK, NOT NULL>>
}

entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY, NOT NULL>>
}

Usuarios ||--o{ Hist : UsuarioId
Usuarios ||--o{ Hist : ActorUsuarioId
Hist ||--o{ HistPerm

note bottom of Hist
  Cada fila es un snapshot completo del estado del usuario
  (datos + password hash + activo + idioma). Los permisos
  del snapshot se guardan en UsuarioHistorialPermiso.
  IdiomaId y PermisoId no tienen FK declarada en la base.
end note

@enduml
