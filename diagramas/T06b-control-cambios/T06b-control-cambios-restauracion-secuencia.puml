@startuml
title T06b - Gestion de Control de Cambios - Restauracion de usuario

actor Administrador
participant "FormHistorialUsuario" as FormHistorialUsuario
participant "UsuarioBLL" as UsuarioBLL
participant "UsuarioEstadoBLL" as UsuarioEstadoBLL
participant "HistorialEstadosService" as HistorialEstadosService
participant "UsuarioHistorialDAL" as UsuarioHistorialDAL
participant "Sesion" as Sesion
participant "AccesoDatos" as AccesoDatos
participant "UsuarioDAL" as UsuarioDAL
participant "UsuarioPermisoDAL" as UsuarioPermisoDAL
participant "UsuarioPreferenciaDAL" as UsuarioPreferenciaDAL
participant "BitacoraService" as BitacoraService
participant "PermisoBLL" as PermisoBLL
participant "AutorizacionService" as AutorizacionService
participant "IdiomaBLL" as IdiomaBLL

Administrador -> FormHistorialUsuario : btnRestaurarVersion_Click()
FormHistorialUsuario -> UsuarioBLL : RestaurarVersion(historialId)
UsuarioBLL -> UsuarioEstadoBLL : ObtenerVersion(historialId)
UsuarioEstadoBLL -> HistorialEstadosService : ObtenerVersionUsuario(historialId)
HistorialEstadosService -> UsuarioHistorialDAL : ObtenerVersion(historialId)
UsuarioHistorialDAL --> HistorialEstadosService : snapshot
HistorialEstadosService --> UsuarioEstadoBLL : snapshot
UsuarioEstadoBLL --> UsuarioBLL : snapshot
UsuarioBLL -> Sesion : GetUsuarioActualId()
UsuarioBLL -> AccesoDatos : BeginTransactionScope()
UsuarioBLL -> UsuarioDAL : ObtenerPorId(snapshot.UsuarioId, accesoDatos)
UsuarioDAL --> UsuarioBLL : usuario
UsuarioBLL -> UsuarioEstadoBLL : AplicarSnapshot(snapshot, accesoDatos)
UsuarioEstadoBLL -> UsuarioDAL : GuardarEstadoCompleto(usuario, accesoDatos)
UsuarioEstadoBLL -> UsuarioPermisoDAL : ReemplazarPermisosUsuario(snapshot.UsuarioId, snapshot.PermisosIds, accesoDatos)
UsuarioEstadoBLL -> UsuarioPreferenciaDAL : Guardar(snapshot.UsuarioId, snapshot.IdiomaId, accesoDatos)
UsuarioBLL -> UsuarioEstadoBLL : GuardarVersionActual(snapshot.UsuarioId, "FormUserHistory.Value.Action.Restoration", "FormUserHistory.Value.Obs.Restoration", accesoDatos)
UsuarioBLL -> BitacoraService : RegistrarOperacion("FormAuditLog.Value.Activity.UserRestoration", "FormAuditLog.Value.Info.UserRestoration", "UsuarioBLL", accesoDatos)
UsuarioBLL -> AccesoDatos : CommitTransactionScope()
UsuarioBLL -> UsuarioBLL : RefrescarSesionSiCorresponde(snapshot.UsuarioId)

alt usuario restaurado es la sesion actual
  UsuarioBLL -> UsuarioDAL : ObtenerPorId(snapshot.UsuarioId, null)
  UsuarioDAL --> UsuarioBLL : usuarioActualizado
  UsuarioBLL -> Sesion : ActualizarUsuarioActualNombre(usuarioActualizado.Username)
  UsuarioBLL -> PermisoBLL : ObtenerPermisosDirectosUsuario(snapshot.UsuarioId)
  PermisoBLL --> UsuarioBLL : permisosDirectos
  UsuarioBLL -> AutorizacionService : ActualizarPermisosUsuarioActual(permisosDirectos)
  UsuarioBLL -> IdiomaBLL : AplicarIdiomaSesionUsuario(snapshot.UsuarioId)
end

UsuarioBLL --> FormHistorialUsuario : true

@enduml
