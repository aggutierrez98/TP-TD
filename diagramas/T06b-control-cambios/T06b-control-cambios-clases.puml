@startuml
title T06b - Gestion de Control de Cambios - Clases

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam wrapWidth 200
skinparam nodesep 15
skinparam ranksep 45
hide empty members

package "ABSTRACCIONES" {
  interface IUsuarioSnapshot {
    +HistorialId : int
    +UsuarioId : int
    +FechaHora : DateTime
    +ActorUsuarioId : int?
    +ActorUsernameSnapshot : string
    +Accion : string
    +Observaciones : string
    +Username : string
    +PasswordHash : string
    +Activo : bool
    +IdiomaId : int?
    +PermisosIds : IList<int>
  }

  interface IServicioHistorialEstados {
    +GuardarVersionUsuario(snapshot : IUsuarioSnapshot, contextoPersistencia : object = null) : int
    +ObtenerVersionesUsuario(usuarioId : int) : IList<IUsuarioSnapshot>
    +ObtenerVersionUsuario(historialId : int) : IUsuarioSnapshot
  }

  interface IResultadoComparacionEstado {
    +Campo : string
    +ValorAnterior : string
    +ValorNuevo : string
  }
}

package "BE" {
  class Usuario {
    +Id : int
    +Username : string
    +PasswordHash : string
    +Activo : bool
    +DVH : string
    +Permisos : IList<IPermiso>
  }
}

package "SERVICIOS" {
  class Idioma

  class UsuarioPreferencia {
    +UsuarioId : int
    +IdiomaId : int
  }

  class Sesion <<singleton>> {
    +GetInstance() : Sesion
    +GetUsuarioActualId() : int?
    +GetUsuarioActualNombre() : string
    +ActualizarUsuarioActualNombre(username : string) : void
  }

  class AutorizacionService <<singleton>> {
    +GetInstance() : AutorizacionService
    +ActualizarPermisosUsuarioActual(permisos : IEnumerable<IPermiso>) : void
  }

  class BitacoraService <<singleton>> {
    +GetInstance() : BitacoraService
    +RegistrarOperacion(actividad : string, informacion : string, origen : string, contextoPersistencia : object = null) : void
  }

  class HistorialEstadosService <<singleton>> {
    +GetInstance() : HistorialEstadosService
    +Configurar(guardadorVersionUsuario, obtenedorVersionesUsuario, obtenedorVersionUsuario) : void
    +GuardarVersionUsuario(snapshot : UsuarioHistorialSnapshot, contextoPersistencia : object = null) : int
    +ObtenerVersionesUsuario(usuarioId : int) : IList<UsuarioHistorialSnapshot>
    +ObtenerVersionUsuario(historialId : int) : UsuarioHistorialSnapshot
  }

  class UsuarioHistorialSnapshot {
    +HistorialId : int
    +UsuarioId : int
    +FechaHora : DateTime
    +ActorUsuarioId : int?
    +ActorUsernameSnapshot : string
    +Accion : string
    +Observaciones : string
    +Username : string
    +PasswordHash : string
    +Activo : bool
    +IdiomaId : int?
    +PermisosIds : IList<int>
  }

  class ResultadoComparacionEstado {
    +Campo : string
    +ValorAnterior : string
    +ValorNuevo : string
  }
}

package "BLL" {
  class UsuarioBLL {
    +ObtenerHistorialEstados(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersionHistorial(historialId : int) : UsuarioHistorialSnapshot
    +ObtenerDiferenciasConVersionAnterior(historialId : int) : List<ResultadoComparacionEstado>
    +RestaurarVersion(historialId : int) : bool
    -RefrescarSesionSiCorresponde(usuarioId : int) : void
  }

  class UsuarioEstadoBLL {
    +ConstruirSnapshotActual(usuarioId : int, accion : string, observaciones : string, accesoDatos : AccesoDatos = null) : UsuarioHistorialSnapshot
    +GuardarVersionActual(usuarioId : int, accion : string, observaciones : string, accesoDatos : AccesoDatos = null) : int
    +ObtenerHistorial(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersion(historialId : int) : UsuarioHistorialSnapshot
    +CompararVersiones(versionActual : UsuarioHistorialSnapshot, versionAnterior : UsuarioHistorialSnapshot) : List<ResultadoComparacionEstado>
    +AplicarSnapshot(snapshot : UsuarioHistorialSnapshot, accesoDatos : AccesoDatos) : void
  }

  class IdiomaBLL {
    +AplicarIdiomaSesionUsuario(usuario : IUsuarioAutenticado) : void
  }

  class PermisoBLL {
    +ObtenerPermisosDirectosUsuario(usuarioId : int) : List<IPermiso>
  }

  class IntegridadBLL {
    +CalcularDVH<T>(entidad : T) : string
    +ActualizarDVV(tabla : string, dvhAnterior : string, dvhNuevo : string, accesoDatos : AccesoDatos) : void
  }

  class BootstrapAplicacionBLL {
    +Inicializar() : void
  }

  class InicializacionHistorialBLL {
    +Inicializar() : void
  }
}

package "DAL" {
  class UsuarioDAL {
    +ObtenerPorId(id : int, accesoDatos : AccesoDatos = null) : Usuario
    +GuardarEstadoCompleto(usuario : Usuario, accesoDatos : AccesoDatos = null) : bool
    +ActualizarDVH(id : int, dvh : string, accesoDatos : AccesoDatos = null) : bool
  }

  class UsuarioPermisoDAL {
    +ObtenerPermisoIdsPorUsuario(usuarioId : int, accesoDatos : AccesoDatos = null) : List<int>
    +ReemplazarPermisosUsuario(usuarioId : int, permisosId : List<int>, accesoDatos : AccesoDatos = null) : bool
  }

  class UsuarioPreferenciaDAL {
    +ObtenerPorUsuarioId(usuarioId : int, accesoDatos : AccesoDatos = null) : UsuarioPreferencia
    +Guardar(usuarioId : int, idiomaId : int?, accesoDatos : AccesoDatos = null) : bool
  }

  class UsuarioHistorialDAL {
    +GuardarVersion(snapshot : UsuarioHistorialSnapshot, accesoDatos : AccesoDatos = null) : int
    +ObtenerVersiones(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersion(historialId : int) : UsuarioHistorialSnapshot
  }

  class AccesoDatos {
    +BeginTransactionScope() : void
    +CommitTransactionScope() : void
    +RollbackTransactionScope() : void
  }
}

package "UI" {
  class FormTraducibleBase {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }

  class FormHistorialUsuario {
    #OnIdiomaActualizado(idioma : Idioma) : void
  }
}

IUsuarioSnapshot <|.. UsuarioHistorialSnapshot
IServicioHistorialEstados <|.. HistorialEstadosService
IResultadoComparacionEstado <|.. ResultadoComparacionEstado

FormTraducibleBase <|-- FormHistorialUsuario
UsuarioBLL --> UsuarioEstadoBLL
UsuarioBLL --> PermisoBLL
UsuarioBLL --> IdiomaBLL
UsuarioBLL --> Sesion
UsuarioBLL --> AutorizacionService
UsuarioBLL --> BitacoraService
UsuarioBLL --> IntegridadBLL
UsuarioBLL --> UsuarioDAL
IntegridadBLL --> UsuarioDAL
UsuarioEstadoBLL --> UsuarioDAL
UsuarioEstadoBLL --> UsuarioPermisoDAL
UsuarioEstadoBLL --> UsuarioPreferenciaDAL
UsuarioEstadoBLL --> HistorialEstadosService
UsuarioEstadoBLL --> Sesion
InicializacionHistorialBLL --> HistorialEstadosService
InicializacionHistorialBLL --> UsuarioHistorialDAL
HistorialEstadosService --> UsuarioHistorialSnapshot
UsuarioHistorialDAL --> AccesoDatos
FormHistorialUsuario --> UsuarioBLL

note right of UsuarioHistorialSnapshot
  Snapshot persistente del estado del usuario.
  El campo PasswordHash se conserva en historial,
  pero la UI no lo expone en claro.
end note

@enduml
