@startuml
title T06b - Gestion de Control de Cambios - Clases

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "UI" {
  class FormHistorialUsuario {
    +btnRestaurarVersion_Click() : void
    +dgvHistorialUsuario_SelectionChanged() : void
    -RefrescarDatos() : void
  }
}

package "BLL" {
  class UsuarioBLL {
    +ObtenerHistorialEstados(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersionHistorial(historialId : int) : UsuarioHistorialSnapshot
    +ObtenerDiferenciasConVersionAnterior(historialId : int) : List<ResultadoComparacionEstado>
    +RestaurarVersion(historialId : int) : bool
  }
  class UsuarioEstadoBLL {
    +GuardarVersionActualInterno(usuarioId : int, accion : string, observaciones : string, unidad : IUnidadDeTrabajo) : int
    +ObtenerHistorial(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersion(historialId : int) : UsuarioHistorialSnapshot
    +CompararVersiones(actual : UsuarioHistorialSnapshot, anterior : UsuarioHistorialSnapshot) : List<ResultadoComparacionEstado>
    +AplicarSnapshotInterno(snapshot : UsuarioHistorialSnapshot, unidad : IUnidadDeTrabajo) : void
    +ConstruirSnapshotActualInterno(usuarioId : int, accion : string, observaciones : string, unidad : IUnidadDeTrabajo) : UsuarioHistorialSnapshot
  }
  interface IIntegridadBLL <<internal>> {
    +CalcularDVH<T>(entidad : T) : string
    +ActualizarDVVInterno(tabla : string, dvhAnterior : string, dvhNuevo : string, unidad : IUnidadDeTrabajo) : void
  }
  interface IBitacoraBLL <<internal>>
}

package "ABSTRACCIONES" {
  interface IServicioHistorialEstados {
    +ObtenerVersionesUsuario(usuarioId : int) : IList<IUsuarioSnapshot>
    +ObtenerVersionUsuario(historialId : int) : IUsuarioSnapshot
  }
  interface IUsuarioSnapshot
  interface IResultadoComparacionEstado
  interface ISesion
}

package "SERVICIOS" {
  class HistorialEstadosService <<singleton>> {
    +GetInstance() : HistorialEstadosService
    +Configurar(...) : void
    +ObtenerVersionesUsuario(usuarioId : int) : IList<UsuarioHistorialSnapshot>
    +ObtenerVersionUsuario(historialId : int) : UsuarioHistorialSnapshot
  }
  class UsuarioHistorialSnapshot {
    +HistorialId : int
    +UsuarioId : int
    +FechaHora : DateTime
    +Accion : string
    +Observaciones : string
    +Username : string
    +PasswordHash : string
    +Activo : bool
    +IdiomaId : int?
    +PermisosIds : IList<int>
  }
  class ResultadoComparacionEstado {
    +Campo : string
    +ValorAnterior : string
    +ValorNuevo : string
  }
}

package "REPOSITORIO" {
  interface IUnidadDeTrabajo {
    +Usuarios : IUsuarioRepositorio
    +UsuarioHistorial : IUsuarioHistorialRepositorio
    +UsuarioPermisos : IUsuarioPermisoRepositorio
    +UsuarioPreferencias : IUsuarioPreferenciaRepositorio
    +Save() : void
  }
  interface IUsuarioHistorialRepositorio {
    +GuardarVersion(snapshot : UsuarioHistorialSnapshot) : int
    +ObtenerVersiones(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersion(historialId : int) : UsuarioHistorialSnapshot
  }
  class UsuarioHistorialRepositorio
}

package "DAL" {
  class UsuarioHistorialDAL {
    +GuardarVersion(snapshot : UsuarioHistorialSnapshot, accesoDatos : AccesoDatosSqlServer = null) : int
    +ObtenerVersiones(usuarioId : int) : List<UsuarioHistorialSnapshot>
    +ObtenerVersion(historialId : int) : UsuarioHistorialSnapshot
  }
}

FormHistorialUsuario --> UsuarioBLL
UsuarioBLL --> UsuarioEstadoBLL
UsuarioBLL ..> IIntegridadBLL : restaurar recalcula DVH/DVV
UsuarioBLL ..> IBitacoraBLL

UsuarioEstadoBLL ..|> "IUsuarioEstadoBLL"
UsuarioEstadoBLL --> IServicioHistorialEstados : lectura de versiones
UsuarioEstadoBLL ..> IUnidadDeTrabajo : escritura (GuardarVersion / AplicarSnapshot)
UsuarioEstadoBLL ..> ResultadoComparacionEstado : <<creates>>

HistorialEstadosService ..|> IServicioHistorialEstados
HistorialEstadosService ..> IUsuarioHistorialRepositorio : delegados (Configurar)
UsuarioHistorialSnapshot ..|> IUsuarioSnapshot
ResultadoComparacionEstado ..|> IResultadoComparacionEstado

IUnidadDeTrabajo --> IUsuarioHistorialRepositorio : UsuarioHistorial
UsuarioHistorialRepositorio ..|> IUsuarioHistorialRepositorio
UsuarioHistorialRepositorio --> UsuarioHistorialDAL

note bottom of UsuarioEstadoBLL
  Lectura del historial: HistorialEstadosService (singleton
  configurado con delegados al repositorio en el arranque).
  Escritura (guardar version / restaurar): via IUnidadDeTrabajo
  dentro de la transaccion del caso de uso.
end note

@enduml
