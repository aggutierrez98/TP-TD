@startuml
title T06b - CU04 Restaurar version de usuario - Secuencia

actor Administrador
participant "FormHistorialUsuario" as FormHistorialUsuario
participant "UiDialogHelper" as UiDialogHelper
participant "UsuarioBLL" as UsuarioBLL
participant "Sesion" as Sesion
participant "UsuarioEstadoBLL" as UsuarioEstadoBLL
participant "HistorialEstadosService" as HistorialEstadosService
participant "UsuarioHistorialDAL" as UsuarioHistorialDAL
participant "AccesoDatos" as AccesoDatos
participant "UsuarioDAL" as UsuarioDAL
participant "UsuarioPermisoDAL" as UsuarioPermisoDAL
participant "UsuarioPreferenciaDAL" as UsuarioPreferenciaDAL
participant "IntegridadBLL" as IntegridadBLL
participant "BitacoraService" as BitacoraService
participant "PermisoBLL" as PermisoBLL
participant "AutorizacionService" as AutorizacionService
participant "IdiomaBLL" as IdiomaBLL

Administrador -> FormHistorialUsuario : btnRestaurarVersion_Click()
activate FormHistorialUsuario

alt no hay version seleccionada
  FormHistorialUsuario -> UiDialogHelper : MostrarWarning("FormUserHistory.Warning.SelectVersion")
  FormHistorialUsuario --> Administrador : fin (sin cambios)
else hay version seleccionada
  FormHistorialUsuario -> UiDialogHelper : Confirmar("FormUserHistory.Confirm.RestoreVersionMessage", ...)
  UiDialogHelper --> FormHistorialUsuario : DialogResult

  alt el administrador no confirma
    FormHistorialUsuario --> Administrador : fin (sin cambios)
  else el administrador confirma
    FormHistorialUsuario -> UsuarioBLL : RestaurarVersion(historialId)
    activate UsuarioBLL

    UsuarioBLL -> UsuarioEstadoBLL : ObtenerVersion(historialId)
    activate UsuarioEstadoBLL
    UsuarioEstadoBLL -> HistorialEstadosService : ObtenerVersionUsuario(historialId)
    HistorialEstadosService -> UsuarioHistorialDAL : ObtenerVersion(historialId)
    UsuarioHistorialDAL --> HistorialEstadosService : snapshot
    HistorialEstadosService --> UsuarioEstadoBLL : snapshot
    UsuarioEstadoBLL --> UsuarioBLL : snapshot
    deactivate UsuarioEstadoBLL

    alt snapshot == null
      UsuarioBLL --> FormHistorialUsuario : throw ExcepcionNegocio("Error.User.RestoreVersionNotFound")
    end

    UsuarioBLL -> Sesion : GetUsuarioActualId()
    Sesion --> UsuarioBLL : usuarioActualId?
    alt restaura version inactiva de la sesion actual
      UsuarioBLL --> FormHistorialUsuario : throw ExcepcionNegocio("Error.User.CannotRestoreInactiveCurrentSession")
    end

    group transaccion [AccesoDatos]
      UsuarioBLL -> AccesoDatos : BeginTransactionScope()
      UsuarioBLL -> UsuarioDAL : ObtenerPorId(snapshot.UsuarioId, accesoDatos)
      UsuarioDAL --> UsuarioBLL : usuario (dvhAnterior = usuario.DVH)

      UsuarioBLL -> UsuarioEstadoBLL : AplicarSnapshot(snapshot, accesoDatos)
      activate UsuarioEstadoBLL
      UsuarioEstadoBLL -> UsuarioDAL : GuardarEstadoCompleto(usuario, accesoDatos)
      UsuarioEstadoBLL -> UsuarioPermisoDAL : ReemplazarPermisosUsuario(snapshot.UsuarioId, snapshot.PermisosIds, accesoDatos)
      UsuarioEstadoBLL -> UsuarioPreferenciaDAL : Guardar(snapshot.UsuarioId, snapshot.IdiomaId, accesoDatos)
      deactivate UsuarioEstadoBLL

      UsuarioBLL -> UsuarioDAL : ObtenerPorId(snapshot.UsuarioId, accesoDatos)
      UsuarioDAL --> UsuarioBLL : usuarioRestaurado
      UsuarioBLL -> IntegridadBLL : CalcularDVH(usuarioRestaurado)
      IntegridadBLL --> UsuarioBLL : dvhNuevo
      UsuarioBLL -> UsuarioDAL : ActualizarDVH(snapshot.UsuarioId, dvhNuevo, accesoDatos)

      UsuarioBLL -> UsuarioEstadoBLL : GuardarVersionActual(snapshot.UsuarioId, "...Action.Restoration", "...Obs.Restoration", accesoDatos)
      activate UsuarioEstadoBLL
      UsuarioEstadoBLL -> HistorialEstadosService : GuardarVersionUsuario(snapshotNuevo, accesoDatos)
      HistorialEstadosService -> UsuarioHistorialDAL : GuardarVersion(snapshotNuevo, accesoDatos)
      deactivate UsuarioEstadoBLL

      UsuarioBLL -> BitacoraService : RegistrarOperacion("...Activity.UserRestoration", "...Info.UserRestoration", "UsuarioBLL", accesoDatos)
      UsuarioBLL -> IntegridadBLL : ActualizarDVV("Usuarios", dvhAnterior, dvhNuevo, accesoDatos)
      UsuarioBLL -> AccesoDatos : CommitTransactionScope()
    end

    UsuarioBLL -> UsuarioBLL : RefrescarSesionSiCorresponde(snapshot.UsuarioId)
    activate UsuarioBLL
    alt usuario restaurado es la sesion actual
      UsuarioBLL -> UsuarioDAL : ObtenerPorId(snapshot.UsuarioId)
      UsuarioDAL --> UsuarioBLL : usuarioActualizado
      UsuarioBLL -> Sesion : ActualizarUsuarioActualNombre(usuarioActualizado.Username)
      UsuarioBLL -> PermisoBLL : ObtenerPermisosDirectosUsuario(snapshot.UsuarioId)
      PermisoBLL --> UsuarioBLL : List<IPermiso>
      UsuarioBLL -> AutorizacionService : ActualizarPermisosUsuarioActual(permisosDirectos)
      UsuarioBLL -> IdiomaBLL : AplicarIdiomaSesionUsuario(usuarioActualizado)
    end
    deactivate UsuarioBLL

    UsuarioBLL --> FormHistorialUsuario : true
    deactivate UsuarioBLL

    alt restauracion exitosa
      FormHistorialUsuario -> UiDialogHelper : MostrarInfo("FormUserHistory.Success.VersionRestored")
      FormHistorialUsuario -> FormHistorialUsuario : RefrescarDatos()
    else excepcion durante la restauracion
      FormHistorialUsuario -> FormHistorialUsuario : UiExceptionHandler.Mostrar(ex, "Restauracion de usuario")
    end
  end
end
deactivate FormHistorialUsuario

@enduml
