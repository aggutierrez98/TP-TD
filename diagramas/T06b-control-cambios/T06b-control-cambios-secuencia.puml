@startuml
title T06b - Gestion de Control de Cambios - Captura de version (secuencia general)

participant "OperacionBLL\n(p. ej. UsuarioBLL)" as OperacionBLL
participant "UsuarioEstadoBLL" as UsuarioEstadoBLL
participant "UsuarioDAL" as UsuarioDAL
participant "UsuarioPreferenciaDAL" as UsuarioPreferenciaDAL
participant "UsuarioPermisoDAL" as UsuarioPermisoDAL
participant "Sesion" as Sesion
participant "HistorialEstadosService" as HistorialEstadosService
participant "UsuarioHistorialDAL" as UsuarioHistorialDAL

note over OperacionBLL
  Toda operacion que cambia el estado de un usuario
  (alta, edicion, baja, restauracion) captura una version
  dentro de la misma transaccion.
end note

OperacionBLL -> UsuarioEstadoBLL : GuardarVersionActual(usuarioId, accion, observaciones, accesoDatos)
activate UsuarioEstadoBLL

UsuarioEstadoBLL -> UsuarioEstadoBLL : ConstruirSnapshotActual(usuarioId, accion, observaciones, accesoDatos)
activate UsuarioEstadoBLL
UsuarioEstadoBLL -> UsuarioDAL : ObtenerPorId(usuarioId, accesoDatos)
UsuarioDAL --> UsuarioEstadoBLL : usuario
UsuarioEstadoBLL -> UsuarioPreferenciaDAL : ObtenerPorUsuarioId(usuarioId, accesoDatos)
UsuarioPreferenciaDAL --> UsuarioEstadoBLL : preferencia
UsuarioEstadoBLL -> Sesion : GetUsuarioActualId()
Sesion --> UsuarioEstadoBLL : actorUsuarioId?
UsuarioEstadoBLL -> Sesion : GetUsuarioActualNombre()
Sesion --> UsuarioEstadoBLL : actorUsername
UsuarioEstadoBLL -> UsuarioPermisoDAL : ObtenerPermisoIdsPorUsuario(usuarioId, accesoDatos)
UsuarioPermisoDAL --> UsuarioEstadoBLL : permisosIds
UsuarioEstadoBLL --> UsuarioEstadoBLL : UsuarioHistorialSnapshot
deactivate UsuarioEstadoBLL

alt snapshot == null (usuario inexistente)
  UsuarioEstadoBLL --> OperacionBLL : 0
else snapshot construido
  UsuarioEstadoBLL -> HistorialEstadosService : GuardarVersionUsuario(snapshot, accesoDatos)
  activate HistorialEstadosService

  note right of HistorialEstadosService
    Delegado configurado por
    InicializacionHistorialBLL hacia
    UsuarioHistorialDAL.GuardarVersion.
  end note

  HistorialEstadosService -> UsuarioHistorialDAL : GuardarVersion(snapshot, accesoDatos)
  activate UsuarioHistorialDAL
  UsuarioHistorialDAL -> UsuarioHistorialDAL : INSERT UsuarioHistorial (OUTPUT HistorialId)
  loop por cada permiso del snapshot
    UsuarioHistorialDAL -> UsuarioHistorialDAL : INSERT UsuarioHistorialPermiso
  end
  UsuarioHistorialDAL --> HistorialEstadosService : historialId
  deactivate UsuarioHistorialDAL
  HistorialEstadosService --> UsuarioEstadoBLL : historialId
  deactivate HistorialEstadosService
  UsuarioEstadoBLL --> OperacionBLL : historialId
end
deactivate UsuarioEstadoBLL

@enduml
