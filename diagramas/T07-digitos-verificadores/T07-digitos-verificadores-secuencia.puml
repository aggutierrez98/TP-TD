@startuml
title T07 - Gestion de Digitos Verificadores - Secuencia general

skinparam backgroundColor white
skinparam shadowing false

actor "Usuario" as Usuario
participant "Program.Main" as Prog
participant "InicializadorAplicacionBLL" as Init
participant "IntegridadBLL" as IBLL
participant "IUnidadDeTrabajoFactory" as UoWF
participant "IUnidadDeTrabajo" as UoW
participant "IIntegridadRepositorio" as IRepo
participant "IIntegridadService" as ISvc
participant "OperacionBLL\n(UsuarioBLL, PermisoBLL, IdiomaBLL, ...)" as OpBLL

group Arranque: verificacion global de integridad
  Usuario -> Prog : inicia la aplicacion
  Prog -> Init : Inicializar()
  Init -> IBLL : ValidarIntegridadGlobal()
  note right of IBLL
    Detalle completo (inicializacion de firmas /
    verificacion horizontal y vertical / contingencia)
    en T07-digitos-verificadores-CU01-verificar-integridad-secuencia.puml.
  end note
end

group Escrituras de usuario: mantenimiento incremental del DVV
  Usuario -> OpBLL : Registrar / Actualizar / Eliminar / RestaurarVersion
  activate OpBLL
  OpBLL -> UoWF : Crear()
  UoWF --> OpBLL : unidad
  activate UoW

  alt Alta de usuario
    OpBLL -> UoW : Usuarios.InsertarYObtenerId(nuevoUsuario)
    UoW --> OpBLL : id
    OpBLL -> IBLL : CalcularDVH(nuevoUsuario)
    IBLL -> ISvc : CalcularDVH(nuevoUsuario)
    ISvc --> IBLL : dvhNuevo
    IBLL --> OpBLL : dvhNuevo
    OpBLL -> UoW : Usuarios.ActualizarDVH(id, dvhNuevo)
    OpBLL -> OpBLL : dvhAnterior = null

  else Actualizacion o restauracion
    OpBLL -> UoW : Usuarios.ObtenerPorId(id)
    UoW --> OpBLL : usuarioDesdeDB
    OpBLL -> OpBLL : dvhAnterior = usuarioDesdeDB.DVH
    OpBLL -> IBLL : CalcularDVH(usuarioModificado)
    IBLL -> ISvc : CalcularDVH(usuarioModificado)
    ISvc --> IBLL : dvhNuevo
    IBLL --> OpBLL : dvhNuevo
    OpBLL -> UoW : Usuarios.Actualizar(usuarioModificado)\no ActualizarDVH(id, dvhNuevo)

  else Baja fisica
    OpBLL -> UoW : Usuarios.ObtenerPorId(id)
    UoW --> OpBLL : usuarioDesdeDB
    OpBLL -> OpBLL : dvhAnterior = usuarioDesdeDB.DVH
    OpBLL -> UoW : Usuarios.EliminarFisicamente(id)
    OpBLL -> OpBLL : dvhNuevo = null
  end

  OpBLL -> IBLL : ActualizarDVVInterno("Usuarios", dvhAnterior, dvhNuevo, unidad)
  activate IBLL
  IBLL -> UoW : Integridad.ObtenerDVV("Usuarios")
  UoW -> IRepo : ObtenerDVV("Usuarios")
  IRepo --> IBLL : dvvActual
  IBLL -> ISvc : CalcularDVVIncremental(dvvActual, dvhAnterior, dvhNuevo)
  ISvc --> IBLL : dvvNuevo
  IBLL -> UoW : Integridad.GuardarDVV("Usuarios", dvvNuevo)
  UoW -> IRepo : GuardarDVV("Usuarios", dvvNuevo)
  IBLL --> OpBLL : void
  deactivate IBLL

  OpBLL -> UoW : Save()
  deactivate UoW
  deactivate OpBLL
end

note over IBLL
  ActualizarDVVInterno es el camino incremental: parte del DVV
  persistido y aplica solo la diferencia entre el DVH anterior y
  el nuevo, sin releer toda la tabla (a diferencia de
  RecalcularDVVInterno, usado en la inicializacion de firmas).
end note

@enduml
