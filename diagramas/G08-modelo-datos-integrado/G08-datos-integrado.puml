    --
    UQ UQ_Dashboard_UsuarioId (UsuarioId)
  }
  entity "dbo.EntidadFinanciera" as T_EntidadFinanciera {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    --
    UQ UQ_EntidadFinanciera_Nombre (Nombre)
  }
  entity "dbo.ItemLista" as T_ItemLista {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    ListaDeComprasId : int <<FK, NOT NULL>>
    Descripcion : varchar(200) <<NOT NULL>>
    Cantidad : int <<NOT NULL>>
    Comprado : bit <<NOT NULL>>
    --
    CHECK CK_ItemLista_Cantidad ([Cantidad]>(0))
  }
  entity "dbo.ListaDeCompras" as T_ListaDeCompras {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    FechaCreacion : datetime <<NOT NULL>>
  }
  entity "dbo.MedioPago" as T_MedioPago {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Tipo : varchar(30) <<NOT NULL>>
    Marca : varchar(50) <<NULL>>
    --
    UQ UQ_MedioPago_Tipo_Marca (Tipo, Marca)
    CHECK CK_MedioPago_Tipo ([Tipo]='CuentaDNI' OR [Tipo]='CuentaBilleteraVirtual' OR\n[Tipo]='TarjetaPrepaga' OR [Tipo]='TarjetaDebito' OR [Tipo]='TarjetaCredito')
  }
  entity "dbo.MedioPagoEntidad" as T_MedioPagoEntidad {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    EntidadFinancieraId : int <<FK, NOT NULL>>
    MedioPagoId : int <<FK, NOT NULL>>
    Segmento : varchar(50) <<NULL>>
    --
    UQ UQ_MedioPagoEntidad_Entidad_Medio_Segmento (EntidadFinancieraId, MedioPagoId, Segmento)
  }
  entity "dbo.Movimiento" as T_Movimiento {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    CategoriaId : int <<FK, NOT NULL>>
    Tipo : varchar(10) <<NOT NULL>>
    Monto : decimal(18,2) <<NOT NULL>>
    Fecha : date <<NOT NULL>>
    Descripcion : varchar(300) <<NULL>>
    FechaCreacion : datetime <<NOT NULL>>
    ComercioId : int <<FK, NULL>>
    --
    CHECK CK_Movimiento_Monto ([Monto]>(0))
    CHECK CK_Movimiento_Tipo ([Tipo]='Egreso' OR [Tipo]='Ingreso')
  }
  entity "dbo.ReglaCategorizacion" as T_ReglaCategorizacion {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    CategoriaId : int <<FK, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    PalabrasClave : varchar(300) <<NULL>>
  }
  entity "dbo.TarjetaDashboard" as T_TarjetaDashboard {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    DashboardId : int <<FK, NOT NULL>>
    Tipo : varchar(30) <<NOT NULL>>
    Orden : int <<NOT NULL>>
    --
    UQ UQ_TarjetaDashboard_DashboardId_Tipo (DashboardId, Tipo)
    CHECK CK_TarjetaDashboard_Tipo ([Tipo]='GastoAcumuladoMensual' OR [Tipo]='GastosPorComercio' OR\n[Tipo]='EvolucionBalance' OR [Tipo]='ComparativoMensual' OR [Tipo]='IngresosPorCategoria' OR\n[Tipo]='GastosPorCategoria')
