@startuml
title G08 - Modelo de datos integrado - TpCatedraIDS
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam classBackgroundColor #F7FBF8
skinparam classBorderColor #40734E
skinparam ArrowColor #61746B
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam nodesep 35
skinparam ranksep 50
hide empty members

hide methods
' Fuente: catalogo real de .\SQLEXPRESS / TpCatedraIDS, 20/10/2026.
' * = PK. NULL/NOT NULL explicitos; UQ = indice unico. Las relaciones son FKs fisicas.
package "Asistente e inversiones" as D0 {
  entity "dbo.ChatbotFinanciero" as T_ChatbotFinanciero {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
  }
  entity "dbo.ConsultaChatbot" as T_ConsultaChatbot {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    ChatbotFinancieroId : int <<FK, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    Pregunta : varchar(max) <<NOT NULL>>
    Respuesta : varchar(max) <<NOT NULL>>
    Fecha : datetime <<NOT NULL>>
    EsPregunta : bit <<NOT NULL>>
  }
  entity "dbo.CorridaGeneracionNotificaciones" as T_CorridaGeneracionNotificaciones {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    InicioUtc : datetime2(7) <<NOT NULL>>
    FinUtc : datetime2(7) <<NULL>>
    Jornada : date <<NOT NULL>>
    Entregadas : int <<NOT NULL>>
    Omitidas : int <<NOT NULL>>
    Fallidas : int <<NOT NULL>>
    --
    CHECK CK_CorridaGeneracionNotificaciones_Cantidades ([Entregadas]>=(0) AND [Omitidas]>=(0) AND\n[Fallidas]>=(0))
    CHECK CK_CorridaGeneracionNotificaciones_Fin ([FinUtc] IS NULL OR [FinUtc]>=[InicioUtc])
  }
  entity "dbo.DetalleGeneracionNotificacion" as T_DetalleGeneracionNotificacion {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    CorridaId : int <<FK, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    TipoAutomatico : varchar(20) <<NOT NULL>>
    Jornada : date <<NOT NULL>>
    Resultado : varchar(10) <<NOT NULL>>
    Motivo : varchar(60) <<NULL>>
    NotificacionId : int <<FK, NULL>>
    FechaUtc : datetime2(7) <<NOT NULL>>
    --
    CHECK CK_DetalleGeneracionNotificacion_Motivo ([Resultado]='Entregada' OR [Motivo] IS NOT NULL AND\nlen([Motivo])>(0))
    CHECK CK_DetalleGeneracionNotificacion_Notificacion ([Resultado]='Entregada' OR [NotificacionId] IS\nNULL)
    CHECK CK_DetalleGeneracionNotificacion_Resultado ([Resultado]='Fallida' OR [Resultado]='Omitida' OR\n[Resultado]='Entregada')
    CHECK CK_DetalleGeneracionNotificacion_Tipo ([TipoAutomatico]='Movimientos' OR\n[TipoAutomatico]='Inversiones' OR [TipoAutomatico]='Compras')
    ON DELETE SET_NULL (NotificacionId)
  }
  entity "dbo.ProductoEmbedding" as T_ProductoEmbedding {
    *ProductoId : int <<PK, FK, NOT NULL>>
    Modelo : varchar(100) <<NOT NULL>>
    TextoFuente : varchar(300) <<NOT NULL>>
    Vector : varbinary(max) <<NOT NULL>>
    FechaCalculo : datetime <<NOT NULL>>
    --
    ON DELETE CASCADE (ProductoId)
  }
}
package "Comercios y promociones" as D1 {
  entity "dbo.CategoriaProducto" as T_CategoriaProducto {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    --
    UQ UQ_CategoriaProducto_Nombre (Nombre)
  }
  entity "dbo.Comercio" as T_Comercio {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    RubroComercioId : int <<FK, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    Direccion : varchar(200) <<NULL>>
    Localidad : varchar(100) <<NULL>>
    Provincia : varchar(100) <<NULL>>
    Latitud : decimal(9,6) <<NULL>>
    Longitud : decimal(9,6) <<NULL>>
  }
  entity "dbo.ComercioProducto" as T_ComercioProducto {
    *ComercioId : int <<PK, FK, NOT NULL>>
    *ProductoId : int <<PK, FK, NOT NULL>>
    MonedaId : int <<FK, NOT NULL>>
    Precio : decimal(18,2) <<NOT NULL>>
    --
    CHECK CK_ComercioProducto_Precio ([Precio]>(0))
  }
  entity "dbo.ComercioReglaCategorizacion" as T_ComercioReglaCategorizacion {
    *ComercioId : int <<PK, FK, NOT NULL>>
    *ReglaCategorizacionId : int <<PK, FK, NOT NULL>>
  }
  entity "dbo.Producto" as T_Producto {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    CategoriaProductoId : int <<FK, NOT NULL>>
    Nombre : varchar(150) <<NOT NULL>>
  }
  entity "dbo.Promocion" as T_Promocion {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Descripcion : varchar(300) <<NOT NULL>>
    Descuento : decimal(5,2) <<NOT NULL>>
    TopeDescuento : decimal(10,2) <<NULL>>
    VigenciaDesde : date <<NOT NULL>>
    VigenciaHasta : date <<NOT NULL>>
    --
    CHECK CK_Promocion_Descuento ([Descuento]>(0) AND [Descuento]<=(100))
    CHECK CK_Promocion_TopeDescuento ([TopeDescuento] IS NULL OR [TopeDescuento]>(0))
    CHECK CK_Promocion_Vigencia ([VigenciaHasta]>=[VigenciaDesde])
  }
  entity "dbo.PromocionCategoriaProducto" as T_PromocionCategoriaProducto {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *CategoriaProductoId : int <<PK, FK, NOT NULL>>
    Excluido : bit <<NOT NULL>>
  }
  entity "dbo.PromocionComercio" as T_PromocionComercio {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *ComercioId : int <<PK, FK, NOT NULL>>
  }
  entity "dbo.PromocionDiaSemana" as T_PromocionDiaSemana {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *DiaSemana : varchar(15) <<PK, NOT NULL>>
    --
    CHECK CK_PromocionDiaSemana_DiaSemana ([DiaSemana]='Domingo' OR [DiaSemana]='Sabado' OR\n[DiaSemana]='Viernes' OR [DiaSemana]='Jueves' OR [DiaSemana]='Miercoles' OR [DiaSemana]='Martes' OR\n[DiaSemana]='Lunes')
  }
  entity "dbo.PromocionEntidadFinanciera" as T_PromocionEntidadFinanciera {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *EntidadFinancieraId : int <<PK, FK, NOT NULL>>
  }
  entity "dbo.PromocionMedioPago" as T_PromocionMedioPago {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *MedioPagoId : int <<PK, FK, NOT NULL>>
  }
  entity "dbo.PromocionProducto" as T_PromocionProducto {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *ProductoId : int <<PK, FK, NOT NULL>>
    Excluido : bit <<NOT NULL>>
  }
  entity "dbo.PromocionRubroComercio" as T_PromocionRubroComercio {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *RubroComercioId : int <<PK, FK, NOT NULL>>
  }
  entity "dbo.PromocionSegmento" as T_PromocionSegmento {
    *PromocionId : int <<PK, FK, NOT NULL>>
    *Segmento : varchar(50) <<PK, NOT NULL>>
  }
  entity "dbo.RubroComercio" as T_RubroComercio {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    --
    UQ UQ_RubroComercio_Nombre (Nombre)
  }
}
package "Finanzas personales" as D2 {
  entity "dbo.Categoria" as T_Categoria {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    UsuarioId : int <<FK, NULL>>
    --
    UQ UQ_Categoria_Nombre_Global (Nombre) WHERE ([UsuarioId] IS NULL)
    UQ UQ_Categoria_Nombre_Usuario (UsuarioId, Nombre) WHERE ([UsuarioId] IS NOT NULL)
  }
  entity "dbo.CuentaFinanciera" as T_CuentaFinanciera {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    EntidadFinancieraId : int <<FK, NOT NULL>>
    Alias : varchar(100) <<NOT NULL>>
    Tipo : varchar(30) <<NOT NULL>>
    CredencialesCifradas : varchar(500) <<NULL>>
    --
    CHECK CK_CuentaFinanciera_Tipo ([Tipo]='CajaAhorro' OR [Tipo]='CuentaCorriente' OR\n[Tipo]='BilleteraDigital')
  }
  entity "dbo.CuentaFinancieraMedioPagoEntidad" as T_CuentaFinancieraMedioPagoEntidad {
    *CuentaFinancieraId : int <<PK, FK, NOT NULL>>
