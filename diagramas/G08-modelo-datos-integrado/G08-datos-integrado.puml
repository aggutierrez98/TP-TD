package "Monedas y tasas" as D4 {
  entity "dbo.ActualizacionTasaDetalle" as T_ActualizacionTasaDetalle {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    EjecucionId : int <<FK, NOT NULL>>
    MonedaBaseId : int <<FK, NOT NULL>>
    MonedaConversionId : int <<FK, NOT NULL>>
    ValorAnterior : decimal(18,6) <<NOT NULL>>
    ValorNuevo : decimal(18,6) <<NULL>>
    Estado : varchar(30) <<NOT NULL>>
    --
    CHECK CK_ActualizacionTasaDetalle_Estado ([Estado]='SaltadoSinDato' OR [Estado]='SaltadoManual' OR\n[Estado]='Actualizado')
  }
  entity "dbo.EjecucionActualizacionTasas" as T_EjecucionActualizacionTasas {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    FechaInicio : datetime <<NOT NULL>>
    Origen : varchar(20) <<NOT NULL>>
    Resultado : varchar(20) <<NOT NULL>>
    ConsumioRequest : bit <<NOT NULL>>
    Mensaje : nvarchar(500) <<NULL>>
    --
    CHECK CK_EjecucionActualizacionTasas_Origen ([Origen]='Manual' OR [Origen]='Programada')
    CHECK CK_EjecucionActualizacionTasas_Resultado ([Resultado]='Omitida' OR [Resultado]='Fallida' OR\n[Resultado]='Exitosa')
  }
  entity "dbo.Moneda" as T_Moneda {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    Codigo : varchar(10) <<NOT NULL>>
    Nombre : varchar(100) <<NOT NULL>>
    --
    UQ UQ_Moneda_Codigo (Codigo)
  }
  entity "dbo.TasaConversion" as T_TasaConversion {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    MonedaBaseId : int <<FK, NOT NULL>>
    MonedaConversionId : int <<FK, NOT NULL>>
    CalculoConversion : decimal(18,6) <<NOT NULL>>
    FechaActualizacion : datetime <<NOT NULL>>
    EsManual : bit <<NOT NULL>>
    ProtegidaPorUsuarioId : int <<FK, NULL>>
    FechaProteccion : datetime <<NULL>>
    --
    UQ UQ_TasaConversion_Par (MonedaBaseId, MonedaConversionId)
    CHECK CK_TasaConversion_Calculo ([CalculoConversion]>(0))
    CHECK CK_TasaConversion_MonedasDistintas ([MonedaBaseId]<>[MonedaConversionId])
  }
}
package "Notificaciones" as D5 {
  entity "dbo.Notificacion" as T_Notificacion {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    TipoNotificacion : varchar(30) <<NOT NULL>>
    Mensaje : nvarchar(max) <<NOT NULL>>
    Fecha : datetime <<NOT NULL>>
    Leida : bit <<NOT NULL>>
    ItemListaId : int <<FK, NULL>>
    PromocionId : int <<FK, NULL>>
    FechaVencimiento : date <<NULL>>
    TipoAutomatico : varchar(20) <<NULL>>
    FechaJornada : date <<NULL>>
    ClaveEjemplo : varchar(60) <<NULL>>
    --
    UQ UX_Notificacion_Automatica (UsuarioId, TipoAutomatico, FechaJornada) WHERE ([TipoAutomatico] IS\nNOT NULL)
    UQ UX_Notificacion_ClaveEjemplo (UsuarioId, ClaveEjemplo) WHERE ([ClaveEjemplo] IS NOT NULL)
    CHECK CK_Notificacion_Automatica ([TipoAutomatico] IS NULL AND [FechaJornada] IS NULL OR\n[TipoAutomatico] IS NOT NULL AND [FechaJornada] IS NOT NULL AND [ClaveEjemplo] IS NULL AND\n([TipoAutomatico]='Compras' AND [TipoNotificacion]='RecordatorioCompra' OR\n[TipoAutomatico]='Inversiones' AND [TipoNotificacion]='RecordatorioInversion' OR\n[TipoAutomatico]='Movimientos' AND [TipoNotificacion]='Notificacion'))
    CHECK CK_Notificacion_ClaveEjemplo ([ClaveEjemplo] IS NULL OR len([ClaveEjemplo])>(0))
    CHECK CK_Notificacion_RecordatorioCompra_Campos ([TipoNotificacion]<>'RecordatorioCompra' OR\n[ItemListaId] IS NOT NULL AND [FechaVencimiento] IS NOT NULL OR\nisnull([TipoAutomatico],'')='Compras' OR isnull([ClaveEjemplo],'')='Demo.Compras')
    CHECK CK_Notificacion_Tipo ([TipoNotificacion]='RecordatorioInversion' OR\n[TipoNotificacion]='RecordatorioCompra' OR [TipoNotificacion]='Notificacion')
  }
}
package "Perfil inversor" as D6 {
  entity "dbo.PerfilInversor" as T_PerfilInversor {
    *Id : int <<PK, IDENTITY, NOT NULL>>
    UsuarioId : int <<FK, NOT NULL>>
    VersionCuestionario : int <<NOT NULL>>
    FechaEvaluacionUtc : datetime2(7) <<NOT NULL>>
    Capacidad : decimal(7,4) <<NOT NULL>>
    Tolerancia : decimal(7,4) <<NOT NULL>>
    Puntaje : decimal(7,4) <<NOT NULL>>
    NivelRiesgo : int <<NOT NULL>>
    MotivosLimite : nvarchar(max) <<NOT NULL>>
    --
    UQ UQ_PerfilInversor_Usuario (UsuarioId)
    CHECK CK_PerfilInversor_Capacidad ([Capacidad]>=(0) AND [Capacidad]<=(100))
    CHECK CK_PerfilInversor_Nivel ([NivelRiesgo]=(2) OR [NivelRiesgo]=(1) OR [NivelRiesgo]=(0))
    CHECK CK_PerfilInversor_Puntaje ([Puntaje]>=(0) AND [Puntaje]<=(100))
    CHECK CK_PerfilInversor_Tolerancia ([Tolerancia]>=(0) AND [Tolerancia]<=(100))
    CHECK CK_PerfilInversor_Version ([VersionCuestionario]>(0))
  }
  entity "dbo.PerfilInversorRespuesta" as T_PerfilInversorRespuesta {
    *PerfilInversorId : int <<PK, FK, NOT NULL>>
    *PreguntaId : int <<PK, NOT NULL>>
    OpcionId : char(1) <<NOT NULL>>
    --
    CHECK CK_PerfilInversorRespuesta_Opcion ([OpcionId]='D' OR [OpcionId]='C' OR [OpcionId]='B' OR\n[OpcionId]='A')
    CHECK CK_PerfilInversorRespuesta_Pregunta ([PreguntaId]>=(1) AND [PreguntaId]<=(10))
    ON DELETE CASCADE (PerfilInversorId)
  }
}
package "Ubicacion y zonas" as D7 {
