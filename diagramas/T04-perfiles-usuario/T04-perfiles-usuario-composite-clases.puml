@startuml
title T04 - Perfiles de usuario - Composite por capas

skinparam classAttributeIconSize 0
hide empty members

package "ABSTRACCIONES" {
  interface IPermiso {
    +Id : int
    +Nombre : string
    +EsGrupo : bool
    +Hijos : IList<IPermiso>
    +Agregar(permiso)
    +Quitar(permiso)
    +Contiene(id)
    +ObtenerPermisosHoja()
  }

  interface IUsuarioAutenticado {
    +Id : int
    +Username : string
  }

  interface ISesion {
    +IniciarSesion(usuario)
    +CerrarSesion()
    +GetUsuarioActual()
    +GetUsuarioActualId()
    +GetUsuarioActualNombre()
    +ActualizarUsuarioActualNombre(username)
    +HaySesionActiva()
  }
}

package "BE" {
  class Usuario {
    +Id : int
    +Username : string
    +PasswordHash : string
    +Permisos : IList<IPermiso>
  }
}

package "SERVICIOS" {
  abstract class PermisoNodo {
    +Id : int
    +Nombre : string
    +Hijos : IList<IPermiso>
    +HijosNodos : IList<PermisoNodo>
  }

  class PermisoSimple
  class GrupoPermiso
  class PermisoRelacion {
    +GrupoId : int
    +PermisoId : int
  }

  class PermisoService
  class AutorizacionService {
    +ActualizarPermisosUsuarioActual(permisos)
    +Limpiar()
    +TienePermiso(nombrePermiso)
    +ObtenerPermisosEfectivos()
  }

  class Sesion {
    -_usuarioActual : IUsuarioAutenticado
  }
}

package "DAL" {
  class PermisoDAL
  class UsuarioPermisoDAL
}

package "BLL" {
  class PermisoBLL
  class UsuarioBLL
}

package "UI" {
  class FormGestionPermisos
  class FormGestionUsuarios
}

IPermiso <|.. PermisoNodo
PermisoNodo <|-- PermisoSimple
PermisoNodo <|-- GrupoPermiso
IUsuarioAutenticado <|.. Usuario
ISesion <|.. Sesion

Usuario --> IPermiso : permisos de negocio
Sesion --> IUsuarioAutenticado
AutorizacionService --> PermisoService
PermisoBLL --> PermisoDAL
PermisoBLL --> UsuarioPermisoDAL
PermisoBLL --> PermisoService
PermisoBLL --> AutorizacionService : refresca runtime
UsuarioBLL --> Sesion : autenticacion
UsuarioBLL --> PermisoBLL
UsuarioBLL --> AutorizacionService : carga permisos activos
FormGestionPermisos --> PermisoBLL
FormGestionUsuarios --> PermisoBLL

note right of Sesion
Sesion solo mantiene identidad
del usuario autenticado.
No resuelve permisos.
end note

note right of AutorizacionService
Servicio runtime desacoplado
para autorizacion del usuario activo.
end note

note bottom of Usuario
BE conoce ABSTRACCIONES.
BLL y UI consumen SERVICIOS
sin depender directamente de ABSTRACCIONES.
end note

@enduml
