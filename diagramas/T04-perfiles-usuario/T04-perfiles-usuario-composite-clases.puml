@startuml
title T04 - Gestion de Perfiles de Usuario - Composite - Clases

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "ABSTRACCIONES" {
  interface IPermiso {
    +Id : int
    +Nombre : string
    +EsGrupo : bool
    +Hijos : IList<IPermiso>
    +Agregar(permiso : IPermiso) : void
    +Quitar(permiso : IPermiso) : void
    +Contiene(id : int) : bool
    +ObtenerPermisosHoja() : IList<IPermiso>
  }
}

package "BE" {
  class Usuario {
    +Id : int
    +Username : string
    +PasswordHash : string
    +Activo : bool
    +Permisos : IList<IPermiso>
  }
}

package "SERVICIOS" {
  abstract class PermisoNodo {
    +Id : int
    +Nombre : string
    +Ruta : string
    +EsGrupo : bool
    +Hijos : IList<IPermiso>
    +HijosNodos : IList<PermisoNodo>
    +Agregar(permiso : IPermiso) : void
    +Quitar(permiso : IPermiso) : void
    +AgregarHijo(permiso : PermisoNodo) : void
    +QuitarHijo(permiso : PermisoNodo) : void
    +Contiene(id : int) : bool
    +ObtenerPermisosHoja() : IList<IPermiso>
    +ObtenerClave() : string
  }

  class PermisoSimple
  class PermisoGrupo

  class PermisoRelacion {
    +GrupoId : int
    +PermisoId : int
  }

  class PermisoService {
    +ConstruirArbol(nodos : IList<PermisoNodo>, relaciones : IList<PermisoRelacion>) : IList<PermisoNodo>
    +ObtenerPermisosEfectivos(permisosAsignados : IEnumerable<IPermiso>) : IList<IPermiso>
    +ObtenerPermisosReconocidos(permisosAsignados : IEnumerable<IPermiso>) : IList<IPermiso>
    +ValidarNombre(nombre : string) : void
    +ValidarNombresUnicos(raices : IEnumerable<PermisoNodo>) : void
    +ValidarGruposNoVacios(nodos : IEnumerable<PermisoNodo>) : void
    +ValidarSinCiclos(raices : IEnumerable<PermisoNodo>) : void
    +Aplanar(raices : IEnumerable<PermisoNodo>) : IList<PermisoNodo>
    +ObtenerRelaciones(raices : IEnumerable<PermisoNodo>) : IList<PermisoRelacion>
  }

  class AutorizacionService <<singleton>> {
    +GetInstance() : AutorizacionService
    +ActualizarPermisosUsuarioActual(permisos : IList<PermisoNodo>) : void
    +Limpiar() : void
    +TienePermiso(rutaPermiso : string) : bool
    +ObtenerPermisosEfectivos() : IList<IPermiso>
  }

  class BitacoraService <<singleton>> {
    +GetInstance() : BitacoraService
    +RegistrarOperacion(actividad : string, informacion : string, origen : string, contextoPersistencia : object = null) : void
  }

  class Sesion <<singleton>> {
    +GetInstance() : Sesion
    +GetUsuarioActualId() : int?
  }
}

package "DAL" {
  class PermisoDAL {
    +ObtenerNodos() : List<PermisoNodo>
    +ObtenerRelaciones() : List<PermisoRelacion>
    +InsertarPermiso(nombre : string) : int
    +ActualizarNombre(id : int, nombre : string) : bool
    +ReemplazarRelaciones(relaciones : List<PermisoRelacion>) : bool
    +EliminarPermisos(idsPermiso : List<int>) : bool
  }

  class UsuarioPermisoDAL {
    +ObtenerPermisoIdsPorUsuario(usuarioId : int, accesoDatos : AccesoDatos = null) : List<int>
    +ReemplazarPermisosUsuario(usuarioId : int, permisosId : List<int>, accesoDatos : AccesoDatos = null) : bool
  }

  class UsuarioDAL {
    +ObtenerPorId(id : int, accesoDatos : AccesoDatos = null) : Usuario
  }

  class AccesoDatos
  {
    +BeginTransactionScope() : void
    +CommitTransactionScope() : void
    +RollbackTransactionScope() : void
  }
}

package "BLL" {
  class PermisoBLL {
    +ObtenerCatalogo() : List<PermisoNodo>
    +GuardarCatalogo(raices : List<PermisoNodo>) : void
    +ObtenerPermisoIdsDeUsuario(usuarioId : int) : List<int>
    +GuardarPermisosUsuario(usuarioId : int, permisosId : List<int>) : void
    +ObtenerPermisosDirectosUsuario(usuarioId : int) : List<PermisoNodo>
    +CargarPermisosEnUsuario(usuario : Usuario) : void
  }

  class UsuarioBLL {
    +Login(username : string, passwordRaw : string) : Usuario
  }

  class UsuarioEstadoBLL {
    +GuardarVersionActual(usuarioId : int, accion : string, observaciones : string, accesoDatos : AccesoDatos = null) : int
  }
}

package "UI" {
  class FormGestionPermisos
  class FormGestionUsuarios
}

IPermiso <|.. PermisoNodo
PermisoNodo <|-- PermisoSimple
PermisoNodo <|-- PermisoGrupo
Usuario --> IPermiso : Permisos

PermisoBLL --> PermisoDAL
PermisoBLL --> UsuarioPermisoDAL
PermisoBLL --> UsuarioDAL
PermisoBLL --> UsuarioEstadoBLL
PermisoBLL --> PermisoService
PermisoBLL --> AutorizacionService
PermisoBLL --> BitacoraService
PermisoBLL --> Sesion
UsuarioBLL --> PermisoBLL
AutorizacionService --> PermisoService

FormGestionPermisos --> PermisoBLL
FormGestionUsuarios --> PermisoBLL

@enduml
