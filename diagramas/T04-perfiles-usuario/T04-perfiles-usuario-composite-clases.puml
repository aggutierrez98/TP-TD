@startuml
title T04 - Gestion de Perfiles de Usuario - Composite - Clases

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "ABSTRACCIONES" {
  interface IPermiso {
    +Id : int
    +Nombre : string
    +EsGrupo : bool
    +Hijos : IList<IPermiso>
    +Agregar(permiso : IPermiso) : void
    +Quitar(permiso : IPermiso) : void
    +Contiene(id : int) : bool
    +ObtenerPermisosHoja() : IList<IPermiso>
  }
  interface IAutorizacion {
    +ActualizarPermisosUsuarioActual(permisos : IEnumerable<IPermiso>) : void
    +Limpiar() : void
    +TienePermiso(rutaPermiso : string) : bool
  }
}

package "SERVICIOS" {
  class PermisoSimple {
    +EsGrupo : bool = false
    +ObtenerPermisosHoja() : IList<IPermiso>
  }
  class PermisoGrupo {
    +EsGrupo : bool = true
    +Agregar(permiso : IPermiso) : void
    +Quitar(permiso : IPermiso) : void
    +Contiene(id : int) : bool
    +ObtenerPermisosHoja() : IList<IPermiso>
  }
  class PermisoService {
    +ConstruirArbol(nodos : IList<IPermiso>, relaciones : IList<Tuple<int,int>>) : List<IPermiso>
    +ObtenerPermisosEfectivos(permisosAsignados : IEnumerable<IPermiso>) : List<IPermiso>
    +FiltrarGrupos(nodos : IEnumerable<IPermiso>) : List<IPermiso>
    +FiltrarPermisos(nodos : IEnumerable<IPermiso>) : List<IPermiso>
    +Aplanar(raices : IEnumerable<IPermiso>) : List<IPermiso>
    +ObtenerRelaciones(raices : IEnumerable<IPermiso>) : List<Tuple<int,int>>
    +ValidarSinCiclos(raices : IEnumerable<IPermiso>) : void
    +GeneraCiclo(padre : IPermiso, hijo : IPermiso) : bool
    +ValidarGruposNoVacios(nodos : IEnumerable<IPermiso>) : void
    +ValidarNombresUnicos(raices : IEnumerable<IPermiso>) : void
    +ValidarNombre(nombre : string) : void
    +NormalizarNombre(nombre : string) : string
  }
  class AutorizacionService <<singleton>> {
    +GetInstance() : AutorizacionService
    +TienePermiso(rutaPermiso : string) : bool
  }
}

package "BLL" {
  class PermisoBLL {
    +ObtenerCatalogo() : List<IPermiso>
    +GuardarCatalogo(raices : List<IPermiso>) : void
    +ObtenerPermisoIdsDeUsuario(usuarioId : int) : List<int>
    +GuardarPermisosUsuario(usuarioId : int, permisosId : List<int>) : void
    +ObtenerPermisosDirectosUsuario(usuarioId : int) : List<IPermiso>
  }
}

package "REPOSITORIO" {
  interface IUnidadDeTrabajo {
    +Permisos : IPermisoRepositorio
    +UsuarioPermisos : IUsuarioPermisoRepositorio
    +Save() : void
  }
  interface IPermisoRepositorio {
    +ObtenerNodos() : List<IPermiso>
    +ObtenerRelaciones() : List<Tuple<int,int>>
    +Guardar(permiso : IPermiso) : int
    +ReemplazarRelaciones(relaciones : List<Tuple<int,int>>) : bool
    +EliminarPermisos(idsPermiso : List<int>) : bool
    +ObtenerIdPorNombre(nombre : string) : int
  }
  interface IUsuarioPermisoRepositorio {
    +ObtenerPermisoIdsPorUsuario(usuarioId : int) : List<int>
    +ReemplazarPermisosUsuario(usuarioId : int, permisosId : List<int>) : bool
  }
  class PermisoRepositorio
  class UsuarioPermisoRepositorio
}

package "DAL" {
  class PermisoDAL
  class UsuarioPermisoDAL
}

package "UI" {
  class FormGestionPermisos
  class FormGestionUsuarios {
    +ValidarPermiso(permiso : string) : bool
    +AplicarPermisosPantalla() : void
  }
}

' ---- Composite ----
IPermiso <|.. PermisoSimple
IPermiso <|.. PermisoGrupo
PermisoGrupo o--> "*" IPermiso : Hijos

' ---- Servicio de dominio + autorizacion ----
PermisoService ..> IPermiso
AutorizacionService ..|> IAutorizacion
AutorizacionService --> PermisoService

' ---- BLL usa contratos (DIP) ----
PermisoBLL --> IPermisoRepositorio
PermisoBLL --> IUsuarioPermisoRepositorio
PermisoBLL --> PermisoService
PermisoBLL --> IAutorizacion
PermisoBLL ..> IUnidadDeTrabajo

IUnidadDeTrabajo --> IPermisoRepositorio : Permisos
IUnidadDeTrabajo --> IUsuarioPermisoRepositorio : UsuarioPermisos
PermisoRepositorio ..|> IPermisoRepositorio
UsuarioPermisoRepositorio ..|> IUsuarioPermisoRepositorio
PermisoRepositorio --> PermisoDAL
UsuarioPermisoRepositorio --> UsuarioPermisoDAL

' ---- UI ----
FormGestionPermisos --> PermisoBLL
FormGestionUsuarios --> PermisoBLL
FormGestionUsuarios --> IAutorizacion

@enduml
