@startuml
title T04 - Gestion de Perfiles de Usuario - DER

hide methods
hide stereotypes
skinparam classAttributeIconSize 0

entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Username : varchar(50) <<UQ, NOT NULL>>
  PasswordHash : varchar(max) <<NOT NULL>>
  Activo : bit <<NOT NULL>>
}

entity "Permiso" as Permiso {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Nombre : varchar(100) <<UQ, NOT NULL>>
  EsGrupo : bit <<NOT NULL>>
}

entity "PermisoCompuesto" as PermisoCompuesto {
  *PermisoPadreId : int <<PK, FK, NOT NULL>>
  *PermisoHijoId : int <<PK, FK, NOT NULL>>
}

entity "UsuarioPermiso" as UsuarioPermiso {
  *UsuarioId : int <<PK, FK, NOT NULL>>
  *PermisoId : int <<PK, FK, NOT NULL>>
}

Permiso ||--o{ PermisoCompuesto : FK_PermisoCompuesto_Padre
Permiso ||--o| PermisoCompuesto : FK_PermisoCompuesto_Hijo
Usuarios ||--o{ UsuarioPermiso : FK_UsuarioPermiso_Usuario
Permiso ||--o{ UsuarioPermiso : FK_UsuarioPermiso_Permiso

@enduml
