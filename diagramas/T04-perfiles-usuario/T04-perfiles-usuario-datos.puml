@startuml
title T04 - Gestion de Perfiles de Usuario - DER

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false

entity "Permiso" as Permiso {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Nombre : varchar(100) <<UQ (UQ_Permiso_Nombre), NOT NULL>>
  EsGrupo : bit <<NOT NULL>>
}

entity "PermisoCompuesto" as PermisoCompuesto {
  *PermisoPadreId : int <<PK, FK -> Permiso.Id, NOT NULL>>
  *PermisoHijoId : int <<PK, FK -> Permiso.Id, NOT NULL>>
}

entity "UsuarioPermiso" as UsuarioPermiso {
  *UsuarioId : int <<PK, FK -> Usuarios.Id, NOT NULL>>
  *PermisoId : int <<PK, FK -> Permiso.Id, NOT NULL>>
}

entity "Usuarios" as Usuarios {
  *Id : int <<PK, IDENTITY, NOT NULL>>
  --
  Username : varchar(50) <<UQ, NOT NULL>>
}

' Composite: un Permiso (grupo) contiene otros Permiso (auto-relacion N:M)
Permiso ||--o{ PermisoCompuesto : padre
Permiso ||--o{ PermisoCompuesto : hijo

' Asignacion de permisos a usuarios (N:M)
Usuarios ||--o{ UsuarioPermiso
Permiso  ||--o{ UsuarioPermiso

note bottom of PermisoCompuesto
  Materializa el patron Composite:
  PermisoPadreId (grupo) -> PermisoHijoId (grupo o patente).
  PK compuesta (PermisoPadreId, PermisoHijoId).
end note

@enduml
