@startuml
title T04 - Gestion de Perfiles de Usuario - Secuencia

actor Administrador
participant "FormGestionUsuarios" as FormGestionUsuarios
participant "PermisoBLL" as PermisoBLL
participant "AccesoDatos" as AccesoDatos
participant "UsuarioDAL" as UsuarioDAL
participant "UsuarioPermisoDAL" as UsuarioPermisoDAL
participant "UsuarioEstadoBLL" as UsuarioEstadoBLL
participant "BitacoraService" as BitacoraService
participant "Sesion" as Sesion
participant "AutorizacionService" as AutorizacionService
participant "PermisoService" as PermisoService

Administrador -> FormGestionUsuarios : btnGuardarPermisosUsuario_Click()
FormGestionUsuarios -> PermisoBLL : GuardarPermisosUsuario(_idSeleccionado, permisosSeleccionados)
PermisoBLL -> AccesoDatos : BeginTransactionScope()
PermisoBLL -> UsuarioDAL : ObtenerPorId(usuarioId, accesoDatos)
UsuarioDAL --> PermisoBLL : usuario
PermisoBLL -> UsuarioPermisoDAL : ReemplazarPermisosUsuario(usuarioId, permisosId, accesoDatos)
PermisoBLL -> UsuarioEstadoBLL : GuardarVersionActual(usuarioId, "FormUserHistory.Value.Action.PermissionsUpdate", "FormUserHistory.Value.Obs.PermissionsUpdate", accesoDatos)
PermisoBLL -> BitacoraService : RegistrarOperacion("FormAuditLog.Value.Activity.UserPermissionsUpdate", "FormAuditLog.Value.Info.UserPermissionsUpdate", "PermisoBLL", accesoDatos)
PermisoBLL -> AccesoDatos : CommitTransactionScope()
PermisoBLL -> Sesion : GetUsuarioActualId()

alt usuario modificado es sesion actual
  PermisoBLL -> PermisoBLL : ObtenerPermisosDirectosUsuario(usuarioId)
  PermisoBLL --> PermisoBLL : permisosDirectos
  PermisoBLL -> AutorizacionService : ActualizarPermisosUsuarioActual(permisosDirectos)
end

PermisoBLL --> FormGestionUsuarios : void

@enduml
