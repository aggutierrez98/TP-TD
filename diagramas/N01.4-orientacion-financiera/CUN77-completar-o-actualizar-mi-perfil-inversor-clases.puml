@startuml
' Fuente: diagramas/NEG18-perfil-inversor/NEG18-perfil-inversor-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN77 Completar o actualizar mi perfil inversor — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormPerfilInversor {
    -btnSiguiente_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class PerfilInversorBLL {
    +EvaluarCuestionario(version: int, respuestas: IEnumerable<RespuestaPerfilInversor>):\nPerfilInversor
    +GuardarMiPerfil(version: int, respuestas: IEnumerable<RespuestaPerfilInversor>):\nPerfilInversor
    +GuardarPostRegistro(continuacion: ContinuacionPerfilInversor, version: int,\nrespuestas: IEnumerable<RespuestaPerfilInversor>): PerfilInversor
  }
  class CalculadorPerfilInversor {
    ~Evaluar(version: int, respuestas: IEnumerable<RespuestaPerfilInversor>):\nPerfilInversor
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
PerfilInversorBLL -[hidden]right-> CalculadorPerfilInversor
PerfilInversorBLL -[hidden]down-> SesionUsuarioExtensiones
SesionUsuarioExtensiones -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IPerfilInversorRepositorio {
    +Guardar(perfil: PerfilInversor): void
  }
  class PerfilInversorRepositorio {
    +Guardar(perfil: PerfilInversor): void
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IPerfilInversorRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> PerfilInversorRepositorio
PerfilInversorRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class PerfilInversorDAL {
    +Guardar(perfil: PerfilInversor, acceso: AccesoDatosSqlServer): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "SERVICIOS" as L_SERVICIOS {
  class "Sesion" as ISesion <<ISesion>> {
    +HaySesionActiva(): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  enum NivelRiesgoInversor {
    Bajo
    Moderado
    Alto
  }
  class PerfilInversor {
    +Id: int
    +Usuario: Usuario
    +VersionCuestionario: int
    +FechaEvaluacionUtc: DateTime
    +Capacidad: decimal
    +Tolerancia: decimal
    +Puntaje: decimal
    +NivelRiesgo: NivelRiesgoInversor
    +MotivosLimite: List<string>
    +Respuestas: List<RespuestaPerfilInversor>
  }
  class PreguntaPerfilInversor {
    +Id: int
  }
  class RespuestaPerfilInversor {
    +Pregunta: PreguntaPerfilInversor
    +OpcionId: string
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
NivelRiesgoInversor -[hidden]right-> PerfilInversor
NivelRiesgoInversor -[hidden]down-> PreguntaPerfilInversor
PreguntaPerfilInversor -[hidden]right-> RespuestaPerfilInversor
PreguntaPerfilInversor -[hidden]down-> Usuario
FormPerfilInversor ..> PerfilInversorBLL : usa
PerfilInversorRepositorio ..> PerfilInversorDAL : usa
PerfilInversorBLL ..> CalculadorPerfilInversor : usa
PerfilInversorBLL ..> IBitacoraBLL : usa
PerfilInversorBLL ..> IPerfilInversorRepositorio : usa
PerfilInversorBLL ..> ISesion : usa
PerfilInversorBLL ..> IUnidadDeTrabajo : usa
PerfilInversorBLL ..> IUnidadDeTrabajoFactory : usa
PerfilInversorBLL ..> SesionUsuarioExtensiones : usa
PerfilInversorRepositorio ..|> IPerfilInversorRepositorio
PerfilInversorBLL ..> PerfilInversor : datos
PerfilInversor --> Usuario : Usuario
PerfilInversor --> NivelRiesgoInversor : NivelRiesgo
PerfilInversor --> "*" RespuestaPerfilInversor : Respuestas
RespuestaPerfilInversor --> PreguntaPerfilInversor : Pregunta
' ABSTRACCIONES/ISesion.cs:15 ISesion.HaySesionActiva
' BLL/CalculadorPerfilInversor.cs:16 CalculadorPerfilInversor.Evaluar
' BLL/ContratosInternosBLL.cs:31 IBitacoraBLL.RegistrarOperacionInterno
' BLL/PerfilInversorBLL.cs:22 PerfilInversorBLL.EvaluarCuestionario
' BLL/PerfilInversorBLL.cs:47 PerfilInversorBLL.GuardarMiPerfil
' BLL/PerfilInversorBLL.cs:53 PerfilInversorBLL.GuardarPostRegistro
' BLL/SesionUsuarioExtensiones.cs:12 SesionUsuarioExtensiones.ObtenerUsuarioActual
' DAL/PerfilInversorDAL.cs:44 PerfilInversorDAL.Guardar
' REPOSITORIO/IPerfilInversorRepositorio.cs:8 IPerfilInversorRepositorio.Guardar
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/PerfilInversorRepositorio.cs:13 PerfilInversorRepositorio.Guardar
' UI/FormPerfilInversor.cs:259 FormPerfilInversor.btnSiguiente_Click
@enduml
