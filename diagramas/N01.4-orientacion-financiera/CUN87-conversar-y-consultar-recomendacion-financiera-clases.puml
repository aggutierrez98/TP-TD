package "BE" as L_BE {
  class ChatbotFinanciero {
    +Id: int
    +Nombre: string
  }
  class ConsultaChatbot {
    +Id: int
    +ChatbotFinanciero: ChatbotFinanciero
    +Usuario: Usuario
    +Pregunta: string
    +Respuesta: string
    +Fecha: DateTime
    +EsPregunta: bool
  }
  enum NivelRiesgoInversor {
    Bajo
    Moderado
    Alto
  }
  class PerfilInversor {
    +Id: int
    +Usuario: Usuario
    +VersionCuestionario: int
    +FechaEvaluacionUtc: DateTime
    +Capacidad: decimal
    +Tolerancia: decimal
    +Puntaje: decimal
    +NivelRiesgo: NivelRiesgoInversor
    +MotivosLimite: List<string>
    +Respuestas: List<RespuestaPerfilInversor>
  }
  class RespuestaPerfilInversor {
    +Pregunta: PreguntaPerfilInversor
    +OpcionId: string
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
