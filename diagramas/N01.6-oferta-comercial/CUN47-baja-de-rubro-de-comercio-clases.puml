  class "PromocionRubroComercioRepositorio" as IPromocionRubroComercioRepositorio <<IPromocionRubroComercioRepositorio>> {
    +ContarPorRubroComercio(rubroComercio: RubroComercio): int
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
