@startuml
' Fuente: diagramas/NEG15-promociones/NEG15-promociones-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN67 Baja de promoción — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionPromociones {
    -btnEliminarPromocion_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class PromocionBLL {
    +Eliminar(recibida: Promocion): bool
    +Buscar(texto: string, recibido: Comercio): List<Promocion>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
  class AlcancePromocion {
    +FiltrarPorComercio(promociones: IEnumerable<Promocion>, comercio: Comercio):\nList<Promocion>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
PromocionBLL -[hidden]right-> IBitacoraBLL
PromocionBLL -[hidden]down-> AlcancePromocion
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IPromocionRepositorio {
    +ObtenerPorId(id: int): Promocion
    +ReemplazarDiasDePromocion(promocion: Promocion, dias: List<DiaSemana>): bool
    +Eliminar(promocion: Promocion): bool
    +ObtenerTodas(): List<Promocion>
  }
  class PromocionRepositorio {
    +ObtenerPorId(id: int): Promocion
    +ReemplazarDiasDePromocion(promocion: Promocion, dias: List<DiaSemana>): bool
    +Eliminar(promocion: Promocion): bool
    +ObtenerTodas(): List<Promocion>
  }
  class "NotificacionRepositorio" as INotificacionRepositorio <<INotificacionRepositorio>> {
    +ContarPorPromocion(promocion: Promocion): int
  }
  class "PromocionComercioRepositorio" as IPromocionComercioRepositorio <<IPromocionComercioRepositorio>> {
    +ReemplazarComerciosDePromocion(promocion: Promocion, comercios: List<Comercio>): bool
  }
  class "PromocionRubroComercioRepositorio" as IPromocionRubroComercioRepositorio <<IPromocionRubroComercioRepositorio>> {
    +ReemplazarRubrosComercioDePromocion(promocion: Promocion, rubrosComercio:\nList<RubroComercio>): bool
  }
  class "PromocionEntidadFinancieraRepositorio" as IPromocionEntidadFinancieraRepositorio <<IPromocionEntidadFinancieraRepositorio>> {
    +ReemplazarEntidadesFinancierasDePromocion(promocion: Promocion, entidadesFinancieras:\nList<EntidadFinanciera>): bool
  }
  class "PromocionMedioPagoRepositorio" as IPromocionMedioPagoRepositorio <<IPromocionMedioPagoRepositorio>> {
    +ReemplazarMediosPagoDePromocion(promocion: Promocion, mediosPago: List<MedioPago>):\nbool
  }
  class "PromocionSegmentoRepositorio" as IPromocionSegmentoRepositorio <<IPromocionSegmentoRepositorio>> {
    +ReemplazarSegmentosDePromocion(promocion: Promocion, segmentos: List<string>): bool
  }
  class "PromocionProductoRepositorio" as IPromocionProductoRepositorio <<IPromocionProductoRepositorio>> {
    +ReemplazarProductosDePromocion(promocion: Promocion, incluidos: List<Producto>,\nexcluidos: List<Producto>): bool
  }
  class "PromocionCategoriaProductoRepositorio" as IPromocionCategoriaProductoRepositorio <<IPromocionCategoriaProductoRepositorio>> {
    +ReemplazarCategoriasProductoDePromocion(promocion: Promocion, incluidos:\nList<CategoriaProducto>, excluidos: List<CategoriaProducto>): bool
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
  class "ComercioRepositorio" as IComercioRepositorio <<IComercioRepositorio>> {
    +ObtenerPorId(id: int): Comercio
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IPromocionRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> PromocionRepositorio
PromocionRepositorio -[hidden]right-> INotificacionRepositorio
PromocionRepositorio -[hidden]down-> IPromocionComercioRepositorio
IPromocionComercioRepositorio -[hidden]right-> IPromocionRubroComercioRepositorio
IPromocionComercioRepositorio -[hidden]down-> IPromocionEntidadFinancieraRepositorio
