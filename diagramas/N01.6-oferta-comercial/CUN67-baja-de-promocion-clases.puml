IPromocionSegmentoRepositorio -[hidden]down-> IPromocionCategoriaProductoRepositorio
IPromocionCategoriaProductoRepositorio -[hidden]right-> IUnidadDeTrabajo
IPromocionCategoriaProductoRepositorio -[hidden]down-> IComercioRepositorio
package "DAL" as L_DAL {
  class PromocionDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): Promocion
    +Eliminar(promocion: Promocion, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerTodas(accesoDatos: AccesoDatosSqlServer): List<Promocion>
  }
  class PromocionDiaSemanaDAL {
    +ReemplazarDiasDePromocion(promocion: Promocion, dias: List<DiaSemana>, accesoDatos:\nAccesoDatosSqlServer): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
PromocionDAL -[hidden]right-> PromocionDiaSemanaDAL
package "BE" as L_BE {
  class CategoriaProducto {
    +Id: int
    +Nombre: string
  }
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  enum DiaSemana {
    Lunes
    Martes
    Miercoles
    Jueves
    Viernes
    Sabado
    Domingo
  }
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class MedioPagoEntidad {
    +Id: int
    +EntidadFinanciera: EntidadFinanciera
    +MedioPago: MedioPago
    +Segmento: string
  }
  class Producto {
    +Id: int
    +CategoriaProducto: CategoriaProducto
    +Nombre: string
  }
  class Promocion {
    +Id: int
    +Descripcion: string
    +Descuento: decimal
    +TopeDescuento: decimal?
    +VigenciaDesde: DateTime
    +VigenciaHasta: DateTime
    +DiasSemana: List<DiaSemana>
    +Comercios: List<Comercio>
    +RubrosComercio: List<RubroComercio>
    +EntidadesFinancieras: List<EntidadFinanciera>
    +MediosPago: List<MedioPago>
    +Segmentos: List<string>
    +ProductosIncluidos: List<Producto>
    +ProductosExcluidos: List<Producto>
    +CategoriasIncluidas: List<CategoriaProducto>
    +CategoriasExcluidas: List<CategoriaProducto>
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
  enum TipoMedioPago {
    TarjetaCredito
    TarjetaDebito
    TarjetaPrepaga
    CuentaBilleteraVirtual
    CuentaDNI
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CategoriaProducto -[hidden]right-> Comercio
CategoriaProducto -[hidden]down-> DiaSemana
DiaSemana -[hidden]right-> EntidadFinanciera
DiaSemana -[hidden]down-> MedioPago
MedioPago -[hidden]right-> MedioPagoEntidad
MedioPago -[hidden]down-> Producto
Producto -[hidden]right-> Promocion
Producto -[hidden]down-> RubroComercio
RubroComercio -[hidden]right-> TipoMedioPago
