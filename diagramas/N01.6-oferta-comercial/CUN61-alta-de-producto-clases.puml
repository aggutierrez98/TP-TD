@startuml
' Fuente: diagramas/NEG14-catalogo-productos/NEG14-catalogo-productos-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN61 Alta de producto — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionProductos {
    -btnAgregarProducto_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class ProductoBLL {
    +Crear(producto: Producto): Producto
    +ObtenerTodos(): List<Producto>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ProductoBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  class "CategoriaProductoRepositorio" as ICategoriaProductoRepositorio <<ICategoriaProductoRepositorio>> {
    +ObtenerPorId(id: int): CategoriaProducto
  }
  interface IProductoRepositorio {
    +InsertarYObtenerId(producto: Producto): int
    +ObtenerTodos(): List<Producto>
  }
  class ProductoRepositorio {
    +InsertarYObtenerId(producto: Producto): int
    +ObtenerTodos(): List<Producto>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> ICategoriaProductoRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> IProductoRepositorio
IProductoRepositorio -[hidden]right-> ProductoRepositorio
IProductoRepositorio -[hidden]down-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class ProductoDAL {
    +InsertarYObtenerId(producto: Producto, accesoDatos: AccesoDatosSqlServer): int
    +ObtenerTodos(accesoDatos: AccesoDatosSqlServer): List<Producto>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class CategoriaProducto {
    +Id: int
    +Nombre: string
  }
  class Producto {
    +Id: int
    +CategoriaProducto: CategoriaProducto
    +Nombre: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CategoriaProducto -[hidden]right-> Producto
FormGestionProductos ..> ProductoBLL : usa
ProductoRepositorio ..> ProductoDAL : usa
