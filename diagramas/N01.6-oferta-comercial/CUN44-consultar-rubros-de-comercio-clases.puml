hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionComercios {
    -CargarRubros(rubroSeleccionadoId: int?): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class RubroComercioBLL {
    +ObtenerTodas(): List<RubroComercio>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "REPOSITORIO" as L_REPOSITORIO {
  interface IRubroComercioRepositorio {
    +ObtenerTodas(): List<RubroComercio>
  }
  class RubroComercioRepositorio {
    +ObtenerTodas(): List<RubroComercio>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IRubroComercioRepositorio -[hidden]right-> RubroComercioRepositorio
package "DAL" as L_DAL {
  class RubroComercioDAL {
    +ObtenerTodas(accesoDatos: AccesoDatosSqlServer): List<RubroComercio>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
FormGestionComercios ..> RubroComercioBLL : usa
