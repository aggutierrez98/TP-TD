' REPOSITORIO/IProductoRepositorio.cs:16 IProductoRepositorio.Eliminar
' REPOSITORIO/IProductoRepositorio.cs:8 IProductoRepositorio.ObtenerPorId
' REPOSITORIO/IPromocionProductoRepositorio.cs:13 IPromocionProductoRepositorio.ContarPorProducto
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
