' REPOSITORIO/ICategoriaProductoRepositorio.cs:16 ICategoriaProductoRepositorio.Eliminar
' REPOSITORIO/ICategoriaProductoRepositorio.cs:8 ICategoriaProductoRepositorio.ObtenerPorId
' REPOSITORIO/IProductoRepositorio.cs:18 IProductoRepositorio.ContarPorCategoria
' REPOSITORIO/IPromocionCategoriaProductoRepositorio.cs:13 IPromocionCategoriaProductoRepositorio.ContarPorCategoriaProducto
