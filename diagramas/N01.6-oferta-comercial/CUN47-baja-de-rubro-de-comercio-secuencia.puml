' REPOSITORIO/IComercioRepositorio.cs:10 IComercioRepositorio.ObtenerPorRubro
' REPOSITORIO/IPromocionRubroComercioRepositorio.cs:12 IPromocionRubroComercioRepositorio.ContarPorRubroComercio
' REPOSITORIO/IRubroComercioRepositorio.cs:10 IRubroComercioRepositorio.ObtenerTodas
' REPOSITORIO/IRubroComercioRepositorio.cs:16 IRubroComercioRepositorio.Eliminar
' REPOSITORIO/IRubroComercioRepositorio.cs:8 IRubroComercioRepositorio.ObtenerPorId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/RubroComercioRepositorio.cs:23 RubroComercioRepositorio.ObtenerPorId
' REPOSITORIO/RubroComercioRepositorio.cs:28 RubroComercioRepositorio.ObtenerTodas
' REPOSITORIO/RubroComercioRepositorio.cs:43 RubroComercioRepositorio.Eliminar
' UI/FormGestionComercios.cs:357 FormGestionComercios.btnEliminarRubro_Click
@enduml
