' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/PromocionRepositorio.cs:34 PromocionRepositorio.ObtenerTodas
' REPOSITORIO/PromocionRepositorio.cs:62 PromocionRepositorio.InsertarYObtenerId
