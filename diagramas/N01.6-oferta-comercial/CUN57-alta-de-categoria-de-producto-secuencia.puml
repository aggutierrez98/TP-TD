' REPOSITORIO/CategoriaProductoRepositorio.cs:28 CategoriaProductoRepositorio.ObtenerTodas
' REPOSITORIO/CategoriaProductoRepositorio.cs:33 CategoriaProductoRepositorio.InsertarYObtenerId
' REPOSITORIO/ICategoriaProductoRepositorio.cs:10 ICategoriaProductoRepositorio.ObtenerTodas
' REPOSITORIO/ICategoriaProductoRepositorio.cs:12 ICategoriaProductoRepositorio.InsertarYObtenerId
