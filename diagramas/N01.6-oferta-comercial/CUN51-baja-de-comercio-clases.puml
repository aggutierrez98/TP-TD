@startuml
' Fuente: diagramas/NEG11-comercios/NEG11-comercios-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN51 Baja de comercio — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionComercios {
    -btnEliminarComercio_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class ComercioBLL {
    +Eliminar(comercio: Comercio): bool
    +ObtenerTodos(): List<Comercio>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ComercioBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IComercioRepositorio {
    +ObtenerPorId(id: int): Comercio
    +Eliminar(comercio: Comercio): bool
    +ObtenerTodos(): List<Comercio>
  }
  class ComercioRepositorio {
    +ObtenerPorId(id: int): Comercio
    +Eliminar(comercio: Comercio): bool
    +ObtenerTodos(): List<Comercio>
  }
  class "ComercioProductoRepositorio" as IComercioProductoRepositorio <<IComercioProductoRepositorio>> {
    +ObtenerPorComercio(comercio: Comercio): List<ComercioProducto>
  }
  class "MovimientoRepositorio" as IMovimientoRepositorio <<IMovimientoRepositorio>> {
    +ContarPorComercio(comercio: Comercio): int
  }
  class "PromocionComercioRepositorio" as IPromocionComercioRepositorio <<IPromocionComercioRepositorio>> {
    +ObtenerPromocionesPorComercio(comercio: Comercio): List<Promocion>
  }
  class "ComercioReglaCategorizacionRepositorio" as IComercioReglaCategorizacionRepositorio <<IComercioReglaCategorizacionRepositorio>> {
    +ContarPorComercio(comercio: Comercio): int
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IComercioRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> ComercioRepositorio
ComercioRepositorio -[hidden]right-> IComercioProductoRepositorio
ComercioRepositorio -[hidden]down-> IMovimientoRepositorio
IMovimientoRepositorio -[hidden]right-> IPromocionComercioRepositorio
IMovimientoRepositorio -[hidden]down-> IComercioReglaCategorizacionRepositorio
IComercioReglaCategorizacionRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class ComercioDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): Comercio
    +Eliminar(comercio: Comercio, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerTodos(accesoDatos: AccesoDatosSqlServer): List<Comercio>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class CategoriaProducto {
    +Id: int
    +Nombre: string
  }
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  class ComercioProducto {
    +Comercio: Comercio
    +Producto: Producto
    +Moneda: Moneda
    +Precio: decimal
  }
  enum DiaSemana {
    Lunes
    Martes
    Miercoles
    Jueves
    Viernes
    Sabado
    Domingo
  }
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class Moneda {
    +Id: int
    +Codigo: string
    +Nombre: string
  }
  class Producto {
    +Id: int
    +CategoriaProducto: CategoriaProducto
    +Nombre: string
  }
  class Promocion {
    +Id: int
    +Descripcion: string
    +Descuento: decimal
    +TopeDescuento: decimal?
    +VigenciaDesde: DateTime
    +VigenciaHasta: DateTime
    +DiasSemana: List<DiaSemana>
    +Comercios: List<Comercio>
    +RubrosComercio: List<RubroComercio>
    +EntidadesFinancieras: List<EntidadFinanciera>
    +MediosPago: List<MedioPago>
    +Segmentos: List<string>
    +ProductosIncluidos: List<Producto>
    +ProductosExcluidos: List<Producto>
    +CategoriasIncluidas: List<CategoriaProducto>
    +CategoriasExcluidas: List<CategoriaProducto>
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
}
