' REPOSITORIO/IProductoRepositorio.cs:10 IProductoRepositorio.ObtenerTodos
' REPOSITORIO/IProductoRepositorio.cs:14 IProductoRepositorio.Actualizar
' REPOSITORIO/IProductoRepositorio.cs:8 IProductoRepositorio.ObtenerPorId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/ProductoRepositorio.cs:23 ProductoRepositorio.ObtenerPorId
' REPOSITORIO/ProductoRepositorio.cs:30 ProductoRepositorio.ObtenerTodos
' REPOSITORIO/ProductoRepositorio.cs:52 ProductoRepositorio.Actualizar
