@startuml
' Fuente: diagramas/NEG15-promociones/NEG15-promociones-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN64 Consultar promociones — Secuencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide footbox
autonumber
skinparam maxMessageSize 560
actor "Operador o Administrador" as Actor
boundary "FormGestionPromociones" as FormGestionPromociones
control "PromocionBLL" as PromocionBLL
participant "ComercioRepositorio\n:IComercioRepositorio" as IComercioRepositorio
participant "PromocionRepositorio\n:IPromocionRepositorio" as IPromocionRepositorio
participant "PromocionDAL" as PromocionDAL
control "AlcancePromocion" as AlcancePromocion
note over FormGestionPromociones : El actor desea conocer las promociones registradas en el sistema.
Actor -> FormGestionPromociones : selecciona la opción «Promociones» del menú «Operador».
FormGestionPromociones -> PromocionBLL ++ : Buscar(texto: string, recibido: Comercio)
opt recibido != null
PromocionBLL -> IComercioRepositorio ++ : ObtenerPorId(id: int)
IComercioRepositorio --> PromocionBLL -- : Comercio
end
PromocionBLL -> IPromocionRepositorio ++ : ObtenerTodas()
IPromocionRepositorio -> PromocionDAL ++ : ObtenerTodas(accesoDatos: AccesoDatosSqlServer)
PromocionDAL --> IPromocionRepositorio -- : List<Promocion>
IPromocionRepositorio --> PromocionBLL -- : List<Promocion>
opt comercio != null
PromocionBLL -> AlcancePromocion ++ : FiltrarPorComercio(promociones: IEnumerable<Promocion>,\ncomercio: Comercio)
AlcancePromocion --> PromocionBLL -- : List<Promocion>
end
PromocionBLL --> FormGestionPromociones -- : List<Promocion>
FormGestionPromociones --> Actor : presenta la pantalla «Gestión de Promociones» con el listado de promociones
Actor -> FormGestionPromociones : ingresa un texto en el campo «Texto», selecciona un comercio en el campo «Comercio», o\nambos, y selecciona la acción «Buscar».
FormGestionPromociones -> PromocionBLL ++ : Buscar(texto: string, recibido: Comercio)
opt recibido != null
PromocionBLL -> IComercioRepositorio ++ : ObtenerPorId(id: int)
IComercioRepositorio --> PromocionBLL -- : Comercio
end
PromocionBLL -> IPromocionRepositorio ++ : ObtenerTodas()
IPromocionRepositorio -> PromocionDAL ++ : ObtenerTodas(accesoDatos: AccesoDatosSqlServer)
PromocionDAL --> IPromocionRepositorio -- : List<Promocion>
IPromocionRepositorio --> PromocionBLL -- : List<Promocion>
opt comercio != null
PromocionBLL -> AlcancePromocion ++ : FiltrarPorComercio(promociones: IEnumerable<Promocion>,\ncomercio: Comercio)
AlcancePromocion --> PromocionBLL -- : List<Promocion>
end
PromocionBLL --> FormGestionPromociones -- : List<Promocion>
FormGestionPromociones --> Actor : actualiza el listado mostrando solo las promociones cuya descripción contiene el texto\nindicado y que aplican al comercio seleccionado.
Actor -> FormGestionPromociones : selecciona una promoción del listado.
FormGestionPromociones --> Actor : carga la promoción en el editor: descripción, descuento, tope, vigencia desde y hasta,\ndías de la semana marcados y las opciones marcadas en cada lista de alcance (comercios,\nrubros de comercio, entidades financieras, medios de…
' BLL/AlcancePromocion.cs:23 AlcancePromocion.FiltrarPorComercio
' BLL/PromocionBLL.cs:42 PromocionBLL.Buscar
' DAL/PromocionDAL.cs:52 PromocionDAL.ObtenerTodas
' REPOSITORIO/IComercioRepositorio.cs:8 IComercioRepositorio.ObtenerPorId
' REPOSITORIO/IPromocionRepositorio.cs:10 IPromocionRepositorio.ObtenerTodas
' REPOSITORIO/PromocionRepositorio.cs:34 PromocionRepositorio.ObtenerTodas
' UI/FormGestionPromociones.cs:315 FormGestionPromociones.CargarPromociones
@enduml
