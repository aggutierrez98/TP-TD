package "UI" as L_UI {
  class FormGestionComercios {
    -btnAgregarComercio_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class ComercioBLL {
    +Crear(comercio: Comercio): Comercio
    +ObtenerTodos(): List<Comercio>
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ComercioBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  class "RubroComercioRepositorio" as IRubroComercioRepositorio <<IRubroComercioRepositorio>> {
    +ObtenerPorId(id: int): RubroComercio
  }
  interface IComercioRepositorio {
    +InsertarYObtenerId(comercio: Comercio): int
    +ObtenerTodos(): List<Comercio>
  }
  class ComercioRepositorio {
    +InsertarYObtenerId(comercio: Comercio): int
    +ObtenerTodos(): List<Comercio>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IRubroComercioRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> IComercioRepositorio
IComercioRepositorio -[hidden]right-> ComercioRepositorio
IComercioRepositorio -[hidden]down-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class ComercioDAL {
    +InsertarYObtenerId(comercio: Comercio, accesoDatos: AccesoDatosSqlServer): int
    +ObtenerTodos(accesoDatos: AccesoDatosSqlServer): List<Comercio>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
}
