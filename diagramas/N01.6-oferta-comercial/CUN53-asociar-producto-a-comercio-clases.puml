package "BE" as L_BE {
  class CategoriaProducto {
    +Id: int
    +Nombre: string
  }
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  class ComercioProducto {
    +Comercio: Comercio
    +Producto: Producto
    +Moneda: Moneda
    +Precio: decimal
  }
  class Moneda {
    +Id: int
    +Codigo: string
    +Nombre: string
  }
  class Producto {
    +Id: int
    +CategoriaProducto: CategoriaProducto
    +Nombre: string
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
}
