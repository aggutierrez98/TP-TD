    +ObtenerPorId(id: int): Producto
  }
  interface IComercioProductoRepositorio {
    +ObtenerPorComercioYProducto(comercio: Comercio, producto: Producto): ComercioProducto
    +Insertar(comercioProducto: ComercioProducto): bool
    +ObtenerPorComercio(comercio: Comercio): List<ComercioProducto>
  }
  class ComercioProductoRepositorio {
    +ObtenerPorComercioYProducto(comercio: Comercio, producto: Producto): ComercioProducto
    +Insertar(comercioProducto: ComercioProducto): bool
    +ObtenerPorComercio(comercio: Comercio): List<ComercioProducto>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
