@startuml
' Fuente: diagramas/NEG14-catalogo-productos/NEG14-catalogo-productos-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN61 Alta de producto — Secuencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide footbox
autonumber
skinparam maxMessageSize 560
actor "Operador o Administrador" as Actor
boundary "FormGestionProductos" as FormGestionProductos
control "ProductoBLL" as ProductoBLL
participant "UnidadDeTrabajoFactory\n:IUnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory
participant "CategoriaProductoRepositorio\n:ICategoriaProductoRepositorio" as ICategoriaProductoRepositorio
participant "ProductoRepositorio\n:IProductoRepositorio" as IProductoRepositorio
participant "ProductoDAL" as ProductoDAL
control "BitacoraBLL\n:IBitacoraBLL" as IBitacoraBLL
participant "UnidadDeTrabajoSqlServer\n:IUnidadDeTrabajo" as IUnidadDeTrabajo
note over FormGestionProductos : El actor desea incorporar un nuevo producto al catálogo.
Actor -> FormGestionProductos : ingresa el nombre del producto en el campo «Nombre».
Actor -> FormGestionProductos : selecciona una categoría en el campo «Categoría».
Actor -> FormGestionProductos : selecciona la acción «Agregar».
FormGestionProductos -> ProductoBLL ++ : Crear(producto: Producto)
ProductoBLL -> IUnidadDeTrabajoFactory ++ : Crear()
IUnidadDeTrabajoFactory --> ProductoBLL -- : IUnidadDeTrabajo
ProductoBLL -> ICategoriaProductoRepositorio ++ : ObtenerPorId(id: int)
ICategoriaProductoRepositorio --> ProductoBLL -- : CategoriaProducto
ProductoBLL -> IProductoRepositorio ++ : InsertarYObtenerId(producto: Producto)
IProductoRepositorio -> ProductoDAL ++ : InsertarYObtenerId(producto: Producto, accesoDatos:\nAccesoDatosSqlServer)
ProductoDAL --> IProductoRepositorio -- : int
IProductoRepositorio --> ProductoBLL -- : int
ProductoBLL -> IBitacoraBLL ++ : RegistrarOperacionInterno(actividad: string, informacion:\nstring, origen: string, unidad: IUnidadDeTrabajo)
IBitacoraBLL --> ProductoBLL -- : void
ProductoBLL -> IUnidadDeTrabajo ++ : Save()
IUnidadDeTrabajo --> ProductoBLL -- : void
ProductoBLL --> FormGestionProductos -- : Producto
group Refrescar listado tras la operacion exitosa
FormGestionProductos -> ProductoBLL ++ : ObtenerTodos()
ProductoBLL -> IProductoRepositorio ++ : ObtenerTodos()
IProductoRepositorio -> ProductoDAL ++ : ObtenerTodos(accesoDatos: AccesoDatosSqlServer)
ProductoDAL --> IProductoRepositorio -- : List<Producto>
IProductoRepositorio --> ProductoBLL -- : List<Producto>
ProductoBLL --> FormGestionProductos -- : List<Producto>
end
FormGestionProductos --> Actor : registra el producto, limpia el formulario, actualiza el listado seleccionando el producto\nrecién creado e informa el resultado.
' BLL/ContratosInternosBLL.cs:31 IBitacoraBLL.RegistrarOperacionInterno
' BLL/ProductoBLL.cs:28 ProductoBLL.ObtenerTodos
' BLL/ProductoBLL.cs:35 ProductoBLL.Crear
' DAL/ProductoDAL.cs:49 ProductoDAL.ObtenerTodos
' DAL/ProductoDAL.cs:79 ProductoDAL.InsertarYObtenerId
' REPOSITORIO/ICategoriaProductoRepositorio.cs:8 ICategoriaProductoRepositorio.ObtenerPorId
' REPOSITORIO/IProductoRepositorio.cs:10 IProductoRepositorio.ObtenerTodos
' REPOSITORIO/IProductoRepositorio.cs:12 IProductoRepositorio.InsertarYObtenerId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/ProductoRepositorio.cs:30 ProductoRepositorio.ObtenerTodos
' REPOSITORIO/ProductoRepositorio.cs:47 ProductoRepositorio.InsertarYObtenerId
' UI/FormGestionProductos.cs:97 FormGestionProductos.btnAgregarProducto_Click
@enduml
