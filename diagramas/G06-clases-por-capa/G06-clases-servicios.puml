@startuml
title G06 - Diagrama de clases parcial - Capa SERVICIOS

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "ABSTRACCIONES" <<Frame>> {
  interface ISesion
  interface IAutorizacion
  interface IPasswordHasher
  interface IPermiso
  interface IObservado
  interface IIdioma
  interface ITraduccion
  interface IPalabra
  interface IIntegridadService
  interface IServicioHistorialEstados
  interface IEventoBitacora
  interface IFiltroBitacora
  interface IUsuarioSnapshot
  interface IResultadoComparacionEstado
  interface IUsuarioAutenticado
  interface IUsuarioPreferencia
}

package "SERVICIOS (servicios concretos + tipos de dominio)" {

  ' --- Seguridad / sesion / permisos ---
  class Sesion <<singleton>>
  class UsuarioAutenticadoSesion
  class AutorizacionService <<singleton>>
  class PasswordHasher
  class PermisoService
  class PermisoSimple
  class PermisoGrupo

  ' --- Idioma (Observer) ---
  class IdiomaService <<singleton>>
  class IdiomaCatalogoService
  class Idioma
  class Traduccion
  class Palabra

  ' --- Integridad ---
  class IntegridadService

  ' --- Historial / control de cambios ---
  class HistorialEstadosService <<singleton>>
  class UsuarioHistorialSnapshot
  class ResultadoComparacionEstado
  class UsuarioPreferencia

  ' --- Bitacora ---
  class EventoBitacora
  class FiltroBitacora

  ' --- Excepciones ---
  class ExcepcionNegocio
  class ExcepcionTecnica
  class ExcepcionIntegridad
}

Sesion ..|> ISesion
UsuarioAutenticadoSesion ..|> IUsuarioAutenticado
AutorizacionService ..|> IAutorizacion
AutorizacionService --> PermisoService
PasswordHasher ..|> IPasswordHasher
PermisoSimple ..|> IPermiso
PermisoGrupo ..|> IPermiso
PermisoGrupo o--> "*" IPermiso : Hijos (Composite)
IdiomaService ..|> IObservado
Idioma ..|> IIdioma
Traduccion ..|> ITraduccion
Palabra ..|> IPalabra
Idioma o--> "*" Traduccion
Traduccion --> Palabra
IntegridadService ..|> IIntegridadService
HistorialEstadosService ..|> IServicioHistorialEstados
UsuarioHistorialSnapshot ..|> IUsuarioSnapshot
ResultadoComparacionEstado ..|> IResultadoComparacionEstado
UsuarioPreferencia ..|> IUsuarioPreferencia
EventoBitacora ..|> IEventoBitacora
FiltroBitacora ..|> IFiltroBitacora
ExcepcionIntegridad --|> ExcepcionTecnica

note bottom
  Capa concreta reusable. Solo depende de ABSTRACCIONES.
  Implementa los contratos (DIP) y aloja los patrones:
  Singleton (Sesion, Autorizacion, IdiomaService, HistorialEstados),
  Composite (PermisoSimple/PermisoGrupo), Observer (IdiomaService).
end note

@enduml
