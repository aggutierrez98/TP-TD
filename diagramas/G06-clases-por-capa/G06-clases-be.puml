@startuml
title G06 - Diagrama de clases parcial - Capa BE

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false

package "ABSTRACCIONES" <<Frame>> {
  interface IUsuarioAutenticado
  interface IIntegrable
}

package "BE (entidades de negocio)" {
  class Usuario {
    +Id : int
    +Username : string  <<DigitoVerificador(1)>>
    +PasswordHash : string  <<DigitoVerificador(2)>>
    +Activo : bool  <<DigitoVerificador(3)>>
    +DVH : string
    +Usuario()
    +Usuario(username : string)
  }
}

Usuario ..|> IUsuarioAutenticado
Usuario ..|> IIntegrable

note bottom of Usuario
  BE solo depende de ABSTRACCIONES. Contiene la entidad de dominio
  persistente. El resto del estado del sistema (permisos, idioma,
  snapshots) se modela como tipos de SERVICIOS detras de contratos.
end note

@enduml
