  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
  class ZonaUsuario {
    +Id: int
    +Usuario: Usuario
    +Nombre: string
    +Latitud: decimal
    +Longitud: decimal
    +RadioMetros: int
  }
}
