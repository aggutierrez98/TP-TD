@startuml
title T01 - Arquitectura Base - Mapa de Navegacion de Pantallas

skinparam backgroundColor white
skinparam shadowing false
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam ArrowColor black

[*] --> Arranque

state "Arranque\n(Program.Main)" as Arranque
state "FormContingenciaIntegridad" as Cont
state "FormLogin" as Login
state "FormRegistro\n<<modal>>" as Registro
state "FormPrincipal" as Principal
state "FormMovimientos" as Movimientos
state "FormGestionCategorias" as Categorias
state "FormGestionUsuarios" as Usuarios
state "FormGestionPermisos" as Permisos
state "FormGestionIdiomas" as Idiomas
state "FormBitacora" as Bitacora
state "FormBackup" as Backup
state "FormConfiguracionUsuario\n<<modal>>" as Config
state "FormHistorialUsuario\n<<modal>>" as Historial

Arranque --> Cont : integridad invalida (T07)
Arranque --> Login : integridad OK

Login --> Registro : "Registrarse"
Registro --> Login : cerrar
Login --> Principal : login correcto
Principal --> Login : Logout / cerrar

Principal --> Movimientos : Movimientos\n[perm]\n(pantalla inicial si hay permiso)
Principal --> Categorias : Gestion Categorias\n[perm]
Principal --> Usuarios : Gestion Usuarios\n[perm]
Principal --> Permisos : Gestion Permisos\n[perm]
Principal --> Idiomas : Gestion Idiomas\n[perm]
Principal --> Bitacora : Bitacora\n[perm]
Principal --> Backup : Backup\n[perm]
Principal --> Config : Mi Configuracion\n[perm]

Usuarios --> Historial : Historial Usuario\n[perm + usuario sel.]
Historial --> Usuarios : cerrar

note right of Principal
  Cada accion de menu valida un permiso antes de abrir
  la pantalla destino.
end note

@enduml
