@startuml T01-arquitectura-base-navegacion
!theme plain
title T01 - Arquitectura base: mapa de navegacion de pantallas (UI)

hide empty description

[*] --> FormContingenciaIntegridad : falla ExcepcionIntegridad\nen BootstrapAplicacionBLL.Inicializar()
[*] --> FormLogin : arranque normal (Program.Main)

FormContingenciaIntegridad --> [*] : cerrar aplicacion

FormLogin --> FormRegistro : btnRegistro_Click\n(ShowDialog, modal)
FormRegistro --> FormLogin : cerrar dialogo

FormLogin --> FormGestionUsuarios : btnIngreso_Click\nlogin valido (Show, no modal)

state FormGestionUsuarios {
  FormGestionUsuarios --> FormConfiguracionUsuario : btnConfiguracion_Click\n(ShowDialog, modal)
  FormGestionUsuarios --> FormGestionIdiomas : btnGestionIdiomas_Click\n(Show)
  FormGestionUsuarios --> FormGestionPermisos : btnGestionPermisos_Click\n(ShowDialog, modal)
  FormGestionUsuarios --> FormHistorialUsuario : btnHistorialUsuario_Click\n(ShowDialog, modal)
  FormGestionUsuarios --> FormBitacora : btnBitacora_Click\n(ShowDialog, modal)

  FormConfiguracionUsuario --> FormGestionUsuarios : cerrar dialogo
  FormGestionIdiomas --> FormGestionUsuarios : cerrar ventana
  FormGestionPermisos --> FormGestionUsuarios : cerrar dialogo
  FormHistorialUsuario --> FormGestionUsuarios : cerrar dialogo
  FormBitacora --> FormGestionUsuarios : cerrar dialogo
}

FormGestionUsuarios --> [*] : btnLogout_Click\nCerrarSesionActual() + Close()

note right of FormGestionUsuarios
  Pantalla hub post-login:
  gestion de usuarios, permisos,
  idiomas, historial y bitacora.
end note

@enduml
