@startuml
title G07 - Diagrama de clases parcial - Capa DAL

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "DAL (acceso a datos SQL Server)" {

  class AccesoDatosSqlServer <<IDisposable>> {
    +CreateParameter(name : string, dbType : SqlDbType, value : object) : SqlParameter
    +Read(sql : string, parameters : List<SqlParameter> = null) : DataTable
    +Write(sql : string, parameters : List<SqlParameter> = null) : int
    +WriteWithResult(sql : string, parameters : List<SqlParameter> = null) : int
    +BeginTransactionScope() : void
    +CommitTransactionScope() : void
    +RollbackTransactionScope() : void
    +Dispose() : void
  }

  class UsuarioDAL
  class UsuarioPermisoDAL
  class UsuarioPreferenciaDAL
  class UsuarioHistorialDAL
  class PermisoDAL
  class IdiomaDAL
  class IntegridadDAL
  class BitacoraDAL
  class CategoriaDAL
  class MovimientoDAL
  class BackupDAL
}

UsuarioDAL --> AccesoDatosSqlServer
UsuarioPermisoDAL --> AccesoDatosSqlServer
UsuarioPreferenciaDAL --> AccesoDatosSqlServer
UsuarioHistorialDAL --> AccesoDatosSqlServer
PermisoDAL --> AccesoDatosSqlServer
IdiomaDAL --> AccesoDatosSqlServer
IntegridadDAL --> AccesoDatosSqlServer
BitacoraDAL --> AccesoDatosSqlServer
CategoriaDAL --> AccesoDatosSqlServer
MovimientoDAL --> AccesoDatosSqlServer

@enduml
