' REPOSITORIO/IComercioRepositorio.cs:8 IComercioRepositorio.ObtenerPorId
' REPOSITORIO/IMovimientoRepositorio.cs:11 IMovimientoRepositorio.ObtenerPorId
' REPOSITORIO/IMovimientoRepositorio.cs:13 IMovimientoRepositorio.ObtenerPorUsuario
' REPOSITORIO/IMovimientoRepositorio.cs:27 IMovimientoRepositorio.Actualizar
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' REPOSITORIO/MovimientoRepositorio.cs:26 MovimientoRepositorio.ObtenerPorId
' REPOSITORIO/MovimientoRepositorio.cs:33 MovimientoRepositorio.ObtenerPorUsuario
' REPOSITORIO/MovimientoRepositorio.cs:85 MovimientoRepositorio.Actualizar
' UI/FormMovimientos.cs:416 FormMovimientos.btnActualizarMovimiento_Click
@enduml
