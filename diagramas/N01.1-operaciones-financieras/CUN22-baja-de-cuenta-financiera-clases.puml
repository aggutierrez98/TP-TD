@startuml
' Fuente: diagramas/NEG05-cuentas-financieras/NEG05-cuentas-financieras-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN22 Baja de cuenta financiera — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionCuentasFinancieras {
    -btnEliminarCuenta_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class CuentaFinancieraBLL {
    +Eliminar(cuenta: CuentaFinanciera): bool
    +ObtenerMisCuentas(): List<CuentaFinanciera>
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CuentaFinancieraBLL -[hidden]right-> SesionUsuarioExtensiones
CuentaFinancieraBLL -[hidden]down-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface ICuentaFinancieraRepositorio {
    +ObtenerPorId(id: int): CuentaFinanciera
    +ReemplazarMediosPagoEntidadDeCuenta(cuenta: CuentaFinanciera, medios:\nIEnumerable<MedioPagoEntidad>): bool
    +Eliminar(cuenta: CuentaFinanciera): bool
    +ObtenerPorUsuario(usuario: Usuario): List<CuentaFinanciera>
  }
  class CuentaFinancieraRepositorio {
    +ObtenerPorId(id: int): CuentaFinanciera
    +ReemplazarMediosPagoEntidadDeCuenta(cuenta: CuentaFinanciera, medios:\nIEnumerable<MedioPagoEntidad>): bool
    +Eliminar(cuenta: CuentaFinanciera): bool
    +ObtenerPorUsuario(usuario: Usuario): List<CuentaFinanciera>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> ICuentaFinancieraRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> CuentaFinancieraRepositorio
CuentaFinancieraRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class CuentaFinancieraDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): CuentaFinanciera
    +Eliminar(cuenta: CuentaFinanciera, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerPorUsuario(usuario: Usuario, accesoDatos: AccesoDatosSqlServer):\nList<CuentaFinanciera>
  }
  class CuentaFinancieraMedioPagoEntidadDAL {
    +ReemplazarMediosPagoEntidadDeCuenta(cuenta: CuentaFinanciera, medios:\nIEnumerable<MedioPagoEntidad>, accesoDatos: AccesoDatosSqlServer): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CuentaFinancieraDAL -[hidden]right-> CuentaFinancieraMedioPagoEntidadDAL
package "BE" as L_BE {
  class CuentaFinanciera {
    +Id: int
    +Usuario: Usuario
    +EntidadFinanciera: EntidadFinanciera
    +Alias: string
    +Tipo: TipoCuentaFinanciera
    +CredencialesCifradas: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class MedioPagoEntidad {
    +Id: int
    +EntidadFinanciera: EntidadFinanciera
    +MedioPago: MedioPago
    +Segmento: string
  }
  enum TipoCuentaFinanciera {
    BilleteraDigital
    CuentaCorriente
    CajaAhorro
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CuentaFinanciera -[hidden]right-> EntidadFinanciera
CuentaFinanciera -[hidden]down-> MedioPago
MedioPago -[hidden]right-> MedioPagoEntidad
MedioPago -[hidden]down-> TipoCuentaFinanciera
TipoCuentaFinanciera -[hidden]right-> Usuario
