' REPOSITORIO/ICuentaFinancieraRepositorio.cs:20 ICuentaFinancieraRepositorio.ReemplazarMediosPagoEntidadDeCuenta
' REPOSITORIO/ICuentaFinancieraRepositorio.cs:8 ICuentaFinancieraRepositorio.ObtenerPorId
' REPOSITORIO/IEntidadFinancieraRepositorio.cs:9 IEntidadFinancieraRepositorio.ObtenerPorId
' REPOSITORIO/IMedioPagoEntidadRepositorio.cs:10 IMedioPagoEntidadRepositorio.ObtenerPorEntidadFinanciera
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
