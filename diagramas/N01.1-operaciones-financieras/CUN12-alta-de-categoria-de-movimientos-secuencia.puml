' REPOSITORIO/CategoriaRepositorio.cs:30 CategoriaRepositorio.ObtenerVisiblesParaUsuario
' REPOSITORIO/CategoriaRepositorio.cs:47 CategoriaRepositorio.InsertarYObtenerId
' REPOSITORIO/CategoriaRepositorio.cs:62 CategoriaRepositorio.ExisteNombreEnScope
' REPOSITORIO/ICategoriaRepositorio.cs:10 ICategoriaRepositorio.ObtenerVisiblesParaUsuario
' REPOSITORIO/ICategoriaRepositorio.cs:12 ICategoriaRepositorio.InsertarYObtenerId
' REPOSITORIO/ICategoriaRepositorio.cs:19 ICategoriaRepositorio.ExisteNombreEnScope
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
