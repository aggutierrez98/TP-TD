' REPOSITORIO/IReglaCategorizacionRepositorio.cs:12 IReglaCategorizacionRepositorio.InsertarYObtenerId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
