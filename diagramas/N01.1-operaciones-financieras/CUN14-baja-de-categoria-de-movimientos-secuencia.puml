' DAL/CategoriaDAL.cs:49 CategoriaDAL.ObtenerVisiblesParaUsuario
' REPOSITORIO/CategoriaRepositorio.cs:23 CategoriaRepositorio.ObtenerPorId
' REPOSITORIO/CategoriaRepositorio.cs:30 CategoriaRepositorio.ObtenerVisiblesParaUsuario
' REPOSITORIO/CategoriaRepositorio.cs:57 CategoriaRepositorio.Eliminar
' REPOSITORIO/ICategoriaRepositorio.cs:10 ICategoriaRepositorio.ObtenerVisiblesParaUsuario
' REPOSITORIO/ICategoriaRepositorio.cs:16 ICategoriaRepositorio.Eliminar
' REPOSITORIO/ICategoriaRepositorio.cs:8 ICategoriaRepositorio.ObtenerPorId
' REPOSITORIO/IUnidadDeTrabajo.cs:97 IUnidadDeTrabajo.Save
' REPOSITORIO/IUnidadDeTrabajoFactory.cs:5 IUnidadDeTrabajoFactory.Crear
' UI/FormGestionCategorias.cs:86 FormGestionCategorias.btnEliminarCategoria_Click
@enduml
