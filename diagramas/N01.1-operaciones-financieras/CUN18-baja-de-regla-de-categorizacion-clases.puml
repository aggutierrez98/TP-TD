@startuml
' Fuente: diagramas/NEG04-reglas-categorizacion/NEG04-reglas-categorizacion-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN18 Baja de regla de categorización — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormReglasCategorizacion {
    -btnEliminarRegla_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class ReglaCategorizacionBLL {
    +Eliminar(regla: ReglaCategorizacion): bool
    +ObtenerParaUsuarioActual(): List<ReglaCategorizacion>
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ReglaCategorizacionBLL -[hidden]right-> SesionUsuarioExtensiones
ReglaCategorizacionBLL -[hidden]down-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IReglaCategorizacionRepositorio {
    +ObtenerPorId(id: int): ReglaCategorizacion
    +Eliminar(reglaCategorizacion: ReglaCategorizacion): bool
    +ObtenerPorUsuario(usuario: Usuario): List<ReglaCategorizacion>
  }
  class ReglaCategorizacionRepositorio {
    +ObtenerPorId(id: int): ReglaCategorizacion
    +Eliminar(reglaCategorizacion: ReglaCategorizacion): bool
    +ObtenerPorUsuario(usuario: Usuario): List<ReglaCategorizacion>
  }
  class "ComercioReglaCategorizacionRepositorio" as IComercioReglaCategorizacionRepositorio <<IComercioReglaCategorizacionRepositorio>> {
    +ReemplazarComerciosDeReglaCategorizacion(reglaCategorizacion: ReglaCategorizacion,\ncomercios: IEnumerable<Comercio>): bool
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IUnidadDeTrabajoFactory -[hidden]right-> IReglaCategorizacionRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> ReglaCategorizacionRepositorio
ReglaCategorizacionRepositorio -[hidden]right-> IComercioReglaCategorizacionRepositorio
ReglaCategorizacionRepositorio -[hidden]down-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class ReglaCategorizacionDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): ReglaCategorizacion
    +Eliminar(reglaCategorizacion: ReglaCategorizacion, accesoDatos:\nAccesoDatosSqlServer): bool
    +ObtenerPorUsuario(usuario: Usuario, accesoDatos: AccesoDatosSqlServer):\nList<ReglaCategorizacion>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Categoria {
    +Id: int
    +Nombre: string
    +Usuario: Usuario
    +EsGlobal: bool
  }
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  class ReglaCategorizacion {
    +Id: int
    +Usuario: Usuario
    +Categoria: Categoria
    +Nombre: string
    +PalabrasClave: string
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
Categoria -[hidden]right-> Comercio
Categoria -[hidden]down-> ReglaCategorizacion
ReglaCategorizacion -[hidden]right-> RubroComercio
ReglaCategorizacion -[hidden]down-> Usuario
