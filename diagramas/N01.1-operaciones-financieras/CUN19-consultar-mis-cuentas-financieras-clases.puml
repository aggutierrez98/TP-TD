@startuml
' Fuente: diagramas/NEG05-cuentas-financieras/NEG05-cuentas-financieras-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN19 Consultar mis cuentas financieras — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormGestionCuentasFinancieras {
    -CargarCuentas(cuentaSeleccionadaId: int?): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class CuentaFinancieraBLL {
    +ObtenerMisCuentas(): List<CuentaFinanciera>
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class EntidadFinancieraBLL {
    +ObtenerMediosPagoEntidad(entidad: EntidadFinanciera): List<MedioPagoEntidad>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CuentaFinancieraBLL -[hidden]right-> SesionUsuarioExtensiones
CuentaFinancieraBLL -[hidden]down-> EntidadFinancieraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  interface ICuentaFinancieraRepositorio {
    +ObtenerPorUsuario(usuario: Usuario): List<CuentaFinanciera>
  }
  class CuentaFinancieraRepositorio {
    +ObtenerPorUsuario(usuario: Usuario): List<CuentaFinanciera>
  }
  class "EntidadFinancieraRepositorio" as IEntidadFinancieraRepositorio <<IEntidadFinancieraRepositorio>> {
    +ObtenerPorId(id: int): EntidadFinanciera
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ICuentaFinancieraRepositorio -[hidden]right-> CuentaFinancieraRepositorio
ICuentaFinancieraRepositorio -[hidden]down-> IEntidadFinancieraRepositorio
package "DAL" as L_DAL {
  class CuentaFinancieraDAL {
    +ObtenerPorUsuario(usuario: Usuario, accesoDatos: AccesoDatosSqlServer):\nList<CuentaFinanciera>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class CuentaFinanciera {
    +Id: int
    +Usuario: Usuario
    +EntidadFinanciera: EntidadFinanciera
    +Alias: string
    +Tipo: TipoCuentaFinanciera
    +CredencialesCifradas: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class EntidadFinanciera {
    +Id: int
    +Nombre: string
    +MediosPagoEntidad: List<MedioPagoEntidad>
  }
  class MedioPago {
    +Id: int
    +Tipo: TipoMedioPago
    +Marca: string
  }
  class MedioPagoEntidad {
    +Id: int
    +EntidadFinanciera: EntidadFinanciera
    +MedioPago: MedioPago
    +Segmento: string
  }
  enum TipoCuentaFinanciera {
    BilleteraDigital
    CuentaCorriente
    CajaAhorro
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
CuentaFinanciera -[hidden]right-> EntidadFinanciera
CuentaFinanciera -[hidden]down-> MedioPago
MedioPago -[hidden]right-> MedioPagoEntidad
MedioPago -[hidden]down-> TipoCuentaFinanciera
TipoCuentaFinanciera -[hidden]right-> Usuario
CuentaFinancieraBLL ..> ICuentaFinancieraRepositorio : usa
CuentaFinancieraBLL ..> SesionUsuarioExtensiones : usa
CuentaFinancieraRepositorio ..|> ICuentaFinancieraRepositorio
EntidadFinancieraBLL ..> IEntidadFinancieraRepositorio : usa
FormGestionCuentasFinancieras ..> CuentaFinancieraBLL : usa
FormGestionCuentasFinancieras ..> EntidadFinancieraBLL : usa
CuentaFinancieraRepositorio ..> CuentaFinancieraDAL : usa
L_DAL -[hidden]down-> L_BE
CuentaFinancieraBLL ..> CuentaFinanciera : datos
CuentaFinanciera --> Usuario : Usuario
CuentaFinanciera --> EntidadFinanciera : EntidadFinanciera
CuentaFinanciera --> TipoCuentaFinanciera : Tipo
CuentaFinanciera --> "*" MedioPagoEntidad : MediosPagoEntidad
EntidadFinanciera --> "*" MedioPagoEntidad : MediosPagoEntidad
MedioPagoEntidad --> EntidadFinanciera : EntidadFinanciera
MedioPagoEntidad --> MedioPago : MedioPago
' BLL/CuentaFinancieraBLL.cs:34 CuentaFinancieraBLL.ObtenerMisCuentas
' BLL/EntidadFinancieraBLL.cs:36 EntidadFinancieraBLL.ObtenerMediosPagoEntidad
' BLL/SesionUsuarioExtensiones.cs:12 SesionUsuarioExtensiones.ObtenerUsuarioActual
' DAL/CuentaFinancieraDAL.cs:53 CuentaFinancieraDAL.ObtenerPorUsuario
' REPOSITORIO/CuentaFinancieraRepositorio.cs:34 CuentaFinancieraRepositorio.ObtenerPorUsuario
' REPOSITORIO/ICuentaFinancieraRepositorio.cs:10 ICuentaFinancieraRepositorio.ObtenerPorUsuario
' REPOSITORIO/IEntidadFinancieraRepositorio.cs:9 IEntidadFinancieraRepositorio.ObtenerPorId
' UI/FormGestionCuentasFinancieras.cs:114 FormGestionCuentasFinancieras.CargarCuentas
@enduml
