' REPOSITORIO/ICategoriaRepositorio.cs:14 ICategoriaRepositorio.Actualizar
' REPOSITORIO/ICategoriaRepositorio.cs:19 ICategoriaRepositorio.ExisteNombreEnScope
' REPOSITORIO/ICategoriaRepositorio.cs:8 ICategoriaRepositorio.ObtenerPorId
