MovimientoBLL -[hidden]right-> SesionUsuarioExtensiones
MovimientoBLL -[hidden]down-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "CategoriaRepositorio" as ICategoriaRepositorio <<ICategoriaRepositorio>> {
    +ObtenerPorId(id: int): Categoria
  }
  class "ComercioRepositorio" as IComercioRepositorio <<IComercioRepositorio>> {
    +ObtenerPorId(id: int): Comercio
  }
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IMovimientoRepositorio {
    +ObtenerPorId(id: int): Movimiento
    +Actualizar(movimiento: Movimiento): bool
    +ObtenerPorUsuario(usuario: Usuario, filtro: FiltroMovimiento): List<Movimiento>
  }
  class MovimientoRepositorio {
    +ObtenerPorId(id: int): Movimiento
    +Actualizar(movimiento: Movimiento): bool
    +ObtenerPorUsuario(usuario: Usuario, filtro: FiltroMovimiento): List<Movimiento>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
ICategoriaRepositorio -[hidden]right-> IComercioRepositorio
ICategoriaRepositorio -[hidden]down-> IUnidadDeTrabajoFactory
IUnidadDeTrabajoFactory -[hidden]right-> IMovimientoRepositorio
IUnidadDeTrabajoFactory -[hidden]down-> MovimientoRepositorio
MovimientoRepositorio -[hidden]right-> IUnidadDeTrabajo
package "DAL" as L_DAL {
  class MovimientoDAL {
    +ObtenerPorId(id: int, accesoDatos: AccesoDatosSqlServer): Movimiento
    +Actualizar(movimiento: Movimiento, accesoDatos: AccesoDatosSqlServer): bool
    +ObtenerPorUsuario(usuario: Usuario, filtro: FiltroMovimiento, accesoDatos:\nAccesoDatosSqlServer): List<Movimiento>
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BE" as L_BE {
  class Categoria {
    +Id: int
    +Nombre: string
    +Usuario: Usuario
    +EsGlobal: bool
  }
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  class FiltroMovimiento {
    +FechaDesde: DateTime?
    +FechaHasta: DateTime?
    +Categoria: Categoria
    +Tipo: TipoMovimiento?
    +Texto: string
  }
  class Movimiento {
    +Id: int
    +Usuario: Usuario
    +Categoria: Categoria
    +Comercio: Comercio
    +Tipo: TipoMovimiento
    +Monto: decimal
    +Fecha: DateTime
    +Descripcion: string
    +FechaCreacion: DateTime
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
