@startuml
' Fuente: diagramas/NEG02-movimientos/NEG02-movimientos-casos-de-uso.json
' Proyeccion por caso de uso; firmas contrastadas contra el codigo fuente.
title CUN07 Registrar movimiento — Clases involucradas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #3E3A4E
skinparam ParticipantBackgroundColor #E4F4E9
skinparam ParticipantBorderColor #3E3A4E
skinparam ClassBackgroundColor #E4F4E9
skinparam ClassBorderColor #3E3A4E
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
package "UI" as L_UI {
  class FormMovimientos {
    -btnAgregarMovimiento_Click(sender: object, e: EventArgs): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
package "BLL" as L_BLL {
  class MovimientoBLL {
    +EscanearBorradorAsync(imagenBytes: byte[]): Task<EscaneoBorradorResultado>
    +Crear(movimiento: Movimiento): Movimiento
    +ObtenerParaUsuarioActual(filtro: FiltroMovimiento): List<Movimiento>
  }
  class SesionUsuarioExtensiones {
    ~ObtenerUsuarioActual(sesion: ISesion): Usuario
  }
  class ReglaCategorizacionBLL {
    +SugerirCategoria(descripcion: string, comercio: Comercio): Categoria
  }
  class "BitacoraBLL" as IBitacoraBLL <<IBitacoraBLL>> {
    +RegistrarOperacionInterno(actividad: string, informacion: string, origen: string,\nunidad: IUnidadDeTrabajo): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
MovimientoBLL -[hidden]right-> SesionUsuarioExtensiones
MovimientoBLL -[hidden]down-> ReglaCategorizacionBLL
ReglaCategorizacionBLL -[hidden]right-> IBitacoraBLL
package "REPOSITORIO" as L_REPOSITORIO {
  class "ReglaCategorizacionRepositorio" as IReglaCategorizacionRepositorio <<IReglaCategorizacionRepositorio>> {
    +ObtenerPorUsuario(usuario: Usuario): List<ReglaCategorizacion>
  }
  class "ComercioReglaCategorizacionRepositorio" as IComercioReglaCategorizacionRepositorio <<IComercioReglaCategorizacionRepositorio>> {
    +ObtenerComerciosPorReglaCategorizacion(reglaCategorizacion: ReglaCategorizacion):\nList<Comercio>
  }
  class "CategoriaRepositorio" as ICategoriaRepositorio <<ICategoriaRepositorio>> {
    +ObtenerPorId(id: int): Categoria
  }
  class "ComercioRepositorio" as IComercioRepositorio <<IComercioRepositorio>> {
    +ObtenerPorId(id: int): Comercio
  }
  class "UnidadDeTrabajoFactory" as IUnidadDeTrabajoFactory <<IUnidadDeTrabajoFactory>> {
    +Crear(): IUnidadDeTrabajo
  }
  interface IMovimientoRepositorio {
    +InsertarYObtenerId(movimiento: Movimiento): int
    +ObtenerPorUsuario(usuario: Usuario, filtro: FiltroMovimiento): List<Movimiento>
  }
  class MovimientoRepositorio {
    +InsertarYObtenerId(movimiento: Movimiento): int
    +ObtenerPorUsuario(usuario: Usuario, filtro: FiltroMovimiento): List<Movimiento>
  }
  class "UnidadDeTrabajoSqlServer" as IUnidadDeTrabajo <<IUnidadDeTrabajo>> {
    +Save(): void
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IReglaCategorizacionRepositorio -[hidden]right-> IComercioReglaCategorizacionRepositorio
IReglaCategorizacionRepositorio -[hidden]down-> ICategoriaRepositorio
ICategoriaRepositorio -[hidden]right-> IComercioRepositorio
