package "SERVICIOS" as L_SERVICIOS {
  class "GeminiEscaneoTicketService" as IEscaneoTicketService <<IEscaneoTicketService>> {
    +EscanearTicketAsync(imagenBytes: byte[]): Task<ITicketEscaneado>
  }
  class "Sesion" as ISesion <<ISesion>> {
    +HaySesionActiva(): bool
  }
}
' Enlaces ocultos: solo distribucion visual, no relaciones de dominio.
IEscaneoTicketService -[hidden]right-> ISesion
package "BE" as L_BE {
  class Categoria {
    +Id: int
    +Nombre: string
    +Usuario: Usuario
    +EsGlobal: bool
  }
  class Comercio {
    +Id: int
    +RubroComercio: RubroComercio
    +Nombre: string
    +Direccion: string
    +Localidad: string
    +Provincia: string
    +Latitud: decimal?
    +Longitud: decimal?
  }
  class FiltroMovimiento {
    +FechaDesde: DateTime?
    +FechaHasta: DateTime?
    +Categoria: Categoria
    +Tipo: TipoMovimiento?
    +Texto: string
  }
  class Movimiento {
    +Id: int
    +Usuario: Usuario
    +Categoria: Categoria
    +Comercio: Comercio
    +Tipo: TipoMovimiento
    +Monto: decimal
    +Fecha: DateTime
    +Descripcion: string
    +FechaCreacion: DateTime
  }
  class ReglaCategorizacion {
    +Id: int
    +Usuario: Usuario
    +Categoria: Categoria
    +Nombre: string
    +PalabrasClave: string
  }
  class RubroComercio {
    +Id: int
    +Nombre: string
  }
  class Usuario {
    +Id: int
    +Username: string
    +PasswordHash: string
    +Activo: bool
    +IntentosFallidos: int
    +Bloqueado: bool
    +BloqueadoHasta: DateTime?
    +DVH: string
  }
}
