<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Krypton.Toolkit</id>
    <version>105.26.7.201</version>
    <authors>Peter Wagner (A.K.A Wagnerp) and Simon Coghlan (A.K.A Smurf-IV), Giduac, Ahmed Abdelhameed, Lesandro, tobitege, Phil Wright (A.K.A ComponentFactory)</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">BSD-3-Clause</license>
    <licenseUrl>https://licenses.nuget.org/BSD-3-Clause</licenseUrl>
    <icon>Krypton Stable.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Krypton-Suite/Standard-Toolkit</projectUrl>
    <description>An update to Component factory's krypton toolkit to support .NET Framework 4.7.2 - 4.8.1 and .NET 8 - 10. This is the core toolkit module. This package supports all .NET Framework versions starting .NET Framework 4.6.2 - 4.8.1 and .NET 8 - 10. Also, all libraries are included targeting each specific framework version for performance purposes. To view all of the standard toolkit package latest version information, please visit: https://github.com/Krypton-Suite/Krypton-Toolkit-Suite-Version-Dashboard/blob/main/Documents/Modules/Standard/Krypton-Toolkit-Suite-Standard-Modules.md</description>
    <releaseNotes>Get updates here: https://github.com/Krypton-Suite/Standard-Toolkit</releaseNotes>
    <copyright>© Krypton Suite (Peter Wagner (aka Wagnerp), Simon Coghlan (aka Smurf-IV), Giduac, Ahmed Abdelhameed, Lesandro and tobitege) 2017 - 2025. Component Factory Pty Ltd (Phil Wright), 2006 - 2016. All rights reserved.</copyright>
    <tags>Krypton ComponentFactory WinForms Themes Controls DataGrid Ribbon Workspace Tabs .NET Toolkit</tags>
    <repository type="git" url="https://github.com/Krypton-Suite/Standard-Toolkit" branch="refs/heads/V105-LTS" commit="85c7c499e7892fc0b9b08c0397a4333a33e379b3" />
    <dependencies>
      <group targetFramework="net10.0-windows7.0" />
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="System.Memory" version="4.5.5" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="9.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.8">
        <dependency id="System.Memory" version="4.5.5" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="9.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.8.1">
        <dependency id="System.Memory" version="4.5.5" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="9.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="System.Resources.Extensions" version="9.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0-windows7.0" />
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WindowsForms" />
      </group>
      <group targetFramework=".NETFramework4.7.2" />
      <group targetFramework=".NETFramework4.8" />
      <group targetFramework=".NETFramework4.8.1" />
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WindowsForms" />
      </group>
      <group targetFramework="net9.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WindowsForms" />
      </group>
    </frameworkReferences>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" targetFramework=".NETFramework4.7.2, .NETFramework4.8, .NETFramework4.8.1" />
      <frameworkAssembly assemblyName="System.Net.Http" targetFramework=".NETFramework4.7.2, .NETFramework4.8, .NETFramework4.8.1" />
    </frameworkAssemblies>
  </metadata>
</package>