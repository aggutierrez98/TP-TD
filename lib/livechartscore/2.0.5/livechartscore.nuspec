<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>LiveChartsCore</id>
    <version>2.0.5</version>
    <authors>BetoRodriguez</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <description>Simple, stunning, interactive and powerful data visualization for .Net. This package contains only the core of the library, you probably need another package that is compatible with you UI framework, unless you are building a custom package.</description>
    <repository type="git" url="https://github.com/beto-rodriguez/LiveCharts2" commit="e8a67f59bae283d2e88b1e8d30ef1bf7bcf5b5d5" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0" />
      <group targetFramework="net8.0-windows7.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>