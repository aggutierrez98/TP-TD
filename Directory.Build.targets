<Project>
  <Import Project="$(MSBuildThisFileDirectory)SERVICIOS\SystemTextJson.references.props"
          Condition="'$(MSBuildProjectName)' == 'UI' or '$(MSBuildProjectName)' == 'CRONS' or '$(MSBuildProjectName)' == 'BLL.Tests' or '$(MSBuildProjectName)' == 'TpIDS.IntegrationTests' or '$(MSBuildProjectName)' == 'TpIDS.UiTests'" />
  <PropertyGroup>
    <ArchitectureGuardEnabled Condition="'$(ArchitectureGuardEnabled)' == ''">true</ArchitectureGuardEnabled>
  </PropertyGroup>

  <Target
    Name="VerifyArchitectureDependencies"
    BeforeTargets="BeforeBuild"
    Condition="'$(ArchitectureGuardEnabled)' == 'true' and Exists('$(MSBuildThisFileDirectory).agents\scripts\verify-architecture-dependencies.ps1')">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory).agents\scripts\verify-architecture-dependencies.ps1&quot;" />
  </Target>

  <Target
    Name="VerifyCompositionRoot"
    BeforeTargets="BeforeBuild"
    Condition="'$(ArchitectureGuardEnabled)' == 'true' and Exists('$(MSBuildThisFileDirectory).agents\scripts\verify-composition-root.ps1')">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory).agents\scripts\verify-composition-root.ps1&quot;" />
  </Target>
</Project>
